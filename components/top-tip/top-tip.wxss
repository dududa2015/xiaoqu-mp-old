.top-tip {
  position: absolute;
  top: 176rpx;
  left: 125rpx;
  width: 500rpx;
  height: 25px;
  background-color: rgba(231, 240, 255, 0.95);
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
  border-radius: 12rpx;
  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
}

.top-tip__content {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  align-items: center;
}

.t-notice-bar_wrap {
  flex: 1;
  padding: 0 0 0 16rpx !important;
  font-size: 10px !important;
}

.img-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.img {
  width: 16px;
  height: 16px;
}
