.sheet-host {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0;
  padding: 16rpx 24rpx 24rpx;
  background: #f5f5f5;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  overflow: visible;
}

.handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.12);
}

.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 44rpx;
  margin-bottom: 24rpx;
}

.title {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.88);
}

.maps {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  border-radius: 48rpx;
  background: #ffffff;
}

.map-type {
  margin-right: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.map-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 40%;
  border: 4rpx solid #ffffff;
}

.map-img-on {
  border-color: #0074fe;
}

.map-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #333333;
}

.map-name-on {
  color: #0074fe;
}

.group {
  margin-top: 24rpx;
  border-radius: 48rpx;
  background: #ffffff;
  overflow: hidden;
}

.row {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.line {
  height: 1rpx;
  margin-left: 32rpx;
  background: rgba(34, 34, 34, 0.08);
}

.row-segment {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.row-title {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
  color: #222222;
}

.row t-segmented {
  flex: 0 0 auto;
}

.segment {
  flex: 0 0 auto;
  border-radius: 999rpx;
  overflow: hidden;
}

.segment .t-segmented,
.segment .t-segmented__thumb {
  border-radius: 999rpx !important;
}
