<view class="choose-marker" wx:if="{{showChooseMarker}}">
  <view class="{{markerTypeIndex === 7? 'choose-point-btn-green': 'choose-point-btn-red'}}" bind:tap="onChooseMarker">
    定点
  </view>
</view>
<view class="choose-button" wx:if="{{showChooseMarker}}">
  <view class="choose-btn" bind:tap="onBackChooseMarker">
    <t-icon name='rollback' size="40rpx" color="#333"></t-icon>
    <text class="choose-text">撤销</text>
  </view>

  <view class="choose-btn" bind:tap="onFinishChooseMarker">
    <t-icon name='check' size="48rpx" color="{{markerTypeIndex === 7? '#3CB371': '#dc143c'}}"></t-icon>
    <text class="choose-text" style="color: {{markerTypeIndex === 7? '#3CB371': '#dc143c'}};font-weight: 500;">完成</text>
  </view>
  <view class="choose-btn" bind:tap="onCancelChooseMarker">
    <t-icon name='close' size="48rpx" color="#333"></t-icon>
    <text class="choose-text">退出</text>
  </view>
</view>

<t-popup visible="{{showForm}}" show-overlay="{{false}}" placement="bottom" touchmove='false' style="background:#f5f5f5;padding-left:24rpx;padding-right:24rpx;width:calc(100% - 48rpx);box-shadow:0 -12rpx 36rpx rgba(0,0,0,0.08);--td-popup-border-radius: 48rpx;">
  <view class="form-wrap">
    <view class="form-header">
      <view class="form-header-slot form-header-slot--start">
        <view class="ios-toolbar-btn ios-toolbar-btn--glass" bind:tap="onFormClose" hover-class="ios-toolbar-btn--pressed" hover-stay-time="80">
          <text class="ios-toolbar-btn__label">关闭</text>
        </view>
      </view>
      <view class="form-header-slot form-header-slot--center">
        <text class="form-header-title">{{action}}{{title}}</text>
      </view>
      <view class="form-header-slot form-header-slot--end">
        <view class="ios-toolbar-btn ios-toolbar-btn--glass" bind:tap="onSaveMarker" hover-class="ios-toolbar-btn--pressed" hover-stay-time="80">
          <text class="ios-toolbar-btn__label" style="color:{{bgColor}};">保存</text>
        </view>
      </view>
    </view>
    <view class="input-wrap">
      <t-input placeholder="{{place}}" model:value="{{name}}" borderless="{{false}}" maxlength="10" cursor-color="{{bgColor}}" placeholder-class="t-input__placeholder" type="text" cursor-spacing="72" always-embed="{{true}}" clearable>
        <text slot="label" wx:if="{{markerTypeIndex === 0}}">楼号<text style="color: #e34d59"> *</text> </text>
        <text slot="label" wx:if="{{markerTypeIndex === 3 || markerTypeIndex === 4}}">名称<text style="color: #e34d59"> *</text> </text>
        <text slot="label" wx:if="{{markerTypeIndex !== 0 && markerTypeIndex !== 3 && markerTypeIndex !== 4}}">名称 </text>
      </t-input>
      <view class="suggestions-row" wx:if="{{markerTypeIndex === 0 || markerTypeIndex === 1 || markerTypeIndex === 3 || markerTypeIndex === 4}}">
        <view class="suggestions-title">
          <text>快速输入</text>
        </view>
        <view class="suggestions-content">
          <suggestions-input
            id="suggestions"
            class="suggestions-input-inner"
            markerTypeIndex="{{markerTypeIndex}}"
            name="{{name}}"
            bgColor="{{bgColor}}"
            bind:getSuggestions="getSuggestions"
          ></suggestions-input>
        </view>
      </view>
      <view class="suggestions-row" wx:if="{{markerTypeIndex === 0}}">
        <view class="suggestions-title">
          <text>大门朝向</text>
        </view>
        <view class="suggestions-content">
          <scroll-view class="direction-tags-scroll" scroll-x="true" show-scrollbar="false">
            <view class="direction-tags-row">
              <t-check-tag wx:for="{{tagDirection}}" wx:key="index" theme="default" checked="{{item.checked}}" bindchange="onTagDirectionChange" data-item="{{item}}" variant="dark" size="medium" content="" style="margin:0 6rpx 0 0;">
                <view class="direction-tag-content">
                  <text class="direction-tag-icon">{{item.name}}</text>
                  <text class="direction-tag-label">{{item.label}}</text>
                </view>
              </t-check-tag>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="suggestions-row">
        <view class="suggestions-title">
          <text>标签</text>
        </view>
        <view class="suggestions-content">
          <scroll-view class="common-tags-scroll" scroll-x="true" show-scrollbar="false">
            <view class="common-tags-row">
              <!--楼号-->
              <t-check-tag wx:for="{{currentTagList}}" wx:key="index" theme="default" checked="{{item.checked}}" bindchange="onTagChange" data-item="{{item}}" variant="dark" size="medium" content="" style="margin:0 8rpx 0;background-color:{{item.checked?bgColor:''}};border-color:{{item.checked?bgColor:''}};">{{item.name}}</t-check-tag>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="suggestions-row suggestions-row--upload">
        <view class="suggestions-title">
          <text>照片</text>
        </view>
        <view class="suggestions-content suggestions-content--upload">
          <t-upload
            class="marker-photo-upload"
            style="--td-upload-radius: 16rpx; --td-image-round-radius: 16rpx;"
            media-type="{{uploadMediaType}}"
            config="{{uploadConfig}}"
            files="{{markerUploadFiles}}"
            max="{{uploadMax}}"
            grid-config="{{uploadGridConfig}}"
            gutter="{{8}}"
            size-limit="{{uploadSizeLimitKb}}"
            bind:add="onAddFile"
            bind:success="onMarkerUploadSuccess"
            bind:remove="onRemoveFile"
            bind:fail="onMarkerUploadFail"
          >
            <view slot="add-content" class="marker-upload-add">
              <image class="marker-upload-add__icon" src="/images/camera.png" mode="aspectFit" />
            </view>
          </t-upload>
        </view>
      </view>
    </view>
  </view>
</t-popup>