<view class="user-container">
    <!-- 用户信息区域 -->
    <view class="user-section">
        <view class="user-content" bind:tap="toEdit">
            <view class="avatar-wrapper">
                <image src="/images/my/avatar.png" class="user-avatar" mode="aspectFill" />
                <view class="avatar-glow"></view>
            </view>
            <view class="user-details">
                <view class="name-group">
                    <text class="user-name">{{userInfo ? (userInfo.nickName || '小区楼号') : '请登录'}}</text>
                    <view class="badge-group">                        
                        <view class="badge-item badge-vip" wx:if="{{isVip}}">VIP</view>
                        <view class="badge-item badge-admin" wx:if="{{isAdmin}}">管理员</view>
                    </view>
                </view>
                <view class="user-meta">
                    <text class="user-id">ID: {{userId}}</text>
                </view>
            </view>
            <view class="action-btn">
              <image src="/images/poi-detail/edit.png" class="img" mode="" />
            </view>
        </view>
        <!-- <view class="vip-expiry-row" wx:if="{{vipExpiry.visible}}">
          <text class="vip-expiry-text">{{vipExpiry.primaryText}}</text>
          <view class="vip-expiry-badge {{vipExpiry.badgeMuted ? 'vip-expiry-badge-muted' : (vipExpiry.badgeUrgent ? 'vip-expiry-badge-urgent' : 'vip-expiry-badge-ok')}}">{{vipExpiry.badgeText}}</view>
        </view> -->
    </view>
