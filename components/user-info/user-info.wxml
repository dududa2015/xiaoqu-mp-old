<view class="user-container">
    <!-- 用户信息区域 -->
    <view class="user-section">
        <view class="user-content" bind:tap="toEdit">
            <view class="avatar-wrapper">
                <image src="/images/my/avatar.png" class="user-avatar" mode="aspectFill" />
                <view class="avatar-glow"></view>
            </view>
            <view class="user-details">
                <view class="name-group">
                    <text class="user-name">{{userInfo ? (userInfo.nickName || '小区楼号') : '请登录'}}</text>
                    <!-- #if MP-->
                    <view class="badge-group">                        
                        <view class="badge-item badge-vip" wx:if="{{isVip}}">VIP</view>
                        <view class="badge-item badge-admin" wx:if="{{isAdmin}}">管理员</view>
                    </view>
                    <!-- #else -->
                    <view class="badge-item badge-lifetime" wx:if="{{isLifetimeVip}}">终身会员</view>
                    <!-- #endif -->
                </view>
                <view class="user-meta">
                    <text class="user-id">ID: {{userId}}</text>
                </view>
            </view>
            <view class="action-btn">
                <t-icon name="edit" size="32rpx" color="#4b5563" />
            </view>
        </view>
        <!-- #if NATIVE -->
        <!-- 会员到期信息 先注释，以后打开 -->
        <!-- <view class="vip-info" wx:if="{{vipExpiredDate && !isLifetimeVip}}">
            <view class="vip-badge-row">
                <view class="vip-label-badge">{{showVip ? 'VIP' : '过期'}}</view>
                <text class="vip-date-text">到期时间：{{vipExpiredDate}}</text>
                <view class="vip-days-tag" wx:if="{{showVip && !isVipExpiringSoon}}">会员有效</view>
                <view class="vip-days-tag vip-warning" wx:elif="{{showVip && isVipExpiringSoon && showHours}}">剩{{vipHoursLeft}}小时</view>
                <view class="vip-days-tag vip-warning" wx:elif="{{showVip && isVipExpiringSoon}}">剩{{vipDaysLeft}}天</view>
            </view>
        </view> -->
        <!-- #endif -->
    </view>
    <!-- 统计数据区域 -->
    <view class="stats-section">
        <view class="stats-grid">
            <view class="stat-item stat-markers" bind:tap="toMarkers" data-deleted="{{0}}">
                <view class="stat-icon">
                    <t-icon name="location" size="32rpx" />
                </view>
                <view class="stat-info">
                    <view class="stat-value">{{validCount || 0}}</view>
                    <view class="stat-title">有效标记</view>
                </view>
            </view>
            
            <view class="stat-item stat-pending" bind:tap="toMarkers" data-deleted="{{-1}}">
                <view class="stat-icon">
                    <t-icon name="time" size="32rpx" />
                </view>
                <view class="stat-info">
                    <view class="stat-value">{{pendingAuditCount || 0}}</view>
                    <view class="stat-title">待审核</view>
                </view>
            </view>
            
            <view class="stat-item stat-deleted" bind:tap="toMarkers" data-deleted="{{1}}">
                <view class="stat-icon">
                    <t-icon name="delete" size="32rpx" />
                </view>
                <view class="stat-info">
                    <view class="stat-value">{{deletedCount || 0}}</view>
                    <view class="stat-title">被删除</view>
                </view>
            </view>
        </view>
    </view>
</view>