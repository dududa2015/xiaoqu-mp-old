/* 容器 */
.user-container {
    background: #ffffff;
    border-radius: 28rpx;
    overflow: hidden;
    /* box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); */
}

/* 用户信息区域 */
.user-section {
    padding: 36rpx 28rpx 20rpx;
    position: relative;
    overflow: hidden;
}

.user-content {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
}

.avatar-wrapper {
    flex-shrink: 0;
    width: 112rpx;
    height: 112rpx;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #e8ecf1 0%, #f5f5f5 100%);
    border: 3rpx solid #ffffff;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.avatar-glow {
    display: none;
}

.user-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #ffffff;
    position: relative;
    z-index: 1;
}

.user-details {
    flex: 1;
    margin-left: 24rpx;
    min-width: 0;
}

.name-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10rpx;
    margin-bottom: 10rpx;
}

.user-name {
    font-size: 40rpx;
    font-weight: 600;
    color: #1f2937;
    line-height: 56rpx;
}

.badge-group {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.badge-item {
    padding: 4rpx 14rpx;
    border-radius: 12rpx;
    font-size: 20rpx;
    font-weight: 600;
}

.badge-vip {
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: #ffffff;
    box-shadow: 0 2rpx 6rpx rgba(245, 158, 11, 0.25);
}

.badge-admin {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 2rpx 6rpx rgba(99, 102, 241, 0.25);
}

.badge-lifetime {
    background: linear-gradient(135deg, #ffd700 0%, #ffb347 50%, #ff8c00 100%);
    color: #ffffff;
    box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.4), 0 0 0 1rpx rgba(255, 255, 255, 0.3) inset;
    text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
}

.badge-lifetime::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.4) 50%, transparent 70%);
    animation: shimmer-badge 2s infinite;
}

@keyframes shimmer-badge {
    0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
    100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
}

.user-meta {
    display: flex;
    align-items: center;
}

.user-id {
    font-size: 22rpx;
    color: #6b7280;
    font-weight: 400;
    background: #f3f4f6;
    padding: 4rpx 16rpx;
    border-radius: 16rpx;
}

.action-btn {
    flex-shrink: 0;
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.action-btn:active {
    transform: scale(0.92);
    background: #e5e7eb;
}

.action-btn t-icon {
    color: #4b5563;
}

/* 会员信息 */
.vip-info {
    margin-top: 20rpx;
    position: relative;
    z-index: 1;
}

.vip-badge-row {
    display: flex;
    align-items: center;
    gap: 10rpx;
    padding: 14rpx 18rpx;
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    border-radius: 20rpx;
    border: 1rpx solid rgba(245, 158, 11, 0.15);
}

.vip-label-badge {
    flex-shrink: 0;
    padding: 4rpx 14rpx;
    border-radius: 12rpx;
    font-size: 20rpx;
    font-weight: 700;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: #ffffff;
    box-shadow: 0 2rpx 6rpx rgba(245, 158, 11, 0.25);
}

.vip-date-text {
    flex: 1;
    font-size: 22rpx;
    font-weight: 500;
    color: #92400e;
}

.vip-days-tag {
    flex-shrink: 0;
    padding: 6rpx 14rpx;
    border-radius: 12rpx;
    font-size: 20rpx;
    font-weight: 600;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    border: none;
    box-shadow: 0 2rpx 6rpx rgba(16, 185, 129, 0.25);
}

.vip-warning {
    background: #f59e0b;
    animation: pulse-warning 2s ease-in-out infinite;
}

@keyframes pulse-warning {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.75; }
}

/* 统计数据区域 */
.stats-section {
    background: #ffffff;
    padding: 16rpx 24rpx 24rpx;
}

.stats-grid {
    display: flex;
    gap: 10rpx;
}

.stat-item {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14rpx;
    background: #f9fafb;
    border-radius: 20rpx;
    padding: 16rpx 18rpx;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    border: 1rpx solid #f3f4f6;
}

.stat-item:active {
    transform: translateY(-1rpx);
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    background: #f3f4f6;
    border-color: #e5e7eb;
}

.stat-icon {
    flex-shrink: 0;
    width: 52rpx;
    height: 52rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.stat-markers .stat-icon {
    color: #3b82f6;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.12) 0%, rgba(59, 130, 246, 0.06) 100%);
}

.stat-friends .stat-icon {
    color: #10b981;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(16, 185, 129, 0.06) 100%);
}

.stat-deleted .stat-icon {
    color: #f59e0b;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(245, 158, 11, 0.06) 100%);
}

.stat-info {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.stat-value {
    font-size: 30rpx;
    font-weight: 700;
    line-height: 42rpx;
    color: #111827;
    white-space: nowrap;
    margin-bottom: 2rpx;
}

.stat-markers .stat-value {
    color: #3b82f6;
}

.stat-friends .stat-value {
    color: #10b981;
}

.stat-deleted .stat-value {
    color: #f59e0b;
}

.stat-title {
    font-size: 20rpx;
    font-weight: 500;
    color: #6b7280;
    line-height: 28rpx;
    white-space: nowrap;
}
