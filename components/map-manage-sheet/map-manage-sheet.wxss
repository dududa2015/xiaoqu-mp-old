.sheet-host {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0;
  padding: 16rpx 24rpx 24rpx;
  background: #f5f5f5;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
}

.handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.12);
}

.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 44rpx;
  margin-bottom: 12rpx;
}

.title {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.88);
}

.status {
  padding: 48rpx 32rpx 24rpx;
  text-align: center;
  color: #888;
  font-size: 28rpx;
}

.group {
  width: 100%;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 48rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.group-title {
  padding: 24rpx 32rpx 0;
  font-size: 24rpx;
  color: #888;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(34, 34, 34, 0.08);
}

.row-last {
  border-bottom: none;
}

.label-wrap {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #222;
}

.hint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888;
}

.edit-mode {
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(34, 34, 34, 0.08);
}

.edit-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.edit-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.edit-required {
  margin-left: 6rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #ff4d4f;
}

.edit-input {
  width: 100%;
  height: 80rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f5f5f5;
  font-size: 30rpx;
  color: #1a1a1a;
}

.edit-placeholder {
  color: #bfbfbf;
}

.edit-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.edit-btn {
  margin-left: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666666;
}

.save-btn {
  background: #0074fe;
  color: #ffffff;
}

.tail {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.value {
  font-size: 26rpx;
  color: #888;
}

.tag {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.tag.is-owner {
  color: #3CB371;
  background: rgba(60, 179, 113, 0.12);
}

.tag.is-editor {
  color: #0074FE;
  background: rgba(0, 116, 254, 0.1);
}

.tag.is-viewer {
  color: #888;
  background: #f5f5f5;
}

.invite {
  padding: 16rpx 32rpx 8rpx;
}

.invite-actions {
  display: flex;
  flex-direction: row;
}

.share {
  flex: 1;
  width: 0;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 72rpx;
  color: #3CB371;
  background: #f5f5f5;
  border: none;
  border-radius: 999rpx;
}

.share-gap {
  margin-right: 16rpx;
}

.invite .hint {
  margin-top: 12rpx;
}

.empty {
  padding: 8rpx 32rpx 28rpx;
  font-size: 24rpx;
  color: #888;
}

.danger {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  color: #e34d59;
  background: #fff;
  border-radius: 48rpx;
  box-sizing: border-box;
}
