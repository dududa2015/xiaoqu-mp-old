.bottom-bar-container {
  position: absolute;
  text-align: center;
  opacity: 0.95;
}

.add-wrap {
  background-color: #fff;
  padding: 12rpx 16rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.shadow {
  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
}

.dimension-wrap {
  background-color: #fff;
  padding: 16rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.dimension-text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
  width: 44rpx;
  height: 44rpx;
}

.location-wrap {
  background-color: #fff;
  padding: 16rpx;
  border-radius: 48rpx;
}

.location-wrap-highlight {
  animation: location-btn-breathe 1.6s ease-in-out infinite;
}

@keyframes location-btn-breathe {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
  }

  50% {
    transform: scale(1.06);
    box-shadow: 0 0 0 4rpx rgba(0, 116, 254, 0.2), 0 6px 16px rgba(0, 116, 254, 0.28);
  }
}

.img-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.img {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  z-index: 0;
}

.text {
  font-size: 18rpx;
  font-weight: 400;
  color: #000;
  line-height: 32rpx;
  height: 32rpx;
}