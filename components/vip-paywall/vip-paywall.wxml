<t-popup visible="{{visible}}" placement="bottom" close-on-overlay-click="{{false}}" style="--td-popup-bg-color: transparent; --td-popup-border-radius: 0;">
  <view class="paywall">
    <view class="handle"></view>
    <view class="head">
      <view class="head-icon">
        <t-icon name="time" size="40rpx" color="#0074FE" />
      </view>
      <text class="head-title">核心功能不限时</text>
    </view>
    <text class="desc">每日使用时长限制已取消，无需观看视频解锁。</text>
    <view class="actions">
      <view class="action action-primary" bind:tap="onContinue">
        <view class="action-icon">
          <t-icon name="check-circle-filled" size="40rpx" color="#fff" />
        </view>
        <view class="action-copy">
          <text class="action-name">继续使用</text>
          <text class="action-sub">楼号查询、收藏和路线等功能全天可用</text>
        </view>
      </view>
    </view>
  </view>
</t-popup>
