.paywall {
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
}

.handle {
  width: 64rpx;
  height: 8rpx;
  margin: 8rpx auto 28rpx;
  border-radius: 8rpx;
  background: #E5E5EA;
}

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.head-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #E8F2FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.head-title {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #1D2129;
  line-height: 50rpx;
}

.time-chip {
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #F3F4F6;
  font-size: 24rpx;
  color: #6B7280;
  font-variant-numeric: tabular-nums;
}

.desc {
  display: block;
  margin: 20rpx 0 32rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6B7280;
  text-align: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
}

.action:active {
  opacity: 0.88;
}

.action-primary {
  background: #0074FE;
}

.action-vip {
  background: #F5F8FC;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-icon-vip {
  background: #fff;
}

.action-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.action-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  color: #fff;
}

.action-name-dark {
  color: #1D2129;
}

.action-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: rgba(255, 255, 255, 0.78);
}

.action-vip .action-sub {
  color: #6B7280;
}
