<t-popup visible="{{showNoAd}}" show-overlay="{{false}}" placement="bottom" touchmove='false' style="background:#fff;padding-left: 24rpx; padding-right: 24rpx; width: calc(100% - 48rpx);">
  <view class="close-btn" bind:tap="onClose">
    <image src="/images/controls/cross.png" mode="" style="width: 40rpx; height: 40rpx;" />
  </view>
  <view class="popup-title">看视频免广告</view>
  <view class="popup-desc">观看2段短视频广告，即可获得24小时免弹窗和格子广告的特权。（注意：封面广告无法免去）</view>
  <!-- 位置、形状、旋转设置 免首页的弹窗和格子广告-->
  <view class="margin16">
    <button type="primary" disabled="{{number === 2}}" style="background-color: #0074FE; " bind:tap="onViewAd">观看广告({{number|| 0}}/2)</button>
  </view>
</t-popup>