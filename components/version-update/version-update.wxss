.container {
  border-radius: 32rpx;
  overflow: hidden;
}

.header {
  width: 550rpx;
  height: 250rpx;

}

.header-img {
  width: 550rpx;
  height: 250rpx;
}

.header-title {
  padding: 108rpx 0 0 60rpx;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0px;
  height: 56rpx;
  line-height: 56rpx;
  color: #fff;
}

.header-desc {
  margin: 32rpx 0 0 60rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0rpx;
  line-height: 28rpx;
  color: #fff;
}

.header-version {
  margin: 16rpx 0 0 60rpx;
  width: 111rpx;
  height: 40rpx;
  border-radius: 8rpx;
  /* background: rgba(20, 83, 255, 0.38); */
  /* display: flex;
    justify-content: center;
    align-items: center; */
  /** 文本1 */
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0rpx;
  line-height: 26rpx;
  color: #fff;
}

.content {
  height: 240rpx;
  padding-left: 42rpx;
}

.text {
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0px;
  line-height: 34.75rpx;
  color: rgba(0, 0, 0, 1);
  text-align: left;
}

.tip-text {
  margin-top: 12px;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0px;
  line-height: 50rpx;
  height: 50rpx;
  color: #E85827;
  text-align: left;
}

.footer {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 160rpx;
}

.btn1 {
  width: 180rpx;
  height: 72rpx;
  opacity: 1;
  border: #a3a3a3 1rpx solid;
  border-radius: 54rpx;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 72rpx;
  color: rgba(112, 112, 112, 1);
  text-align: center;
}

.btn2 {
  width: 180rpx;
  height: 72rpx;
  opacity: 1;
  border-radius: 54rpx;
  background: #0074FE;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 72rpx;
  color: rgba(255, 255, 255, 1);
  text-align: center;
}

