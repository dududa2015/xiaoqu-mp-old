.sheet-host {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0 12rpx 12rpx;
  padding: 16rpx 32rpx 16rpx;
  box-sizing: border-box;
  min-height: calc(100% - 12rpx);
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
}

.handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.12);
}

.poi-wrap {
  position: relative;
}

.poi-title {
  display: block;
  height: 60rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 60rpx;
  color: #111111;
}

.poi-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.poi-tag {
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.poi-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 36rpx;
  color: rgba(0, 0, 0, 0.5);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.poi-images {
  width: 100%;
  height: 136rpx;
  margin-top: 16rpx;
}

.poi-images-row {
  display: flex;
  flex-direction: row;
}

.poi-image {
  width: 120rpx;
  height: 120rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
}

.button-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f6f8fc;
}

.left,
.right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.thumb {
  width: 72rpx;
  /* margin-right: 8rpx; */
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thumb-img {
  width: 38rpx;
  height: 38rpx;
}

.b-text {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #000000;
}

.nav-btn {
  width: 120rpx;
  margin-right: 16rpx;
}

.route-btn {
  width: 120rpx;
}
