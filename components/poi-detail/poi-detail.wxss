.poi-wrap {
  position: relative;
  padding: 24rpx 0;
  /* width: calc(100% - 64rpx); */
  background-color: #fff;
}

.poi-close {
  position: absolute;
  top: 12rpx;
  right: 0;
  padding: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: transparent;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  transition: transform 0.1s ease;
}

.poi-close:active {
  transform: scale(0.95);
  box-shadow: none;
  background: transparent;
}

.poi-title-text {
  line-height: 60rpx;
  height: 60rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.poi-tag-warp {
  padding-left: 0;
  line-height: 60rpx;
}

.poi-tag {
  margin-right: 8rpx;
}

.poi-images-scroll {
  width: 100%;
  margin-top: 16rpx;
  max-height: 176rpx;
}

.poi-images-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding-right: 8rpx;
}

.poi-image-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #f3f4f6;
}

.poi-desc {
  color: rgba(0, 0, 0, 0.5);
  line-height: 36rpx;
  font-size: 22rpx;
  font-weight: 400;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
  direction: rtl;
}

.operation {
  width: 300rpx;
  height: 92rpx;
  position: absolute;
  top: 16rpx;
  right: 0;
  background-color: red;
}

.poi-edit-wrap {
  width: 56rpx;
  height: 56rpx;
  position: absolute;
  top: 16rpx;
  right: 104rpx;
  background-color: #F1F6F7;
  border-radius: 50%;
}

.poi-edit {
  margin-top: 12rpx;
}

.poi-edit-desc {
  position: absolute;
  top: 72rpx;
  right: 104rpx;
  width: 56rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
}

.poi-delete-wrap {
  width: 56rpx;
  height: 56rpx;
  position: absolute;
  top: 16rpx;
  right: 32rpx;
  background-color: #F1F6F7;
  border-radius: 50%;
}

.poi-delete-desc {
  position: absolute;
  top: 72rpx;
  right: 32rpx;
  width: 56rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
}

.poi-go {
  width: 56rpx;
  height: 56rpx;
  position: absolute;
  top: 16rpx;
  right: 32rpx;
}

.poi-go-desc {
  position: absolute;
  top: 72rpx;
  right: 32rpx;
  width: 56rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
}

.button-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #F6F8FC;
  padding-bottom: 16rpx;
}

.left {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.thumb-wrap {
  width: 72rpx;
  height: 72rpx;
  text-align: center;
  display: flex;
  /* 使用flexbox */
  flex-direction: column;
  /* 垂直方向排列子元素 */
  justify-content: center;
  /* 垂直居中对齐 */
  align-items: center;
  /* 水平方向居中对齐 */
}

.b-text {
  font-size: 20rpx;
  height: 18px;
  line-height: 18px;
  color: #000;
}

.b-text-grey {
  font-size: 20rpx;
  height: 18px;
  line-height: 18px;
  color: #bfbfbf;
}

.right {
  margin-top: 16rpx;
  margin-right: 32rpx;
}

.img {
  width: 38rpx;
  height: 38rpx;
}