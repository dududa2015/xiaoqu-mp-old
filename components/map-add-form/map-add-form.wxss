.sheet-host {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0;
  padding: 0 16rpx 16rpx;
  background: #f5f5f5;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  overflow: visible;
}

.form-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding: 4rpx 0;
}

.form-header-slot {
  display: flex;
  align-items: center;
  min-width: 0;
}

.form-header-slot--start,
.form-header-slot--end {
  flex: 1;
}

.form-header-slot--start {
  justify-content: flex-start;
}

.form-header-slot--end {
  justify-content: flex-end;
}

.form-header-slot--center {
  flex: 0 1 auto;
  justify-content: center;
  max-width: 46%;
  padding: 0 12rpx;
}

.form-header-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.88);
  text-align: center;
}

.ios-toolbar-btn {
  padding: 12rpx 32rpx;
  border-radius: 1000rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.ios-toolbar-btn--pressed {
  opacity: 0.72;
}

.ios-toolbar-btn__label {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(60, 60, 67, 0.92);
}

.input-wrap {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(34, 34, 34, 0.08);
}

.form-row:last-child {
  border-bottom: none;
}

.row-label {
  flex: 0 0 auto;
  margin-right: 16rpx;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #222222;
}

.required {
  color: #e34d59;
}

.row-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #222222;
}

.row-placeholder {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
}

.chip-scroll {
  flex: 1;
  min-width: 0;
  height: 56rpx;
}

.chip-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 56rpx;
}

.text-tag {
  margin-right: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #f3f3f3;
  color: #222222;
  font-size: 24rpx;
  line-height: 32rpx;
}

.text-tag-on {
  color: #ffffff;
}

.direction-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #f3f3f3;
}

.direction-tag-on {
  background: #0074fe;
}

.direction-icon {
  font-size: 22rpx;
  line-height: 24rpx;
}

.direction-label {
  margin-left: 8rpx;
  font-size: 24rpx;
  line-height: 24rpx;
  color: #222222;
}

.direction-tag-on .direction-label {
  color: #ffffff;
}

.form-row-photo {
  align-items: flex-start;
}

.photo-row {
  flex: 1;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.photo,
.photo-add {
  width: 108rpx;
  height: 108rpx;
  margin: 0 8rpx 8rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo {
  position: relative;
}

.photo-img {
  width: 108rpx;
  height: 108rpx;
}

.photo-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f3f3;
}

.photo-add-icon {
  width: 50rpx;
  height: 50rpx;
}
