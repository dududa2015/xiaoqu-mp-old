.close-btn {
  position: absolute;
  right: -24rpx;
  top: 0;
  width: 100rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.popup-title {
  margin-left: 24rpx;
  font-weight: 600;
  font-size: 32rpx;
  line-height: 96rpx;
}

.content {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 24rpx 36rpx;
  background-color: #fff;
  border-radius: 32rpx;
}

.col {
  margin-right: 48rpx;
  text-align: center;
}

.img {
  width: 108rpx;
  height: 108rpx;
  border: 2px solid #fff;
  border-radius: 40%;
}

.img-checked {
  border: 2px solid #0074FE;
}

.text {
  font-size: 24rpx;
  font-weight: 400;
}

.text-checked {
  color: #0074FE;
}

.setting {
  background-color: #fff;
  margin: 32rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
}

.row {
  position: relative;
  padding: 24rpx;
}

.last-row {
  position: relative;
  padding: 24rpx;
}

.row::after {
  position: absolute;
  box-sizing: border-box;
  content: ' ';
  pointer-events: none;
  right: 0;
  left: 0;
  bottom: 0;
  border-bottom: 1px solid #e7e7e7;
  transform: scaleY(0.5);
  transform-origin: bottom;
  left: 24rpx;
}

.row-title {
  color: #333;
  font-size: 28rpx;
  font-weight: 400;
}


.t-radio {
  margin-right: 16rpx;
}

.desc {
  margin: 32rpx 32rpx 32rpx 64rpx;
  font-size: 20rpx;
}

.color-wrap {
  background-color: #fff;
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
}



.title-sub {
  display: none;
  margin-left: 4px;
  font-weight: 400;
  font-size: 10px;
  color: #333;
  line-height: 14px;
  text-align: left;
  font-style: normal;
}

.color-item {
  margin: 16rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}