.close-btn {
    position: absolute;
    right: -24rpx;
    top: 0;
    width: 100rpx;
    height: 72rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.popup-title {
    margin-left: 24rpx;
    font-weight: 600;
    font-size: 32rpx;
    line-height: 96rpx;
}

.content {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 24rpx 36rpx;
    background-color: #fff;
    border-radius: 32rpx;
}

.margin32 {
    margin-top: 32rpx;
}

.col {
    margin-right: 48rpx;
    text-align: center;
}

.img {
    width: 108rpx;
    height: 108rpx;
    border: 2px solid #fff;
    border-radius: 40%;
}

.img-checked {
    border: 2px solid #0074FE;
}

.text {
    font-size: 24rpx;
    font-weight: 400;
}

.text-checked {
    color: #0074FE;
}

.setting {
    background-color: #fff;
    margin: 32rpx 0;
    border-radius: 32rpx;
    overflow: hidden;
}

.row {
    position: relative;
    padding: 24rpx;
}

.last-row {
    position: relative;
    padding: 24rpx;
}

.row::after {
    position: absolute;
    box-sizing: border-box;
    content: ' ';
    pointer-events: none;
    right: 0;
    left: 0;
    bottom: 0;
    border-bottom: 1px solid #e7e7e7;
    transform: scaleY(0.5);
    transform-origin: bottom;
    left: 24rpx;
}

.row-title {
    color: #333;
    font-size: 28rpx;
    font-weight: 400;
    position: relative;
}

.row-icon {
    margin-right: 16rpx;
    width: 64rpx;
    height: 64rpx;
    background-color: #F5F5F5;
    border-radius: 50%;
}

.row-icon-selected {
    background-color: rgba(0, 116, 254, 0.3);
    border-color: #0074FE;
}

.help-icon {
    margin-left: 12rpx;
}

.t-radio {
    margin-right: 16rpx;
}

.desc {
    margin: 32rpx 32rpx 32rpx 64rpx;
    font-size: 20rpx;
}

.color-wrap {
    background-color: #fff;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
}



.title-sub {
    display: none;
    margin-left: 4px;
    font-weight: 400;
    font-size: 10px;
    color: #333;
    line-height: 14px;
    text-align: left;
    font-style: normal;
}

.color-item {
    margin: 16rpx;
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
}

.border-show {
    border: 1px solid #e7e7e7;
}

.border-hidden {
    border: 1px solid transparent;
}
.red-dot {
    position: absolute;
    top: -4rpx;
    right: -18rpx;
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    background: #ff2d55;
}

/* 定位图标帮助提示 */
.loc-icon-help-icon-wrapper {
    position: relative;
    display: inline-block;
    margin-left: 8rpx;
    vertical-align: middle;
}

.loc-icon-help-icon {
    width: 32rpx;
    height: 32rpx;
    border-radius: 50%;
    background-color: #e6f7ff;
    border: 2rpx solid #91d5ff;
    display: flex;
    align-items: center;
    justify-content: center;
}

.loc-icon-help-icon-text {
    font-size: 20rpx;
    color: #1890ff;
    font-weight: 600;
    line-height: 1;
}

.loc-icon-tooltip {
    position: absolute;
    top: 50%;
    left: calc(100% + 8rpx);
    transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 8rpx;
    padding: 12rpx 16rpx;
    /* max-width: 400rpx;
    min-width: 200rpx; */
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
    animation: tooltip-fade-in 0.2s ease-out;
    z-index: 1000;
    white-space: nowrap;
}

.loc-icon-tooltip-text {
    font-size: 22rpx;
    color: #ffffff;
    line-height: 1.5;
    display: block;
}

.loc-icon-tooltip-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -8rpx;
    width: 0;
    height: 0;
    border-top: 8rpx solid transparent;
    border-bottom: 8rpx solid transparent;
    border-right: 8rpx solid rgba(0, 0, 0, 0.85);
}

@keyframes tooltip-fade-in {
    from {
        opacity: 0;
        transform: translateY(-50%) translateX(-4rpx);
    }
    to {
        opacity: 1;
        transform: translateY(-50%) translateX(0);
    }
}

/* tooltip遮罩层 */
.tooltip-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background-color: transparent;
}