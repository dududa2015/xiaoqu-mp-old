.host {
  width: 100%;
  height: 100%;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  pointer-events: none;
  transition: opacity 280ms ease;
}

.mask.is-on {
  opacity: 1;
  pointer-events: auto;
}

.sheet-host {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  overflow: visible;
}

.form-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding: 4rpx 0;
}

.form-header-slot {
  display: flex;
  align-items: center;
  min-width: 0;
}

.form-header-slot--start,
.form-header-slot--end {
  flex: 0 0 auto;
}

.form-header-slot--start {
  justify-content: flex-start;
}

.form-header-slot--end {
  justify-content: flex-end;
}

.form-header-slot--center {
  flex: 1;
  min-width: 0;
  justify-content: center;
  padding: 0 12rpx;
}

.form-header-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.88);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ios-toolbar-btn {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 1000rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.ios-toolbar-btn--pressed {
  opacity: 0.72;
}

.ios-toolbar-btn__label {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: rgba(60, 60, 67, 0.92);
  white-space: nowrap;
}

.content {
  padding: 8rpx 0 0;
  box-sizing: border-box;
}

.hint {
  display: block;
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #888888;
}

.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.row {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.line {
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.row-last .line {
  display: none;
}

.label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #222222;
}

.value {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #888888;
  text-align: right;
}

.tag {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 30rpx;
}

.map-card {
  height: 320rpx;
}

.map-preview {
  width: 100%;
  height: 320rpx;
}

.empty-map {
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-title {
  font-size: 28rpx;
  color: #222222;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.photo-card {
  padding: 24rpx 32rpx;
}

.photo-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #222222;
}

.photo-scroll {
  width: 100%;
  height: 160rpx;
}

.photo-row {
  display: flex;
  flex-direction: row;
  height: 160rpx;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.action {
  padding-bottom: 8rpx;
}

.map-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #0074fe;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.map-btn.is-off {
  opacity: 0.4;
}
