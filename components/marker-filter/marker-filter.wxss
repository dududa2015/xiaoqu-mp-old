    border-right: 1px solid;
    border-color: #0052d9;
    transition: border-color .2s cubic-bezier(0, 0, .15, 1);
} */

.t-radio-group .t-radio-button:first-child {
    border-radius: 2px 2px;
}

.t-radio-group.t-size-m .t-radio-button {
    height: calc(32px -(2px* 2));
    padding: 4px 16px var(--td-comp-paddingLR-l);
    font-size: 14px;
}

.t-radio-button__label {
    text-align: center;
    width: 42px;
}

.t-radio-group.t-radio-group--filled .t-radio-button {
    color: #fff;
    border: 0;
    background-color: transparent;
}

.t-radio-group .t-radio-button {
    cursor: pointer;
    position: relative;
    border: 1px solid;
    border-color: rgba(0, 0, 0, 0.6);
    border-right: 0;
    display: inline-flex;
    align-items: center;
    transition: color .2s cubic-bezier(0, 0, .15, 1);
    color: rgba(0, 0, 0, 0.9);
    white-space: nowrap;
    box-sizing: border-box;
}

.t-radio-group.t-radio-group--filled .t-radio-button.t-is-checked:before {
    opacity: 0;
}

.t-radio-group.t-radio-group--filled .t-radio-button:first-child:before {
    opacity: 0;
}

.t-radio-group.t-size-m .t-radio-button:before {
    height: calc(100% - 20px);
}

.t-radio-group.t-radio-group--filled .t-radio-button:before {
    content: "";
    position: absolute;
    left: 0px;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: calc(100% - 16px);
    background-color: #0074FE;
    transition: opacity .2s cubic-bezier(0, 0, .15, 1);
}

.t-radio-group .t-radio-button__former {
    opacity: 0;
    height: 0;
    width: 0;
    font: 14px / calc(14px + 8px) PingFang SC, Microsoft YaHei, Arial Regular;
    color: rgba(0, 0, 0, 0.9);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    list-style: none;
}

.t-radio-group.t-radio-group--filled .t-radio-button.t-is-checked {
    position: relative;
    color: #0074FE;
    z-index: 1;
    border: 0;
    transition: color .2s linear;
}

.t-radio-group.t-size-m .t-radio-button {
    height: calc(32px -(2px* 2));
    padding: 4px 16px;
    font-size: 14px;
    font-weight: 500;
}

.t-radio-group .t-radio-button {
    cursor: pointer;
    position: relative;
    border: 1px solid;
    border-color: #0074FE;
    border-right: 0;
    display: inline-flex;
    align-items: center;
    transition: color .2s cubic-bezier(0, 0, .15, 1);
    color: rgba(0, 0, 0, 0.9);
    white-space: nowrap;
    box-sizing: border-box;
}

.t-radio-group.t-radio-group--filled .t-radio-group__bg-block {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 0;
    height: calc(100% - 4px);
    background-color: #fff;
    transition: all .2s cubic-bezier(.38, 0, .24, 1);
    border-radius: 2px;
}