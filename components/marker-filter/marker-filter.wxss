.marker-filter-wrap {
    position: absolute;
    bottom: 32rpx;
    left: 50%;
    transform: translateX(-50%);
}

.check-tag-wrap {
    position: relative;
}

.check-tag {
    display: flex;
}

.card {
    margin-right: 16rpx;
    background-color: #fff;
    padding: 0 20rpx;
    border-radius: 32rpx;
    font-size: 26rpx;
    color: rgba(0, 0, 0, 0.9);
    line-height: 48rpx;
}

.card-checked {
    background-color: #B05923;
    color: #fff;
    font-weight: 500;
}

.shadow {
    box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
}

.absolute {
    position: absolute;
    bottom: 32rpx;
    left: 0;
}

.cover-view {
    width: 152px;
    height: 34px;
    /* background-color: red; */
    border-radius: 3px;
}


.t-radio-group.t-radio-group--filled {
    padding: 2px 2px;
    border-radius: 3px;
    background-color: #0074FE;
    position: relative;
}

.t-radio-group {
    font: 14px / calc(14px + 8px) PingFang SC, Microsoft YaHei, Arial Regular;
    color: rgba(0, 0, 0, 0.9);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    list-style: none;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    border-radius: 3px;
    flex-wrap: wrap;
}

.t-radio-group.t-radio-group--filled .t-radio-button.t-is-checked {
    position: relative;
    color: rgba(0, 0, 0, 0.9);
    z-index: 1;
    border: 0;
    transition: color .2s linear;
}

