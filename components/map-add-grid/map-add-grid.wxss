.sheet-host {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0 12rpx 12rpx;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  overflow: visible;
}

.sheet-body {
  padding-top: 16rpx;
  padding-bottom: 24rpx;
}

.handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.12);
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  width: 100%;
  padding: 8rpx 0 0;
}

.grid-item {
  height: 144rpx;
  min-width: 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.grid-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 40%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-glyph {
  width: 72rpx;
  height: 72rpx;
}

.grid-text {
  font-size: 24rpx;
  line-height: 48rpx;
  font-weight: 400;
  color: #333333;
}
