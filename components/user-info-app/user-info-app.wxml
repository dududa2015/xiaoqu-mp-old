<view class="user-container">
    <!-- 用户信息区域 -->
    <view class="user-section" bind:tap="toLogin">
        <view class="user-content">
            <view class="avatar-wrapper">
                <image src="/images/my/avatar.png" class="user-avatar" mode="aspectFill" />
                <view class="avatar-glow"></view>
            </view>
            <view class="user-details">
                <view class="name-group">
                    <text class="user-name">{{nickName}}</text>
                    <view class="badge-group">
                        <view class="badge-item badge-vip" wx:if="{{showVip}}">VIP</view>
                    </view>
                </view>
                <view class="user-meta">
                    <text class="user-id">ID: {{userId}}</text>
                </view>
            </view>
            <view class="action-btn">
                <t-icon name="edit" size="28rpx" color="#ffffff" />
            </view>
        </view>
        <!-- 会员到期信息 -->
        <view class="vip-info" wx:if="{{vipExpiredDate}}">
            <view class="vip-badge-row">
                <view class="vip-label-badge">{{showVip ? 'VIP' : '过期'}}</view>
                <text class="vip-date-text">{{vipExpiredDate}}</text>
                <view class="vip-days-tag" wx:if="{{showVip && !isVipExpiringSoon}}">会员有效</view>
                <view class="vip-days-tag vip-warning" wx:elif="{{showVip && isVipExpiringSoon}}">剩{{vipDaysLeft}}天</view>
            </view>
        </view>
    </view>

    <!-- 统计数据区域 -->
    <view class="stats-section">
        <view class="stats-grid">
            <view class="stat-item stat-markers" bind:tap="toMarkers" data-deleted="{{0}}">
                <view class="stat-icon">
                    <t-icon name="location" size="40rpx" />
                </view>
                <view class="stat-info">
                    <view class="stat-value">{{markers || 0}}</view>
                    <view class="stat-title">标记</view>
                </view>
            </view>
            
            <view class="stat-item stat-friends" bind:tap="showToast" data-number="{{friends || 0}}" data-type="friend">
                <view class="stat-icon">
                    <t-icon name="usergroup" size="40rpx" />
                </view>
                <view class="stat-info">
                    <view class="stat-value">{{friends || 0}}</view>
                    <view class="stat-title">好友</view>
                </view>
            </view>

            <view class="stat-item stat-deleted" bind:tap="toMarkers" data-deleted="{{1}}">
                <view class="stat-icon">
                    <t-icon name="delete" size="40rpx" />
                </view>
                <view class="stat-info">
                    <view class="stat-value">{{deleted || 0}}</view>
                    <view class="stat-title">被删除</view>
                </view>
            </view>
        </view>
    </view>
</view>