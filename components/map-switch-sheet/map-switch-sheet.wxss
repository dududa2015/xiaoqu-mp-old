.sheet-host {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0;
  padding: 16rpx 24rpx 0;
  background: #f5f5f5;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
}

.handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.12);
}

.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 44rpx;
  margin-bottom: 12rpx;
}

.title {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.88);
}

.cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-radius: 48rpx;
}

.badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
}

.is-public {
  background: #0074FE;
}

.is-personal {
  background: #E85827;
}

.is-shared {
  background: #3CB371;
}

.meta {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.name.is-on-public {
  color: #0074FE;
}

.name.is-on-personal {
  color: #E85827;
}

.name.is-on-shared {
  color: #3CB371;
}

.desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888;
}

.cell.is-stack {
  flex-direction: column;
  align-items: stretch;
}

.cell-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.pub-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(34, 34, 34, 0.08);
}

.pub-label {
  font-size: 26rpx;
  color: #222;
}

.check {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.manage {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #222;
  background: #f3f4f6;
  border-radius: 999rpx;
}
