<t-popup visible="{{visible}}" placement="center" bind:visible-change="onVisibleChange" style="--td-popup-bg-color: transparent; --td-popup-border-radius: 0;">
  <view class="sheet">
    <view class="hero">
      <view class="hero-icon">
        <t-icon name="time" size="44rpx" color="#0074FE" />
      </view>
      <text class="hero-label">核心功能</text>
      <text class="hero-time">全天可用</text>
    </view>
    <view class="body">
      <text class="lead">每日使用时长限制已取消。</text>
      <view class="points">
        <view class="point">
          <view class="dot"></view>
          <text class="point-text">楼号查询、收藏和路线等功能不限时</text>
        </view>
        <view class="point">
          <view class="dot"></view>
          <text class="point-text">无需观看激励视频解锁</text>
        </view>
      </view>
      <view class="btn-primary" bind:tap="onKnow">知道了</view>
    </view>
  </view>
</t-popup>
