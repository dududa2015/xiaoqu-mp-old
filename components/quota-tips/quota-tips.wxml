<view wx:if="{{visible}}" class="quota-tips quota-tips--{{phase}} {{locked ? 'quota-tips--locked' : ''}}">
  <view class="quota-tips-bar" bind:tap="onToggle" hover-class="{{locked ? '' : 'quota-tips-bar--pressed'}}" hover-stay-time="80">
    <view class="quota-tips-icon">
      <t-icon name="{{unlocked ? 'check-circle-filled' : 'time'}}" size="28rpx" color="#0074FE" />
    </view>
    <view class="quota-tips-copy">
      <text class="quota-tips-label">{{unlocked ? '今日已解锁' : '今日免费至'}}</text>
      <text wx:if="{{!unlocked}}" class="quota-tips-time">{{deadlineText || '--:--'}}</text>
    </view>
    <view wx:if="{{!locked}}" class="quota-tips-more">
      <t-icon name="{{phase === 'expanded' ? 'chevron-up' : 'chevron-down'}}" size="24rpx" color="#9CA3AF" />
    </view>
  </view>
  <view class="quota-tips-extra">
    <text class="quota-tips-title">{{unlocked ? '今日已解锁全部功能' : (locked ? '免费时段已结束' : '浏览不再弹广告')}}</text>
    <text class="quota-tips-desc">{{unlocked ? '今日已解锁全部功能。开通会员后全天不限。' : (locked ? '免费时段已结束，可开通会员继续使用。' : '封面、插屏、格子广告已取消。每天第一次打开可免费使用半小时；到点后可开通会员继续使用。')}}</text>
    <view class="quota-tips-actions">
      <!-- 看视频解锁今天：临时关闭
      <view wx:if="{{!unlocked}}" class="quota-tips-btn quota-tips-btn-primary" catch:tap="onPlay">看视频解锁今天</view>
      -->
      <view class="quota-tips-btn quota-tips-btn-vip quota-tips-btn-vip-solo" catch:tap="onOpenVip">开通会员</view>
    </view>
    <text class="quota-tips-count" wx:if="{{countdown > 0}}">{{countdown}}s 后收起</text>
  </view>
</view>
