.quota-tips {
  position: absolute;
  top: 240rpx;
  left: 125rpx;
  z-index: 8;
  display: inline-flex;
  flex-direction: column;
  align-items: stretch;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 116, 254, 0.12);
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
  transition:
    padding 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    border-radius 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}

.quota-tips--expanded {
  width: 500rpx;
  padding: 12rpx 12rpx 20rpx;
  border-radius: 28rpx;
}

.quota-tips--locked {
  z-index: 21;
}

.quota-tips--collapsing,
.quota-tips--collapsed {
  width: auto;
  padding: 8rpx 8rpx 8rpx 12rpx;
  border-radius: 48rpx;
}

.quota-tips-bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  width: max-content;
}

.quota-tips--expanded .quota-tips-bar {
  width: 100%;
}

.quota-tips-bar--pressed {
  opacity: 0.72;
}

.quota-tips-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E8F2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quota-tips-copy {
  margin-left: 10rpx;
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  flex-shrink: 0;
}

.quota-tips--collapsed .quota-tips-copy,
.quota-tips--collapsing .quota-tips-copy {
  flex: none;
}

.quota-tips-label {
  font-size: 22rpx;
  line-height: 32rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.quota-tips-time {
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #0074FE;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.quota-tips-more {
  margin-left: 4rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.quota-tips-extra {
  overflow: hidden;
  max-height: 560rpx;
  opacity: 1;
  transform: translateY(0);
  padding: 16rpx 8rpx 0 8rpx;
  transition:
    max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.35s ease,
    transform 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    padding 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}

.quota-tips--collapsing .quota-tips-extra,
.quota-tips--collapsed .quota-tips-extra {
  max-height: 0;
  width: 0;
  height: 0;
  opacity: 0;
  transform: translateY(-40rpx);
  padding: 0;
  pointer-events: none;
}

.quota-tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  color: #111827;
}

.quota-tips-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4B5563;
}

.quota-tips-actions {
  margin-top: 24rpx;
}

.quota-tips-btn {
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
}

.quota-tips-btn-primary {
  background: #0074FE;
  color: #fff;
}

.quota-tips-btn-primary:active {
  opacity: 0.88;
}

.quota-tips-btn-vip {
  margin-top: 16rpx;
  background: #E8F2FF;
  color: #0074FE;
}

.quota-tips-btn-vip:active {
  opacity: 0.86;
}

.quota-tips-btn-vip-solo {
  margin-top: 0;
}

.quota-tips-count {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 34rpx;
  text-align: center;
}
