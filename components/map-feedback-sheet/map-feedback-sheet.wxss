.sheet-host {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sheet-scroll {
  height: 100%;
  pointer-events: none;
  background: transparent;
}

.sheet-scroll.is-open {
  pointer-events: auto;
}

.sheet-card {
  margin: 0;
  padding: 0 16rpx 16rpx;
  background: #f5f5f5;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  overflow: visible;
}

.form-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding: 4rpx 0;
}

.form-header-slot {
  display: flex;
  align-items: center;
  min-width: 0;
}

.form-header-slot--start,
.form-header-slot--end {
  flex: 1;
}

.form-header-slot--start {
  justify-content: flex-start;
}

.form-header-slot--end {
  justify-content: flex-end;
}

.form-header-slot--center {
  flex: 0 1 auto;
  justify-content: center;
  max-width: 46%;
  padding: 0 12rpx;
}

.form-header-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.88);
  text-align: center;
}

.ios-toolbar-btn {
  padding: 12rpx 32rpx;
  border-radius: 1000rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.ios-toolbar-btn--pressed {
  opacity: 0.72;
}

.ios-toolbar-btn__label {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(60, 60, 67, 0.92);
}

.save-label {
  color: #0074FE;
}

.group {
  border-radius: 48rpx;
  background: #ffffff;
  overflow: hidden;
}

.row {
  padding: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(34, 34, 34, 0.08);
}

.row-last {
  border-bottom: none;
}

.row-title {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
  color: #222222;
}
