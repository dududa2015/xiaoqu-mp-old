.locate-stack {
  position: absolute;
  right: 24rpx;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.95;
}

.is-left {
  right: auto;
  left: 24rpx;
}

.add-card {
  background-color: #ffffff;
  padding: 12rpx 16rpx;
  border-radius: 48rpx;
  margin-bottom: 16rpx;
  text-align: center;
  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
}

.add-icon {
  width: 44rpx;
  height: 44rpx;
}

.add-label {
  font-size: 20rpx;
  font-weight: 500;
  color: #000000;
  line-height: 32rpx;
  height: 32rpx;
}

.locate-btn {
  position: relative;
  background-color: #ffffff;
  padding: 16rpx;
  border-radius: 48rpx;
  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.locate-icon {
  width: 42rpx;
  height: 42rpx;
}
