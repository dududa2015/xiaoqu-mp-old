<t-popup visible="{{showVipExpired}}" placement="center" style="width: 620rpx;">
  <view class="container">
    <!-- 顶部区域 -->
    <view class="top-section">
      <view class="status-wrapper">
        <view class="status-badge">
          <t-icon name="error-circle" size="28rpx" color="#fff"></t-icon>
          <text class="badge-label">会员已过期</text>
        </view>
      </view>
      <view class="title-group">
        <text class="main-title">会员已过期</text>
        <text class="sub-title">{{content}}</text>
      </view>
    </view>

    <!-- 权益列表 -->
    <view class="rights-section">
      <view class="section-header">
        <text class="section-title">续费后即可享受</text>
      </view>
      <view class="rights-container">
        <view class="right-item" wx:for="{{rightsList}}" wx:key="title">
          <view class="item-icon-box">
            <image src="{{item.icon}}" class="item-icon-img" wx:if="{{item.icon.indexOf('.svg') !== -1}}"></image>
            <t-icon name="{{item.icon}}" size="32rpx" color="#0074FE" wx:else></t-icon>
          </view>
          <view class="item-info">
            <text class="item-name">{{item.title}}</text>
            <text class="item-detail">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作区 -->
    <view class="bottom-section">
      <view class="countdown-info">
        <text class="countdown-label">{{countdown}} 秒后自动返回</text>
      </view>
      <view class="action-button" bind:tap="onRenewNow">
        <text class="button-text">立即续费</text>
        <t-icon name="chevron-right" size="30rpx" color="#fff"></t-icon>
      </view>
    </view>
  </view>
</t-popup>
