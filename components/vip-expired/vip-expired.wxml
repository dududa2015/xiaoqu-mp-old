<t-popup visible="{{showVipExpired}}" placement="center" close-on-overlay-click="{{false}}" style="width: 640rpx;">
  <view class="container">
    <!-- 图标卡片 -->
    <view class="icon-card">
      <view class="icon-inner">
        <t-icon name="lock-on" size="64rpx" color="#ffffff"></t-icon>
      </view>
    </view>

    <!-- 标题区域 -->
    <view class="title-area">
      <text class="title">{{title}}</text>
      <text class="subtitle">{{tipText}}</text>
    </view>

    <!-- 权益卡片 -->
    <view class="privilege-cards">
      <view class="privilege-card card-1">
        <view class="card-icon-wrapper">
          <image src="/images/my/noad.png" class="card-icon-img" mode="aspectFit"></image>
        </view>
        <view class="card-content">
          <text class="card-title">免广告</text>
          <text class="card-desc">纯净体验</text>
        </view>
      </view>
      <view class="privilege-card card-2">
        <view class="card-icon-wrapper">
          <t-icon name="map-information-2" size="36rpx" color="#1890FF"></t-icon>
        </view>
        <view class="card-content">
          <text class="card-title">个人地图</text>
          <text class="card-desc">自定义标记</text>
        </view>
      </view>
      <view class="privilege-card card-3">
        <view class="card-icon-wrapper">
          <image src="/images/controls/foot.png" class="card-icon-img" mode="aspectFit"></image>
        </view>
        <view class="card-content">
          <text class="card-title">跟随导航</text>
          <text class="card-desc">实时定位</text>
        </view>
      </view>
      <view class="privilege-card card-4">
        <view class="card-icon-wrapper">
          <image src="/images/loc-marker/4.png" class="card-icon-img" mode="aspectFit"></image>
        </view>
        <view class="card-content">
          <text class="card-title">个性化</text>
          <text class="card-desc">定位图标</text>
        </view>
      </view>
    </view>

    <!-- 倒计时 -->
    <view class="countdown-area">
      <text class="countdown-label">{{countdown}} 秒后自动跳转</text>
    </view>

    <!-- 按钮 -->
    <view class="button-group">
      <view class="button primary" bind:tap="onRenewNow">
        <text class="btn-text">{{buttonText}}</text>
      </view>
    </view>
  </view>
</t-popup>
