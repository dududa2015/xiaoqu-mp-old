.container {
  border-radius: 32rpx;
  padding: 56rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 
    0 32rpx 96rpx rgba(0, 0, 0, 0.12),
    0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  animation: modal-appear 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  overflow: hidden;
}

@keyframes modal-appear {
  from {
    opacity: 0;
    transform: scale(0.88) translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* 图标卡片 */
.icon-card {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: icon-bounce 3.5s ease-in-out infinite;
}

.icon-inner {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #0074FE 0%, #00a1ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 32rpx rgba(0, 116, 254, 0.4),
    0 4rpx 16rpx rgba(0, 116, 254, 0.25),
    inset 0 -2rpx 8rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.2);
}

@keyframes icon-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* 标题区域 */
.title-area {
  text-align: center;
  margin-top: 0;
  margin-bottom: 32rpx;
  padding: 0 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #0074FE 0%, #00a1ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 16rpx;
  letter-spacing: 1.5rpx;
  line-height: 1.3;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #666666;
  font-weight: 400;
  line-height: 1.6;
  margin-top: 0;
}

/* 权益卡片 */
.privilege-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 32rpx;
}

.privilege-card {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid #f0f0f0;
  gap: 12rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 
    0 4rpx 12rpx rgba(0, 0, 0, 0.04),
    0 2rpx 6rpx rgba(0, 0, 0, 0.02);
}

.privilege-card:active {
  transform: translateY(-2rpx) scale(0.98);
  border-color: #0074FE;
  box-shadow: 
    0 8rpx 20rpx rgba(0, 116, 254, 0.15),
    0 4rpx 12rpx rgba(0, 116, 254, 0.1);
  background: #f0f7ff;
}

.card-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 14rpx;
}

.card-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.card-1 .card-icon-wrapper {
  background: linear-gradient(135deg, #E8F4FF 0%, #D1E9FF 100%);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 116, 254, 0.12),
    inset 0 2rpx 6rpx rgba(0, 116, 254, 0.08);
}

.card-2 .card-icon-wrapper {
  background: linear-gradient(135deg, #E8FFE0 0%, #D1FFC2 100%);
  box-shadow: 
    0 2rpx 8rpx rgba(82, 196, 26, 0.12),
    inset 0 2rpx 6rpx rgba(82, 196, 26, 0.08);
}

.card-3 .card-icon-wrapper {
  background: linear-gradient(135deg, #E8FCFF 0%, #C2F0FF 100%);
  box-shadow: 
    0 2rpx 8rpx rgba(24, 144, 255, 0.12),
    inset 0 2rpx 6rpx rgba(24, 144, 255, 0.08);
}

.card-4 .card-icon-wrapper {
  background: linear-gradient(135deg, #FFF9E8 0%, #FFEBC2 100%);
  box-shadow: 
    0 2rpx 8rpx rgba(250, 140, 22, 0.12),
    inset 0 2rpx 6rpx rgba(250, 140, 22, 0.08);
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}

.card-desc {
  font-size: 22rpx;
  color: #8a8a8a;
  line-height: 1.4;
}

/* 按钮组 */
.button-group {
  padding: 0 28rpx 48rpx;
}

.button {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.button.primary {
  background: linear-gradient(135deg, #0074FE 0%, #00a1ff 100%);
  box-shadow:
    0 12rpx 40rpx rgba(0, 116, 254, 0.35),
    0 6rpx 20rpx rgba(0, 116, 254, 0.25),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.25),
    inset 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.button.primary:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow:
    0 6rpx 20rpx rgba(0, 116, 254, 0.3),
    0 3rpx 12rpx rgba(0, 116, 254, 0.2),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.25),
    inset 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.button.primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.55s ease;
}

.button.primary:active::before {
  left: 100%;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 倒计时区域 */
.countdown-area {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
}

.countdown-label {
  font-size: 26rpx;
  color: #666666;
  font-weight: 400;
  line-height: 1.6;
  padding: 12rpx 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  border: 1rpx solid #f0f0f0;
}
