.container {
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  position: relative;
}

/* 顶部区域 */
.top-section {
  padding: 32rpx 32rpx 28rpx;
  background: linear-gradient(180deg, #0074FE 0%, #0052d9 100%);
  position: relative;
  overflow: hidden;
}

.top-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  animation: bg-float 6s ease-in-out infinite;
}

@keyframes bg-float {
  0%, 100% {
    transform: translate(0, 0) rotate(0deg);
  }
  50% {
    transform: translate(-10rpx, -10rpx) rotate(180deg);
  }
}

.status-wrapper {
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 18rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.badge-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  margin-left: 8rpx;
  letter-spacing: 0.5rpx;
}

.title-group {
  position: relative;
  z-index: 1;
}

.main-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.sub-title {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
  line-height: 38rpx;
}

/* 权益区域 */
.rights-section {
  padding: 28rpx 32rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  letter-spacing: 0.5rpx;
}

.rights-container {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.right-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  border: 1rpx solid #f3f4f6;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.right-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: linear-gradient(180deg, #0074FE, #0052d9);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.right-item:active {
  background: #f3f4f6;
  transform: translateX(3rpx);
  border-color: #e5e7eb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.right-item:active::before {
  opacity: 1;
}

.item-icon-box {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #e6f2ff 0%, #cce5ff 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 116, 254, 0.12);
}

.item-icon-img {
  width: 26rpx;
  height: 26rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 4rpx;
  line-height: 1.3;
}

.item-detail {
  font-size: 20rpx;
  color: #6b7280;
  line-height: 28rpx;
}

/* 底部操作区 */
.bottom-section {
  padding: 0 32rpx 32rpx;
}

.countdown-info {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}

.countdown-label {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
}

.action-button {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #0074FE 0%, #0052d9 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 116, 254, 0.3);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.action-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s ease;
}

.action-button:active::before {
  left: 100%;
}

.button-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-right: 12rpx;
  position: relative;
  z-index: 1;
}

.action-button t-icon {
  position: relative;
  z-index: 1;
  transition: transform 0.3s ease;
}

.action-button:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 116, 254, 0.25);
}

.action-button:active t-icon {
  transform: translateX(4rpx);
}


