.container {
  border-radius: 32rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.15);
}

.main-content {
  padding: 48rpx 40rpx 32rpx;
}

.top-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.badge {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.main-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}

.sub-title {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 400;
  text-align: center;
  line-height: 40rpx;
}

.rights-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.rights-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 20rpx;
  background: linear-gradient(180deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 24rpx;
  border: 2rpx solid #fbbf24;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(251, 191, 36, 0.2);
}

.card-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.4);
}

.icon-img {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
}

.card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #92400e;
  margin-bottom: 6rpx;
  text-align: center;
}

.card-desc {
  font-size: 20rpx;
  color: #b45309;
  text-align: center;
  line-height: 30rpx;
}

.countdown-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #fef3c7;
  border-radius: 20rpx;
  border: 2rpx dashed #fbbf24;
}

.countdown-item {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.countdown-number {
  font-size: 56rpx;
  font-weight: 800;
  color: #d97706;
  line-height: 1;
}

.countdown-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #d97706;
  margin-left: 8rpx;
}

.countdown-tip {
  font-size: 22rpx;
  color: #92400e;
  font-weight: 500;
}

.bottom-section {
  padding: 0 40rpx 40rpx;
}

.btn-renew {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.4);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.btn-renew::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 60%);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  50% {
    transform: scale(1);
    opacity: 0;
  }
}

.btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  margin-right: 12rpx;
}

.btn-arrow {
  transition: transform 0.3s ease;
}

.btn-renew:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.btn-renew:active .btn-arrow {
  transform: translateX(8rpx);
}
