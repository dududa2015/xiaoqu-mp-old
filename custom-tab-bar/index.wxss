:host {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  pointer-events: none;
  background-color: rgba(0, 0, 0, 0);
}

.tab-bar.is-hidden {
  display: none;
}

.tab-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  display: flex;
  justify-content: center;
  padding-bottom: 10px;
  background-color: rgba(0, 0, 0, 0);
}

.pill {
  pointer-events: auto;
  position: relative;
  width: 360rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #ffffff;
  opacity: 0.95;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
}

.indicator {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  width: 168rpx;
  border-radius: 48rpx;
  background: #e5e5ea;
  z-index: 1;
}

.indicator.at-0 {
  transform: translateX(0);
}

.indicator.at-1 {
  transform: translateX(176rpx);
}

.indicator.animate {
  transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
}

.row {
  position: relative;
  z-index: 2;
  width: 360rpx;
  height: 112rpx;
  display: flex;
  flex-direction: row;
}

.item {
  width: 180rpx;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.item.pressed {
  opacity: 0.72;
}

.icon {
  width: 44rpx;
  height: 44rpx;
}

.label {
  margin-top: 2rpx;
  font-size: 16rpx;
  line-height: 1.1;
  font-weight: 500;
  color: #8e8e93;
}

.item.on .label {
  color: #0074FE;
  font-weight: 600;
}
