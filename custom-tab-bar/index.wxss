:host {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  pointer-events: none;
  background-color: rgba(0, 0, 0, 0);
}

.tab-bar.is-hidden {
  display: none;
}

.tab-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  display: flex;
  justify-content: center;
  padding-bottom: 10px;
  background-color: rgba(0, 0, 0, 0);
}

.pill {
  pointer-events: auto;
  position: relative;
  width: 350rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: 166rpx;
  border-radius: 48rpx;
  background: rgba(0, 116, 254, 0.1);
  z-index: 1;
}

.indicator.at-0 {
  transform: translateX(0);
}

.indicator.at-1 {
  transform: translateX(172rpx);
}

.indicator.animate {
  transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
}

.row {
  position: relative;
  z-index: 2;
  width: 350rpx;
  height: 108rpx;
  display: flex;
  flex-direction: row;
}

.item {
  width: 175rpx;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.item.pressed {
  opacity: 0.72;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.label {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 500;
  color: #8e8e93;
}

.item.on .label {
  color: #0074FE;
  font-weight: 600;
}
