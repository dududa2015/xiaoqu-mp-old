.container {
    padding: 32rpx;
  }
  
  .content {
    margin-top: 32rpx;
    border-radius: 16rpx;
    overflow: hidden;
    text-align: center;
  }
  
  .img {
    margin-top: 100rpx;
    width: 400rpx;
    height: 400rpx;
  }
  
  .empty-text {
    font-size: 24rpx;
    color: #969799;
  }
  
  .btn-wrapper {
    height: 100%;
  }
  
  .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 120rpx;
    height: 100%;
    color: white;
  }
  
  .delete-btn {
    background-color: #e34d59;
  }
  
  .edit-btn {
    background-color: #ed7b2f;
  }
  
  .favor-btn {
    background-color: var(--td-brand-color, #0052d9);
  }
  
  .column {
    flex-direction: column;
  }
  
  .padding-bottom {
    padding-bottom: 8rpx;
  }
  
  .t-search__input-box {
    background-color: #fff !important;
  }

  .footer {
    position: fixed;
    bottom: 0;
    left: 50%;    
    transform: translateX(-50%);
    width: 90%;
    padding-bottom: env(safe-area-inset-bottom);
  }