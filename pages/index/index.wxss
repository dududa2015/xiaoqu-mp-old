/* 横向布局 */
.horizontal-box {
  display: flex;
  align-items: center;
}

.horizontal-box .card {
  flex: 1;
  margin: 0;
}

.horizontal-box .card+.card {
  margin-left: 24rpx;
}

.t-radio--block {
  padding: 16rpx 16rpx 16rpx 32rpx !important;
}

.card {
  position: relative;
  margin: 32rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 3rpx solid #fff;
}

.card--active {
  border-color: #0074FE;
}

.card--active::after {
  content: '';
  display: block;
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  border: 14px solid #0074FE;
  border-bottom-color: transparent;
  border-right-color: transparent;
}

.card__icon {
  color: #fff;
  position: absolute;
  left: 1.5px;
  top: 1.5px;
  z-index: 1;
}

.input-wrap {
  margin: 32rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.tag-list {
  padding: 0;
}

.suggestions {
  margin-right: 2px;
  font-size: 12px;
  color: #999;
}

.marker-title {
  text-align: center;
  font-weight: 500;
  font-size: 32rpx;
  line-height: 96rpx;
}

.t-cell {
  padding: 24rpx !important;
}

.t-cell__title-text {
  font-size: 28rpx !important;
  line-height: 36rpx !important;
}

.t-cell__title,
.t-cell__note {
  flex: none !important;
}

.t-input {
  padding: 24rpx !important;
}

.t-input__label:not(:empty) {
  font-size: 28rpx !important;
  line-height: 36rpx !important;
}

.t-input__placeholder {
  font-size: 28rpx !important;
}

.form-button-wrap {
  margin-top: 32rpx;
  text-align: center;
}

.van-field__label {
  font-size: 28rpx;
  color: #222 !important;
  white-space: nowrap;
}

.type-wrap {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  line-height: 20px;
  font-size: 14px;
  word-break: break-all;
}

.marker-type {
  font-size: 28rpx;
  position: relative;
  padding-left: 24rpx;
  padding-right: 24rpx;
  color: rgba(34, 34, 34, 0.5);
}

.marker-type:last-child {
  margin-right: 0;
}

.marker-type::before {
  position: absolute;
  top: 50%;
  left: 0;
  margin-top: -5px;
  content: '';
  height: 24rpx;
  width: 1px;
  background: rgba(34, 34, 34, 0.1);
}

.marker-type:first-child::before {
  display: none;
}

.marker-type-active {
  color: #222;
  font-weight: 500;
}

.van-cell {
  padding: 12px 16px !important;
}

.footer {
