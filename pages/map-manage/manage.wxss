.page {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.status {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #888;
  font-size: 28rpx;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  width: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.group {
  width: 100%;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 48rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.group-title {
  padding: 24rpx 24rpx 0;
  font-size: 24rpx;
  color: #888;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(34, 34, 34, 0.08);
}

.row-last {
  border-bottom: none;
}

.label-wrap {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #222;
}

.hint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888;
}

.name-edit {
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(34, 34, 34, 0.08);
}

.name-edit-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.name-input {
  flex: 1;
  width: 0;
  height: 64rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #222;
  background: #f5f5f5;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.name-cancel,
.name-save {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
}

.name-cancel {
  color: #888;
}

.name-save {
  color: #3CB371;
}

.name-left {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
  text-align: right;
}

.tail {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.value {
  font-size: 26rpx;
  color: #888;
}

.tag {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.tag.is-owner {
  color: #3CB371;
  background: rgba(60, 179, 113, 0.12);
}

.tag.is-editor {
  color: #0074FE;
  background: rgba(0, 116, 254, 0.1);
}

.tag.is-viewer {
  color: #888;
  background: #f5f5f5;
}

.invite {
  padding: 16rpx 24rpx 8rpx;
}

.invite-actions {
  display: flex;
  flex-direction: row;
}

.share {
  flex: 1;
  width: 0;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 72rpx;
  color: #3CB371;
  background: #f5f5f5;
  border: none;
  border-radius: 999rpx;
}

.share-gap {
  margin-right: 16rpx;
}

.invite .hint {
  margin-top: 12rpx;
}

.empty {
  padding: 8rpx 24rpx 28rpx;
  font-size: 24rpx;
  color: #888;
}

.actions {
  padding: 8rpx 0 48rpx;
}

.danger {
  width: 100%;
  margin-bottom: 16rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  color: #e34d59;
  background: #fff;
  border-radius: 48rpx;
  box-sizing: border-box;
}
