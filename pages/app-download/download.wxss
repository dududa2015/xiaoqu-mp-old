.page {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
  padding-left: 80rpx;
  padding-right: 80rpx;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 32rpx 28rpx 40rpx;
  overflow: hidden;
}

.app-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.logo {
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 48rpx;
}

.app-info {
  flex: 1;
  min-width: 0;
}

.app-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.app-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.ios .app-meta-highlight {
  color: #e85827;
}

.android .app-meta-highlight {
  color: #0074fe;
}

.harmony .app-meta-highlight {
  color: #cf0a2c;
}

.section-title {
  display: block;
  margin-top: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.section-title-secondary {
  margin-top: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.6);
}

.search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 48rpx;
  background: #f5f5f5;
}

.link-row {
  align-items: flex-start;
}

.search-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.search-text {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #555555;
}

.link-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #555555;
}

.copy-row {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 48rpx;
}

.ios .copy-row {
  background: rgba(0, 122, 255, 0.08);
}

.android .copy-row {
  background: rgba(0, 116, 254, 0.08);
}

.harmony .copy-row {
  background: rgba(207, 10, 44, 0.08);
}

.copy-text {
  margin-left: 4rpx;
  font-size: 22rpx;
}

.ios .copy-text {
  color: #007aff;
}

.android .copy-text {
  color: #0074fe;
}

.harmony .copy-text {
  color: #cf0a2c;
}

.tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #999999;
}

.steps {
  margin-top: 12rpx;
}

.step-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 12rpx;
}

.step-index {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
}

.ios .step-index {
  background: #007aff;
}

.android .step-index {
  background: #0074fe;
}

.harmony .step-index {
  background: #cf0a2c;
}

.step-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: #666666;
}
