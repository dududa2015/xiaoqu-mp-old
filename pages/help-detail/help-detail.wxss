.page {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.article {
  padding: 32rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 50rpx;
  color: #111111;
}

.summary {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666666;
}

.h3 {
  display: block;
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}

.p,
.li,
.note {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #333333;
}

.note {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  color: #666666;
}

.group-label {
  display: block;
  margin: 24rpx 16rpx 12rpx;
  font-size: 24rpx;
  color: #888888;
}

.row {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
}

.line {
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.row-last .line {
  display: none;
}

.main {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.row-title {
  display: block;
  font-size: 28rpx;
  color: #222222;
}

.row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888888;
}

.empty {
  display: block;
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888888;
}
