.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  /* background: linear-gradient(135deg, #6a8cff 0%, #8b5cf6 45%, #ec4899 100%); */
  padding: 40rpx;
}

.liquid-glass-circle {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;

  /* 半透明玻璃底色 */
  background: rgba(255, 255, 255, 0.18);

  /* 背景模糊：部分环境可能不生效 */
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);

  /* 边框高光 */
  border: 1rpx solid rgba(255, 255, 255, 0.45);

  /* 内阴影模拟玻璃厚度 */
  box-shadow:
    inset 0 4rpx 20rpx rgba(255, 255, 255, 0.55),
    inset 0 -10rpx 30rpx rgba(0, 0, 0, 0.12),
    0 20rpx 60rpx rgba(17, 24, 39, 0.25);
}

/* 顶部高光层，增强玻璃反光感 */
.liquid-glass-circle::before {
  content: "";
  position: absolute;
  left: 10%;
  top: 6%;
  width: 60%;
  height: 35%;
  border-radius: 50%;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.75) 0%,
    rgba(255, 255, 255, 0.15) 60%,
    rgba(255, 255, 255, 0) 100%
  );
  opacity: 0.85;
}

/* 底部环境反光层 */
.liquid-glass-circle::after {
  content: "";
  position: absolute;
  left: 15%;
  bottom: 8%;
  width: 70%;
  height: 30%;
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 100%,
    rgba(255, 255, 255, 0.35),
    rgba(255, 255, 255, 0) 70%
  );
}

.circle-content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.25);
}