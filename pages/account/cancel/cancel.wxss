.container {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.list {
  margin-top: 16rpx;
}

.list-item {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.tip {
  margin-top: 24rpx;
  color: #999;
  font-size: 24rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 0 8rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checkbox.is-checked {
  background: #e34d59;
  border-color: #e34d59;
  position: relative;
}

.checkbox.is-checked::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 10rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.agree-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.actions {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.back-btn {
  border: 2rpx solid #e8f2ff !important;
}
