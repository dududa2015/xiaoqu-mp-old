<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="onBack">
      <t-icon name="chevron-left" size="48rpx" color="#111" />
    </view>
    <text class="nav-title">使用帮助</text>
  </view>
  <view class="search">
    <t-icon name="search" size="34rpx" color="#8E8E93" />
    <input class="search-input" placeholder="搜索使用帮助" value="{{query}}" bindinput="onSearch" />
  </view>
  <scroll-view class="chips" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="chip {{category === item.id ? 'is-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>
  <scroll-view class="body" scroll-y="{{true}}" show-scrollbar="{{false}}">
    <view class="content">
      <text class="empty" wx:if="{{emptyText}}">{{emptyText}}</text>
      <block wx:elif="{{showGrouped}}">
        <view class="block" wx:for="{{grouped}}" wx:key="id">
          <text class="group-label">{{item.label}}</text>
          <view class="group">
            <view
              wx:for="{{item.sections}}"
              wx:for-item="section"
              wx:for-index="sIndex"
              wx:key="id"
              class="row {{sIndex < item.sections.length - 1 ? '' : 'row-last'}}"
              data-id="{{section.id}}"
              bindtap="onOpen"
            >
              <view class="main">
                <text class="title">{{section.title}}</text>
                <text class="sub">{{section.summary}}</text>
              </view>
              <t-icon name="chevron-right" size="36rpx" color="#c7c7cc" />
            </view>
          </view>
        </view>
      </block>
      <view class="group" wx:else>
        <view
          wx:for="{{filtered}}"
          wx:key="id"
          class="row {{index < filtered.length - 1 ? '' : 'row-last'}}"
          data-id="{{item.id}}"
          bindtap="onOpen"
        >
          <view class="main">
            <text class="title">{{item.title}}</text>
            <text class="sub">{{item.summary}}</text>
          </view>
          <t-icon name="chevron-right" size="36rpx" color="#c7c7cc" />
        </view>
      </view>
    </view>
  </scroll-view>
</view>
