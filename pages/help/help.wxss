.page {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 24rpx;
  padding: 0 24rpx;
  height: 72rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #222222;
}

.chips {
  width: 100%;
  height: 88rpx;
  margin-top: 16rpx;
}

.chip-row {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
  white-space: nowrap;
}

.chip {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #666666;
}

.chip.is-on {
  background: #0074FE;
  color: #ffffff;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  padding: 8rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.group-label {
  display: block;
  margin: 16rpx 16rpx 12rpx;
  font-size: 24rpx;
  color: #888888;
}

.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.block {
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row-last {
  border-bottom-width: 0;
}

.main {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.title {
  display: block;
  font-size: 28rpx;
  color: #222222;
  font-weight: 400;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #888888;
}

.empty {
  display: block;
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888888;
}
