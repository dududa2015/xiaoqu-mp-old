page {
  background-color: #F2F2F7;
  min-height: 100vh;
}

.detail-page {
  padding: 16rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 32rpx 36rpx;
}

.detail-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: #1D2129;
}

.detail-summary {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #8E8E93;
}

.blocks {
  margin-top: 24rpx;
}

.h3 {
  display: block;
  margin: 32rpx 0 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: #1D2129;
}

.blocks .h3:first-child {
  margin-top: 0;
}

.p,
.li {
  display: block;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  color: #1D2129;
}

.note {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #FFF8E8;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  color: #92400E;
}

.table {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #F7F7F8;
  border-radius: 24rpx;
}

.table-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

.table-header {
  font-weight: 600;
  border-bottom: 1rpx solid #E5E5EA;
  margin-bottom: 8rpx;
}

.table-cell {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #1D2129;
  word-break: break-word;
}

.related {
  margin-top: 24rpx;
}

.group-label {
  display: block;
  margin: 0 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8E8E93;
}

.related-card {
  padding: 0;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
}

.row-divider {
  border-bottom: 1rpx solid #E5E5EA;
}

.row-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.row-title {
  display: block;
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1D2129;
}

.row-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8E8E93;
}

.service-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 28rpx 36rpx;
  background: #ffffff;
  border-radius: 48rpx;
}

.service-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(0, 116, 254, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.empty-text {
  display: block;
  padding: 8rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  color: #8E8E93;
}
