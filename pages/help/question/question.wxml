<view class="container">
  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="搜索问题..." 
        value="{{searchKeyword}}" 
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text class="search-icon">🔍</text>
    </view>
  </view>

  <!-- 分类导航 -->
  <view class="category-section">
    <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false">
      <view class="category-list">
        <view 
          class="category-item {{currentCategory === item.id ? 'active' : ''}}"
          wx:for="{{categories}}" 
          wx:key="id"
          data-category="{{item.id}}"
          bindtap="switchCategory"
        >
          <text class="category-icon">{{item.icon}}</text>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 一、注意事项 -->
  <view class="section">
    <view class="section-title">一、注意事项</view>
    <view class="warning-list">
      <view class="warning-item">所有添加、编辑的标记需经过审核流程，审核通过后才会在地图上显示，审核期间标记状态将显示为 "审核中"；</view>
      <view class="warning-item">标记删除后无法恢复，请在删除前确认是否需要保留相关信息。</view>
    </view>
  </view>

  <!-- 二、常见问题解答 -->
  <view class="section">
    <view class="section-title">二、常见问题解答</view>
    <view class="question-count" wx:if="{{filteredQuestions.length > 0}}">
      共找到 {{filteredQuestions.length}} 个问题（点击问题可展开答案）
    </view>
    <view class="no-result" wx:if="{{filteredQuestions.length === 0}}">
      <text class="no-result-icon">😕</text>
      <text class="no-result-text">未找到相关问题，请尝试其他关键词或分类</text>
    </view>

    <!-- 全部分组（未搜索时） -->
    <view wx:if="{{showGrouped}}">
      <view
        class="group-card"
        wx:for="{{groupedCategories}}"
        wx:key="id"
      >
        <view class="group-header" data-id="{{item.id}}" bindtap="toggleCategoryGroup">
          <view class="group-left">
            <text class="group-icon">{{item.icon}}</text>
            <text class="group-name">{{item.name}}</text>
            <text class="group-count">({{item.count}})</text>
          </view>
          <text class="group-arrow {{expandedCategoryMap[item.id] ? 'open' : ''}}">▾</text>
        </view>

        <view wx:if="{{expandedCategoryMap[item.id]}}">
          <view
            class="qa-item {{q.category === 'hot' ? 'qa-item-hot' : ''}} qa-item-collapsible"
            wx:for="{{item.questions}}"
            wx:key="id"
            wx:for-item="q"
          >
            <view class="qa-question qa-question-click" data-qid="{{q.id}}" bindtap="toggleQuestion">
              <text class="hot-tag" wx:if="{{q.category === 'hot'}}">热门</text>
              <text class="qa-question-text">{{q.question}}</text>
              <text class="qa-toggle {{expandedQuestionMap[q.id] ? 'open' : ''}}">▾</text>
            </view>
            <view class="qa-answer" wx:if="{{expandedQuestionMap[q.id]}}">
              <view class="answer-text" wx:if="{{q.answer}}">答：{{q.answer}}</view>
              <view class="solution-list" wx:if="{{q.solutions && q.solutions.length > 0}}">
                <view class="solution-item {{solution === '' ? 'solution-item-empty' : ''}}" wx:for="{{q.solutions}}" wx:key="index" wx:for-item="solution">
                  <text class="solution-number" wx:if="{{solution !== '' && solution.indexOf(')') > 0 && solution.indexOf(')') < 3}}">{{solution.split(')')[0]}})</text>
                  <text class="solution-text" wx:if="{{solution !== ''}}">{{solution.indexOf(')') > 0 && solution.indexOf(')') < 3 ? solution.split(')')[1] : solution}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 非分组模式（搜索/单分类） -->
    <view wx:else>
      <view
        class="qa-item {{item.category === 'hot' ? 'qa-item-hot' : ''}} qa-item-collapsible"
        wx:for="{{filteredQuestions}}"
        wx:key="id"
      >
        <view class="qa-question qa-question-click" data-qid="{{item.id}}" bindtap="toggleQuestion">
          <text class="hot-tag" wx:if="{{item.category === 'hot'}}">热门</text>
          <text class="qa-question-text">{{item.question}}</text>
          <text class="qa-toggle {{expandedQuestionMap[item.id] ? 'open' : ''}}">▾</text>
        </view>
        <view class="qa-answer" wx:if="{{expandedQuestionMap[item.id]}}">
          <view class="answer-text" wx:if="{{item.answer}}">答：{{item.answer}}</view>
          <view class="solution-list" wx:if="{{item.solutions && item.solutions.length > 0}}">
            <view class="solution-item {{solution === '' ? 'solution-item-empty' : ''}}" wx:for="{{item.solutions}}" wx:key="index" wx:for-item="solution">
              <text class="solution-number" wx:if="{{solution !== '' && solution.indexOf(')') > 0 && solution.indexOf(')') < 3}}">{{solution.split(')')[0]}})</text>
              <text class="solution-text" wx:if="{{solution !== ''}}">{{solution.indexOf(')') > 0 && solution.indexOf(')') < 3 ? solution.split(')')[1] : solution}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 三、反馈与支持 -->
  <view class="section">
    <view class="section-title">三、反馈与支持</view>
    <view class="content">若在使用过程中遇到问题、有功能建议或需要技术支持，请通过「客户服务」反馈，我们将及时为您处理。</view>
    <view class="footer-button" bindtap="onOpenService">
      <text class="footer-button-text">客户服务</text>
      <text class="footer-button-arrow">›</text>
    </view>
  </view>
</view>