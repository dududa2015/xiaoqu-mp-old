<view class="container">
  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="搜索问题..." 
        value="{{searchKeyword}}" 
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text class="search-icon">🔍</text>
    </view>
  </view>

  <!-- 分类导航 -->
  <view class="category-section">
    <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false">
      <view class="category-list">
        <view 
          class="category-item {{currentCategory === item.id ? 'active' : ''}}"
          wx:for="{{categories}}" 
          wx:key="id"
          data-category="{{item.id}}"
          bindtap="switchCategory"
        >
          <text class="category-icon">{{item.icon}}</text>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 一、注意事项 -->
  <view class="section">
    <view class="section-title">一、注意事项</view>
    <view class="warning-list">
      <view class="warning-item">所有添加、编辑的标记需经过审核流程，审核通过后才会在地图上显示，审核期间标记状态将显示为 "审核中"；</view>
      <view class="warning-item">卫星地图、3D 楼块功能需网络支持，部分老旧设备可能无法正常显示；</view>
      <view class="warning-item">步行导航功能依赖定位服务，请确保小程序已获取手机定位权限，且定位开关已开启；</view>
      <view class="warning-item">APP提供 7 天免费试用期，试用期结束后需订阅方可继续使用全部功能；</view>
      <view class="warning-item">标记删除后无法恢复，请在删除前确认是否需要保留相关信息。</view>
    </view>
  </view>

  <!-- 二、常见问题解答 -->
  <view class="section">
    <view class="section-title">二、常见问题解答</view>
    <view class="question-count" wx:if="{{filteredQuestions.length > 0}}">
      共找到 {{filteredQuestions.length}} 个问题
    </view>
    <view class="no-result" wx:if="{{filteredQuestions.length === 0}}">
      <text class="no-result-icon">😕</text>
      <text class="no-result-text">未找到相关问题，请尝试其他关键词或分类</text>
    </view>

    <view 
      class="qa-item {{item.category === 'hot' ? 'qa-item-hot' : ''}}"
      wx:for="{{filteredQuestions}}" 
      wx:key="id"
    >
      <view class="qa-question">
        <text class="hot-tag" wx:if="{{item.category === 'hot'}}">热门</text>
        <text>{{item.question}}</text>
      </view>
      <view class="qa-answer">
        <view class="answer-text" wx:if="{{item.answer}}">答：{{item.answer}}</view>
        <view class="solution-list" wx:if="{{item.solutions && item.solutions.length > 0}}">
          <view class="solution-item {{solution === '' ? 'solution-item-empty' : ''}}" wx:for="{{item.solutions}}" wx:key="index" wx:for-item="solution">
            <text class="solution-number" wx:if="{{solution !== '' && solution.indexOf(')') > 0 && solution.indexOf(')') < 3}}">{{solution.split(')')[0]}})</text>
            <text class="solution-text" wx:if="{{solution !== ''}}">{{solution.indexOf(')') > 0 && solution.indexOf(')') < 3 ? solution.split(')')[1] : solution}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 三、反馈与支持 -->
  <view class="section">
    <view class="section-title">三、反馈与支持</view>
    <view class="content">若在使用过程中遇到问题、有功能建议或需要技术支持，请通过小程序或APP内 "客户服务" 入口反馈，我们将及时为您处理。</view>
  </view>
</view>