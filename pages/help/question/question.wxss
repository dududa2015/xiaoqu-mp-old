/* pages/help/question/question.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
  background-color: #ffffff;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #e8e8e8;
  line-height: 1.5;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 24rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #1890ff;
  line-height: 1.5;
}

.content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.warning-list {
  margin-left: 24rpx;
}

.warning-item {
  font-size: 28rpx;
  color: #ff6b00;
  line-height: 1.8;
  margin-bottom: 12rpx;
  padding-left: 32rpx;
  position: relative;
  text-align: justify;
}

.warning-item::before {
  content: "⚠";
  position: absolute;
  left: 0;
  font-size: 28rpx;
}

.qa-item {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border-left: 4rpx solid #1890ff;
}

.qa-question {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.qa-answer {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

.answer-text {
  margin-bottom: 16rpx;
}

.solution-list {
  margin: 16rpx 0;
  padding-left: 8rpx;
}

.solution-item {
  display: flex;
  margin-bottom: 12rpx;
  line-height: 1.8;
}

.solution-number {
  font-weight: 600;
  color: #1890ff;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.solution-text {
  flex: 1;
  color: #666666;
}

.footer-text {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
  text-align: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8e8e8;
}

