/* pages/help/question/question.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
  background-color: #ffffff;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #e8e8e8;
  line-height: 1.5;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.warning-list {
  margin-left: 24rpx;
}

.warning-item {
  font-size: 28rpx;
  color: #ff6b00;
  line-height: 1.8;
  margin-bottom: 12rpx;
  padding-left: 32rpx;
  position: relative;
  text-align: justify;
}

.warning-item::before {
  content: "⚠";
  position: absolute;
  left: 0;
  font-size: 28rpx;
}

.qa-item {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border-left: 4rpx solid #1890ff;
}

.qa-item-hot {
  background-color: #fff7e6;
  border-left: 4rpx solid #ff6b00;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 0, 0.15);
}

.qa-question {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.hot-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ff6b00 0%, #ff8c42 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 4rpx;
  margin-right: 12rpx;
  line-height: 1.2;
  box-shadow: 0 2rpx 4rpx rgba(255, 107, 0, 0.3);
}

.qa-answer {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

.answer-text {
  margin-bottom: 16rpx;
}

.solution-list {
  margin: 16rpx 0;
  padding-left: 8rpx;
}

.solution-item {
  display: flex;
  margin-bottom: 12rpx;
  line-height: 1.8;
}

.solution-item-empty {
  height: 12rpx;
  margin-bottom: 12rpx;
}

.solution-number {
  font-weight: 600;
  color: #1890ff;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.solution-text {
  flex: 1;
  color: #666666;
}

.footer-text {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
  text-align: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8e8e8;
}

/* 搜索框样式 */
.search-section {
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.search-box {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  background-color: transparent;
}

.search-icon {
  font-size: 32rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* 分类导航样式 */
.category-section {
  margin-bottom: 32rpx;
  padding: 0 4rpx;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}

.category-list {
  display: inline-flex;
  padding: 8rpx 0;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  min-width: 100rpx;
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.category-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
  line-height: 1;
}

.category-name {
  font-size: 24rpx;
  color: #666666;
  white-space: nowrap;
}

.category-item.active .category-name {
  color: #ffffff;
  font-weight: 600;
}

/* 问题计数 */
.question-count {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

/* 无结果提示 */
.no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.no-result-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  line-height: 1;
}

.no-result-text {
  font-size: 28rpx;
  color: #999999;
  line-height: 1.6;
}

