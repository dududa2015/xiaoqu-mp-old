<view class="help-page">
  <view class="search-bar">
    <t-icon name="search" size="34rpx" color="#8E8E93" />
    <input
      class="search-input"
      placeholder="搜索使用帮助"
      placeholder-class="search-placeholder"
      value="{{query}}"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <view class="search-clear" wx:if="{{query}}" bindtap="onClearSearch">
      <t-icon name="close-circle-filled" size="36rpx" color="#C7C7CC" />
    </view>
  </view>

  <scroll-view class="chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="chip-row">
      <view
        class="chip {{category === item.id ? 'chip-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{emptyText}}" class="empty-text">{{emptyText}}</view>

  <block wx:elif="{{showGrouped}}">
    <view class="group" wx:for="{{grouped}}" wx:key="id">
      <text class="group-label">{{item.label}}</text>
      <view class="card">
        <view
          class="row {{sIndex < item.sections.length - 1 ? 'row-divider' : ''}}"
          wx:for="{{item.sections}}"
          wx:for-item="section"
          wx:for-index="sIndex"
          wx:key="id"
          data-id="{{section.id}}"
          bindtap="onOpenDetail"
        >
          <view class="row-main">
            <text class="row-title">{{section.title}}</text>
            <text class="row-summary">{{section.summary}}</text>
          </view>
          <t-icon name="chevron-right" size="40rpx" color="#C7C7CC" />
        </view>
      </view>
    </view>
  </block>

  <view class="card" wx:else>
    <view
      class="row {{index < filtered.length - 1 ? 'row-divider' : ''}}"
      wx:for="{{filtered}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpenDetail"
    >
      <view class="row-main">
        <text class="row-cat" wx:if="{{query}}">{{item.categoryLabel}}</text>
        <text class="row-title">{{item.title}}</text>
        <text class="row-summary">{{item.summary}}</text>
      </view>
      <t-icon name="chevron-right" size="40rpx" color="#C7C7CC" />
    </view>
  </view>
</view>
