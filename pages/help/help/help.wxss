page {
  background-color: #F2F2F7;
  min-height: 100vh;
}

.help-page {
  padding: 16rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 56rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  height: 88rpx;
  font-size: 32rpx;
  color: #1D2129;
}

.search-placeholder {
  color: #8E8E93;
}

.search-clear {
  padding: 8rpx 0 8rpx 12rpx;
}

.chip-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 8rpx;
}

.chip {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #3C3C43;
  font-size: 28rpx;
  line-height: 40rpx;
}

.chip-active {
  background: #0074FE;
  color: #ffffff;
  font-weight: 500;
}

.empty-text {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  color: #8E8E93;
}

.group {
  margin-top: 24rpx;
}

.group-label {
  display: block;
  margin: 0 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8E8E93;
}

.card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.group .card {
  margin-top: 0;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
}

.row-divider {
  border-bottom: 1rpx solid #E5E5EA;
}

.row-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.row-cat {
  display: block;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  color: #8E8E93;
}

.row-title {
  display: block;
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1D2129;
}

.row-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8E8E93;
}

.service-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 28rpx 36rpx;
  background: #ffffff;
  border-radius: 48rpx;
}

.service-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(0, 116, 254, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
