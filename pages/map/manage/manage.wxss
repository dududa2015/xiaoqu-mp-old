.content {
  padding: 24rpx;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.page-body {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.page-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
}

.page-status-text {
  font-size: 28rpx;
  color: #808080;
}

.page-status-retry {
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  background: #F3F4F6;
  color: #0074FE;
  font-size: 26rpx;
}

.group {
  margin-bottom: 8rpx;
  border-radius: 48rpx;
  overflow: hidden;
}
