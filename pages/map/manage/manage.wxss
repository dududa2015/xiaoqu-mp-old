.edit-mode {
  background: #ffffff;
  padding: 32rpx;
}

.edit-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.edit-label {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.edit-content {
  width: 100%;
}

.edit-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.edit-btn {
  padding: 12rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666666;
}

.cancel-btn:active {
  background: #e8e8e8;
}

.save-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #ffffff;
}

.save-btn:active {
  opacity: 0.8;
}

.invite-sheet-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  margin: 0;
  padding: 0 32rpx;
  border: none;
  border-radius: 0;
  background: #fff;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 112rpx;
  color: rgba(0, 0, 0, 0.9);
}

.invite-sheet-item::after {
  border: none;
  content: '';
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1px;
  background-color: #e7e7e7;
  transform: scaleY(0.5);
}

.invite-sheet-item[disabled] {
  color: rgba(0, 0, 0, 0.26);
}

.member-main {
  display: flex;
  align-items: center;
}

.member-name {
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-tag {
  flex-shrink: 0;
}

.member-empty {
  padding: 8rpx 32rpx 28rpx;
  background: #fff;
  font-size: 24rpx;
  color: #9CA3AF;
}

.actions {
  flex-shrink: 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

.actions t-button {
  margin-bottom: 24rpx;
}
