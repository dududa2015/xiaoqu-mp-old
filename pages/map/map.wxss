.page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #f5f5f5;
}

.map {
  width: 100%;
  height: 100%;
}

.hud {
  position: absolute;
  top: calc(16rpx + env(safe-area-inset-top));
  left: 24rpx;
  right: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hud-tag {
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  background: #0074fe;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.hud-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
}

.locate-btn {
  position: absolute;
  right: 24rpx;
  bottom: calc(280rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.locate-icon {
  font-size: 28rpx;
  color: #0074fe;
  line-height: 1.2;
}

.locate-text {
  font-size: 20rpx;
  color: #333;
}
