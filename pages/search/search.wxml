<view class="cotainer">
    <!-- 自定义导航栏 -->
    <view class="custom-nav" style="height:{{navHeight}}px;padding-top:{{statusBarHeight}}px">
        <!-- 返回按钮 -->
        <view class="nav-back" bind:tap="navBack">
            <t-icon name="chevron-left" size="28px" />
        </view>
        <!-- 标题 -->
        <view class="nav-title">地图选点</view>
    </view>
    <map style="width: 100%;height:60vh" latitude="{{latitude}}" longitude="{{longitude}}" show-location=" true">
        <bottom-location position="{{position}}" bottom="{{bottom}}" bind:onLocation="getLocation"></bottom-location>
        <view class="search-wrap">
            <view class="search-bar">
                <image src="/images/controls/search.png" mode="" />
                <input type="text" placeholder="搜索地点" />
            </view>
        </view>
    </map>
    <view class="content">
        <view class="addr-list">
            <t-radio-group t-class="horizontal-box" value="{{index}}" bind:change="onChange1">
                <t-radio wx:for="{{10}}" wx:key="index" value="{{index}}" icon="line" placement="right" content="描述信息描述信息描述信息描述信息描述信息">
                <view slot="label" class="flex f-y-center">
                    <t-icon name="location" size="16px" />
                    <text style="margin-left: 4px;">坦洲恒大名都</text>
                </view>
                </t-radio>
            </t-radio-group>
            <button >确认选点</button>
        </view>
    </view>

</view>