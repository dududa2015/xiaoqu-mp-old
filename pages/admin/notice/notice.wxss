.container {
  margin: 32rpx 32rpx 0 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.textarea {
  height: 90px;
  margin-bottom: 16px;
  border-radius: 16rpx;
  overflow: hidden;
}

.textarea120 {
  height: 120px;
  margin-bottom: 16px;
  border-radius: 16rpx;
  overflow: hidden;
}

.input {
  margin-bottom: 16px;
  border-radius: 16rpx;
  overflow: hidden;
}

.btn-wrap {
  padding: 32rpx;
}

.content {
  margin-top: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.switch-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.switch-label {
  font-size: 28rpx;
  color: #333;
}