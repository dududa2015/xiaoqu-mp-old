.container {
  padding: 32rpx;
}

.statistics-wrap {
  background-color: #fff;
  /* height: 100rpx; */
  border-radius: 16rpx;
  overflow: hidden;
}

.statistics-item {
  padding: 32rpx;
  text-align: center;
}

.statistics-number {
  font-size: 44rpx;
  font-weight: 500;
}

.statistics-desc {
  font-size: 24rpx;
  font-weight: 400;
}

.content {
  border-radius: 16rpx;
  overflow: hidden;
  text-align: center;
}

.img {
  margin-top: 100rpx;
  width: 400rpx;
  height: 400rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #969799;
}

.btn-wrapper {
  height: 100%;
}

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 120rpx;
  height: 100%;
  color: white;
}

.delete-btn-1 {
  background-color: #e34d59;
}

.delete-btn-2 {
  background-color: #ed7b2f;
}

.favor-btn {
  background-color: var(--td-brand-color, #0052d9);
}

.column {
  flex-direction: column;
}

.padding-bottom {
  padding-bottom: 8rpx;
}

.t-cell-group {
  box-shadow: 0 1px 8px 0 rgba(0, 0, 0, .1);
}

.t-popup--bottom {
  padding: 0 !important;
}