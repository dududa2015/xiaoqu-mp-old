.container {
  padding: 24rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.content {
  border-radius: 16rpx;
  overflow: hidden;
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.audit-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.audit-card {
  background-color: #fff;
  padding: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.name-section {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex-shrink: 0;
}

.type-tag {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  color: #1976d2;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.building-tag {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  color: #7b1fa2;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.feedback-badge {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  color: #e65100;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.card-content {
  padding-top: 16rpx;
  border-top: 1rpx dashed #e8e8e8;
}

.info-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-icon {
  font-size: 28rpx;
}

.info-text {
  font-size: 26rpx;
  color: #5a5a5a;
}

.remark {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.btn-wrapper {
  height: 100%;
}

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 140rpx;
  height: 100%;
  color: white;
  font-size: 28rpx;
  font-weight: 500;
}

.recover-btn {
  background: linear-gradient(135deg, #43a047 0%, #2e7d32 100%);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.img {
  width: 320rpx;
  height: 320rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b0b0;
  margin-top: 32rpx;
}

.t-popup--bottom {
  padding: 0 !important;
}
