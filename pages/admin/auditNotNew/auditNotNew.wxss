.container {
  padding: 24rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.content {
  border-radius: 16rpx;
  overflow: hidden;
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.audit-item {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.audit-card {
  background-color: #fff;
  padding: 28rpx 24rpx;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.name-section {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.type-tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #d0e8fc 100%);
  color: #1976d2;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.feedback-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.feedback-tag.feedback-type {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  color: #e65100;
}

.card-middle {
  padding-top: 16rpx;
  border-top: 1px solid #f0f0f0;
}

.remark {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.user-info {
  font-size: 24rpx;
  color: #999;
}

.btn-wrapper {
  height: 100%;
}

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 140rpx;
  height: 100%;
  color: white;
  font-size: 28rpx;
}

.recover-btn {
  background: linear-gradient(180deg, #00c853 0%, #009624 100%);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.img {
  width: 320rpx;
  height: 320rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 32rpx;
}

.t-popup--bottom {
  padding: 0 !important;
}
