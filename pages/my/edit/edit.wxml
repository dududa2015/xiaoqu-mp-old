<view class="container">
  <!-- 昵称编辑 -->
  <view class="info-card">
    <!-- 显示模式 -->
    <view class="info-item" wx:if="{{!isEditing}}" bind:tap="startEditNickName">
      <view class="item-label">
        <text class="label-text">昵称</text>
        <text class="label-required">*</text>
      </view>
      <view class="item-content">
        <text class="item-value" wx:if="{{nickName}}">{{nickName}}</text>
        <text class="item-placeholder" wx:else>请输入昵称</text>
        <view class="item-arrow">›</view>
      </view>
    </view>
    
    <!-- 编辑模式 -->
    <view class="info-item edit-mode" wx:else>
      <view class="item-label">
        <text class="label-text">昵称</text>
        <text class="label-required">*</text>
      </view>
      <view class="edit-content">
        <input 
          class="edit-input" 
          value="{{editingName}}" 
          maxlength="10" 
          placeholder="请输入昵称"
          focus="{{focusInput}}"
          bindinput="onNickNameInput"
          bindconfirm="saveNickName"
        />
        <view class="edit-actions">
          <view class="edit-btn cancel-btn" bind:tap="cancelEdit">取消</view>
          <view class="edit-btn save-btn" bind:tap="saveNickName">保存</view>
        </view>
      </view>
    </view>
  </view>

  <!-- #if NATIVE -->
  <!-- 按钮区域 -->
  <view class="button-section">
    <!-- 切换账号 -->
    <view class="switch-btn" bind:tap="toLogin">
      <text class="switch-text">切换账号</text>
    </view>

    <!-- 注销账号 -->
    <view class="logout-btn" bind:tap="onLogout">
      <text class="logout-text">注销账号</text>
    </view>
  </view>
  <!-- #endif -->

</view>