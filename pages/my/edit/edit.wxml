<view class="container">
  <!-- 昵称编辑 -->
  <t-cell-group style="border-radius: 24rpx; overflow: hidden;">
    <!-- 显示模式 -->
    <t-cell 
      wx:if="{{!isEditing}}" 
      title="昵称" 
      note="{{nickName || '请输入昵称'}}" 
      bordered="{{false}}"
      hover 
      arrow 
      bind:tap="startEditNickName"
    />
    
    <!-- 编辑模式 -->
    <view class="edit-mode" wx:else>
      <view class="edit-header">
        <text class="edit-label">昵称</text>
        <text class="edit-required">*</text>
      </view>
      <view class="edit-content">
        <input 
          class="edit-input" 
          value="{{editingName}}" 
          maxlength="10" 
          placeholder="请输入昵称"
          focus="{{focusInput}}"
          bindinput="onNickNameInput"
          bindconfirm="saveNickName"
        />
        <view class="edit-actions">
          <view class="edit-btn cancel-btn" bind:tap="cancelEdit">取消</view>
          <view class="edit-btn save-btn" bind:tap="saveNickName">保存</view>
        </view>
      </view>
    </view>
  </t-cell-group>

  <!-- #if NATIVE -->
  <!-- 底部按钮区域 -->
  <view class="button-section">
    <!-- 切换账号 -->
    <view class="switch-btn" bind:tap="toLogin">
      <text class="switch-text">切换账号</text>
    </view>

    <!-- 注销账号 -->
    <view class="logout-btn" bind:tap="onLogout">
      <text class="logout-text">注销账号</text>
    </view>
  </view>
  <!-- #endif -->

</view>