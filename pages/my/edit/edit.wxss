page {
    background-color: #f5f5f5;
}

.container {
    padding: 24rpx;
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

/* 编辑模式 */
.edit-mode {
    background: #ffffff;
    padding: 32rpx;
    border-radius: 24rpx;
}

.edit-header {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
}

.edit-label {
    font-size: 32rpx;
    color: #1a1a1a;
    font-weight: 500;
    letter-spacing: 0.5rpx;
}

.edit-required {
    color: #ff4d4f;
    font-size: 28rpx;
    margin-left: 6rpx;
    font-weight: 500;
}

.edit-content {
    width: 100%;
}

.edit-input {
    width: 100%;
    height: 80rpx;
    padding: 0 24rpx;
    background: #f5f5f5;
    border-radius: 16rpx;
    font-size: 30rpx;
    color: #1a1a1a;
    box-sizing: border-box;
    margin-bottom: 24rpx;
}

.edit-input::placeholder {
    color: #bfbfbf;
}

.edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: 16rpx;
}

.edit-btn {
    padding: 12rpx 32rpx;
    border-radius: 16rpx;
    font-size: 28rpx;
    font-weight: 500;
    transition: all 0.2s;
}

.cancel-btn {
    background: #f5f5f5;
    color: #666666;
}

.cancel-btn:active {
    background: #e8e8e8;
}

.save-btn {
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    color: #ffffff;
    box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.25);
}

.save-btn:active {
    opacity: 0.8;
    transform: scale(0.98);
}

/* 按钮区域 */
.button-section {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    margin-top: auto;
    padding-top: 20rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* 切换账号按钮 - 主要按钮 */
.switch-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24rpx;
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.25);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.switch-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.switch-btn:active::before {
    width: 300%;
    height: 300%;
}

.switch-btn:active {
    transform: scale(0.97);
    box-shadow: 0 2rpx 12rpx rgba(24, 144, 255, 0.3);
}

.switch-text {
    font-size: 32rpx;
    color: #ffffff;
    font-weight: 600;
    letter-spacing: 0.5rpx;
    position: relative;
    z-index: 1;
}

/* 注销账号按钮 - 次要按钮 */
.logout-btn {
    width: 100%;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24rpx;
    background: #ffffff;
    border: 2rpx solid #e8e8e8;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.logout-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.logout-btn:active::before {
    width: 300%;
    height: 300%;
}

.logout-btn:active {
    transform: scale(0.98);
    background: #fafafa;
    border-color: #d9d9d9;
}

.logout-text {
    font-size: 30rpx;
    color: #666666;
    font-weight: 500;
    letter-spacing: 0.5rpx;
    position: relative;
    z-index: 1;
}

/* 对话框样式 */
.dialog-content {
    /* padding: 24rpx 0; */
}

.dialog-input {
    padding: 24rpx;
    text-align: left;
    border-radius: 16rpx;
    background-color: #f5f5f5 !important;
    box-sizing: border-box;
    margin-bottom: 16rpx;
    font-size: 30rpx;
}

.dialog-tip {
    font-size: 24rpx;
    color: #8c8c8c;
    text-align: left;
    padding-left: 8rpx;
}