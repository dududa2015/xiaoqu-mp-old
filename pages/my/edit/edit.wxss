page {
    background-color: #f5f7fa;
}

.container {
    padding: 32rpx;
    min-height: 100vh;
    box-sizing: border-box;
}

/* 信息卡片 */
.info-card {
    background: #ffffff;
    border-radius: 24rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
    margin-bottom: 32rpx;
}

/* 信息项 */
.info-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 36rpx 32rpx;
    transition: background-color 0.2s;
    position: relative;
}

.info-item::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1rpx;
    background: #f0f0f0;
    transform: scaleY(0.5);
}

.info-item:active {
    background-color: #fafafa;
}

/* 编辑模式 */
.info-item.edit-mode {
    flex-direction: column;
    align-items: flex-start;
    padding: 32rpx;
}

.edit-content {
    width: 100%;
    margin-top: 24rpx;
}

.edit-input {
    width: 100%;
    height: 80rpx;
    padding: 0 24rpx;
    background: #f5f7fa;
    border-radius: 16rpx;
    font-size: 30rpx;
    color: #1a1a1a;
    box-sizing: border-box;
    margin-bottom: 24rpx;
}

.edit-input::placeholder {
    color: #bfbfbf;
}

.edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: 16rpx;
}

.edit-btn {
    padding: 12rpx 32rpx;
    border-radius: 16rpx;
    font-size: 28rpx;
    font-weight: 500;
    transition: all 0.2s;
}

.cancel-btn {
    background: #f5f7fa;
    color: #666666;
}

.cancel-btn:active {
    background: #e8e8e8;
}

.save-btn {
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    color: #ffffff;
    box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.25);
}

.save-btn:active {
    opacity: 0.8;
    transform: scale(0.98);
}

.item-label {
    display: flex;
    align-items: center;
    min-width: 120rpx;
}

.label-text {
    font-size: 32rpx;
    color: #1a1a1a;
    font-weight: 500;
    letter-spacing: 0.5rpx;
}

.label-required {
    color: #ff4d4f;
    font-size: 28rpx;
    margin-left: 6rpx;
    font-weight: 500;
}

.item-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-left: 32rpx;
}

.item-value {
    font-size: 32rpx;
    color: #1a1a1a;
    font-weight: 400;
    margin-right: 20rpx;
    max-width: 400rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.item-placeholder {
    font-size: 32rpx;
    color: #bfbfbf;
    margin-right: 20rpx;
    font-weight: 400;
}

.item-arrow {
    font-size: 36rpx;
    color: #d9d9d9;
    font-weight: 300;
    line-height: 1;
    transition: transform 0.2s;
}

.info-item:active .item-arrow {
    transform: translateX(4rpx);
}

/* 按钮区域 */
.button-section {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    padding-bottom: env(safe-area-inset-bottom);
}

/* 切换账号按钮 - 主要按钮 */
.switch-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24rpx;
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.25);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.switch-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.switch-btn:active::before {
    width: 300%;
    height: 300%;
}

.switch-btn:active {
    transform: scale(0.97);
    box-shadow: 0 2rpx 12rpx rgba(24, 144, 255, 0.3);
}

.switch-text {
    font-size: 32rpx;
    color: #ffffff;
    font-weight: 600;
    letter-spacing: 0.5rpx;
    position: relative;
    z-index: 1;
}

/* 注销账号按钮 - 次要按钮 */
.logout-btn {
    width: 100%;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24rpx;
    background: #ffffff;
    border: 2rpx solid #f0f0f0;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.logout-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 77, 79, 0.08);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.logout-btn:active::before {
    width: 300%;
    height: 300%;
}

.logout-btn:active {
    transform: scale(0.98);
    background: #fafafa;
    border-color: #e8e8e8;
}

.logout-text {
    font-size: 30rpx;
    color: #ff7875;
    font-weight: 500;
    letter-spacing: 0.5rpx;
    position: relative;
    z-index: 1;
}

/* 对话框样式 */
.dialog-content {
    /* padding: 24rpx 0; */
}

.dialog-input {
    padding: 24rpx;
    text-align: left;
    border-radius: 16rpx;
    background-color: #f5f7fa !important;
    box-sizing: border-box;
    margin-bottom: 16rpx;
    font-size: 30rpx;
}

.dialog-tip {
    font-size: 24rpx;
    color: #8c8c8c;
    text-align: left;
    padding-left: 8rpx;
}