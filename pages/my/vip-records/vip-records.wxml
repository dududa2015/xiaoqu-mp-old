<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-content">
    <view wx:if="{{loading}}" class="loading-wrap">
      <t-loading theme="circular" size="40rpx" text="加载中..." />
    </view>

    <block wx:elif="{{!records.length}}">
      <view class="card empty-card">
        <text class="card-title">付款记录</text>
        <text class="empty-desc">暂无小程序会员付款记录</text>
      </view>
    </block>

    <block wx:else>
      <view class="card list-card">
        <text class="card-title list-title">共 {{records.length}} 条</text>
        <view
          class="record-item {{index < records.length - 1 ? 'record-item-divider' : ''}}"
          wx:for="{{records}}"
          wx:key="outTradeNo"
        >
          <view class="record-main">
            <view class="record-name-row">
              <text class="record-name">{{item.name}}{{item.unit ? ' · ' + item.unit : ''}}</text>
              <view class="record-badge {{item.isRefunded ? 'record-badge-refunded' : ''}}">{{item.statusText}}</view>
            </view>
            <text class="record-note" wx:if="{{item.timeText}}">开通时间：{{item.timeText}}</text>
            <text class="record-note record-note-muted">单号：{{item.outTradeNo}}</text>
          </view>
          <text class="record-amount">¥{{item.priceText}}</text>
        </view>
      </view>
    </block>
  </view>
</scroll-view>
