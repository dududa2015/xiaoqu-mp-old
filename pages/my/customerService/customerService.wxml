<view class="customer-service-container">
  <!-- 在线客服入口 -->
  <view class="contact-section">
    <button 
      class="contact-button"
      openType="contact"
    >
      <view class="contact-card">
        <view class="card-header">
          <view class="header-icon-wrapper">
            <text class="header-icon">💬</text>
          </view>
          <view class="header-text">
            <text class="main-title">联系在线客服</text>
            <text class="sub-title">工作日 9:00-18:00 在线服务</text>
          </view>
        </view>
        <view class="card-footer">
          <text class="footer-text">我们会尽快回复您</text>
          <view class="arrow-wrapper">
            <text class="arrow-text">›</text>
          </view>
        </view>
      </view>
    </button>
  </view>

  <!-- 服务说明 -->
  <view class="info-section">
    <view class="info-card">
      <view class="info-title">💡 温馨提示</view>
      <view class="info-list">
        <view class="info-item">• 客服工作时间为工作日 9:00-18:00</view>
        <view class="info-item">• 非工作时间请留言，我们会尽快回复</view>
        <view class="info-item">• 如需查看常见问题，请前往个人中心</view>
      </view>
    </view>
  </view>
</view>