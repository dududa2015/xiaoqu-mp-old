<view class="customer-service-container">
  <!-- 主要客服入口 -->
  <view class="main-contact-section">
    <button 
      class="main-contact-button"
      openType="contact"
    >
      <view class="main-contact-card">
        <view class="main-card-content">
          <view class="main-text-wrapper">
            <text class="main-title">在线客服</text>
            <text class="main-subtitle">工作日 9:00-18:00 在线服务</text>
          </view>
          <view class="main-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
        <view class="main-card-footer">
          <text class="footer-hint">点击联系客服，我们会尽快回复您</text>
        </view>
      </view>
    </button>
  </view>

  <!-- 快捷服务入口 -->
  <view class="quick-service-section">
    <view class="section-title">快捷服务</view>
    <view class="quick-service-grid">
      <view class="service-item" bindtap="handleServiceClick" data-type="help">
        <view class="service-icon-wrapper service-icon-help">
          <image src="/images/my/help.png" class="service-icon" mode="aspectFit" />
        </view>
        <text class="service-label">使用帮助</text>
      </view>
      <view class="service-item" bindtap="handleServiceClick" data-type="faq">
        <view class="service-icon-wrapper service-icon-help">
          <image src="/images/my/question.png" class="service-icon" mode="aspectFit" />
        </view>
        <text class="service-label">常见问题</text>
      </view>
    </view>
  </view>

  <!-- 服务说明卡片 -->
  <view class="info-section">
    <view class="info-card">
      <view class="info-header">
        <view class="info-icon-wrapper">
          <text class="info-icon">💡</text>
        </view>
        <text class="info-title">温馨提示</text>
      </view>
      <view class="info-content">
        <view class="info-item">
          <view class="info-dot"></view>
          <text class="info-text">客服工作时间为工作日 9:00-18:00</text>
        </view>
        <view class="info-item">
          <view class="info-dot"></view>
          <text class="info-text">非工作时间请留言，并详细描述问题，我们会尽快回复</text>
        </view>
        <view class="info-item">
          <view class="info-dot"></view>
          <text class="info-text">如需查看常见问题，请前往个人中心</text>
        </view>
      </view>
    </view>
  </view>
</view>