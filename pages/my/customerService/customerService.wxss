page {
  background-color: #F2F2F7;
  min-height: 100vh;
}

.page {
  padding: 16rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.contact-btn {
  width: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  text-align: left;
}

.contact-btn::after {
  border: none;
}

.contact-card,
.card {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.contact-card {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
}

.contact-btn:active .contact-card,
.row:active {
  background-color: #F7F7F8;
}

.card {
  margin-top: 24rpx;
}

.card.pad {
  padding: 32rpx 36rpx;
}

.group-label {
  display: block;
  margin: 32rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8E8E93;
}

.card-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
}

.row-divider,
.link-row-divider {
  border-bottom: 1rpx solid #E5E5EA;
}

.contact-icon,
.row-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(0, 116, 254, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.row-title {
  display: block;
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1D2129;
}

.row-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8E8E93;
}

.row-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #C7C7CC;
  line-height: 1;
}

.bullet {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.bullet:last-child {
  margin-bottom: 0;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #0074FE;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #4E5969;
}

.note {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #FFF8E8;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #92400E;
}

.link-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.link-row:first-of-type {
  padding-top: 0;
}

.link-row:last-child {
  padding-bottom: 0;
}

.link-label {
  display: block;
  font-size: 26rpx;
  color: #4E5969;
  margin-bottom: 8rpx;
}

.link-url {
  display: block;
  font-size: 24rpx;
  color: #0074FE;
  line-height: 1.5;
  word-break: break-all;
}

.link-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8E8E93;
}

.copy-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 116, 254, 0.1);
  color: #0074FE;
  font-size: 24rpx;
  font-weight: 500;
}

.copy-btn:active {
  opacity: 0.7;
}
