page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.customer-service-container {
  padding: 24rpx;
  padding-bottom: 40rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 在线客服入口 */
.contact-section {
  width: 100%;
  margin-bottom: 32rpx;
  margin-top: 24rpx;
}

.contact-button {
  width: 100%;
  padding: 0;
  border: none;
  background-color: transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.contact-button::after {
  border: none;
}

.contact-button:active {
  transform: translateY(-2rpx);
}

.contact-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  border-left: 4rpx solid #1890ff;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.contact-button:active .contact-card {
  box-shadow: 0 6rpx 20rpx 0 rgba(0, 0, 0, 0.12);
  border-left-color: #096dd9;
}

.card-header {
  padding: 32rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.header-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.25);
}

.header-icon {
  font-size: 44rpx;
  line-height: 1;
  display: block;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
}

.main-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}

.sub-title {
  display: block;
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 0.5rpx;
  line-height: 1.5;
  font-weight: 400;
}

.card-footer {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fafafa;
}

.footer-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  display: block;
  flex: 1;
}

.arrow-wrapper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.arrow-text {
  font-size: 36rpx;
  color: #1890ff;
  font-weight: 300;
  line-height: 1;
}

/* 服务说明 */
.info-section {
  width: 100%;
}

.info-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  padding-left: 8rpx;
}
