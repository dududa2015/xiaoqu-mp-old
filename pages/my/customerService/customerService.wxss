page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.customer-service-container {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

/* 主要客服入口 */
.main-contact-section {
  width: 100%;
  margin-bottom: 32rpx;
  margin-top: 24rpx;
}

.main-contact-button {
  width: 100%;
  padding: 0;
  border: none;
  background-color: transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.main-contact-button::after {
  border: none;
}

.main-contact-button:active {
  transform: scale(0.98);
}

.main-contact-card {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.main-contact-button:active .main-contact-card {
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.25);
  transform: translateY(2rpx);
}

.main-card-content {
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.main-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.main-icon {
  font-size: 52rpx;
  line-height: 1;
  display: block;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.main-text-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.main-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}

.main-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
  line-height: 1.5;
  font-weight: 400;
}

.main-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
}

.arrow-icon {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

.main-card-footer {
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.footer-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  display: block;
}

/* 快捷服务入口 */
.quick-service-section {
  width: 100%;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
}

.quick-service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 16rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.service-item:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.service-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.service-icon-faq {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
}

.service-icon-feedback {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
}

.service-icon-time {
  background: linear-gradient(135deg, #feca57 0%, #ff9ff3 100%);
}

.service-icon-help {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.service-icon {
  font-size: 40rpx;
  line-height: 1;
  display: block;
}

.service-label {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 服务说明卡片 */
.info-section {
  width: 100%;
  margin-bottom: 32rpx;
}

.info-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.info-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.info-icon-wrapper {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #ffd93d 0%, #ff6b6b 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.info-icon {
  font-size: 28rpx;
  line-height: 1;
  display: block;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.info-dot {
  width: 8rpx;
  height: 8rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

/* 联系方式 */
.contact-info-section {
  width: 100%;
}

.contact-info-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.contact-info-header {
  margin-bottom: 24rpx;
}

.contact-info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.contact-info-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contact-info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-info-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
}

.contact-info-value {
  font-size: 28rpx;
  color: #1890ff;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.contact-info-value:active {
  opacity: 0.7;
}
