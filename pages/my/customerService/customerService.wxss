page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.customer-service-container {
  padding: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9ff 0%, #f5f5f5 100%);
}

/* 头部区域 */
.header-section {
  padding: 80rpx 32rpx 60rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
}

/* 主要客服入口 */
.main-contact-section {
  padding: 40rpx 32rpx;
}

.contact-button {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.contact-button::after {
  border: none;
}

.contact-button:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

.contact-button-content {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.contact-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.contact-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.contact-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
}

/* 服务分类 */
.service-section {
  padding: 0 32rpx 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.service-list {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.service-item {
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s ease;
}

.service-item:last-child {
  border-bottom: none;
}

.service-item:active {
  background-color: #f8f9fa;
}

.service-item-content {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  gap: 24rpx;
}

.service-icon {
  font-size: 48rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.service-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
}

.service-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}

.service-arrow {
  font-size: 40rpx;
  color: #cccccc;
  font-weight: 300;
  flex-shrink: 0;
}

/* 底部提示 */
.footer-tip {
  padding: 40rpx 32rpx 60rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}