page {
    background-color: #fff;
}

.container {
    text-align: center;
    padding: 150px 32px 0;
}

.mobile {
    height: 44px;
    opacity: 1;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0px;
    line-height: 44px;
    color: rgba(0, 0, 0, 1);
}

.mobile-desc {
    margin-top: 8px;
    height: 18px;
    opacity: 1;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0px;
    line-height: 18px;
    color: rgba(150, 151, 153, 1);
}

.button-desc {
    margin-top: 150px;
    height: 18px;
    opacity: 1;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0px;
    line-height: 18px;
    color: rgba(150, 151, 153, 1);
}

.button {
    margin-top: 12px;
}

.others {
    margin-top: 80px;
    color: rgba(150, 151, 153, 1);
    font-size: 12px;
    line-height: 24px;
    font-weight: 400;
}

.line {
    width: 52px;
    height: 0.5px;
    mix-blend-mode: normal;
    display: flex;
    background: rgba(235, 237, 240, 1);
}

.others-text {
    margin: 0 16px;
}

.img {
    width: 32px;
    height: 32px;
    margin-right: 8px;
}

.others-img {
    margin-top: 8px;
}

.agree-wrap {
    width: calc(100% - 64px);
    position: absolute;
    bottom: 32px;
}

.agree {
    color: rgba(50, 50, 51, 1);
    font-size: 12px;
    line-height: 20px;
    font-weight: 400;
}

.agree-blue {
    color: rgba(22, 93, 255, 1);
}

.t-checkbox__icon--left {
    margin-right: 0 !important;
}