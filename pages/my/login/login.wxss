page {
    background-color: #fff;
}

.container {
    text-align: center;
    padding: 64rpx 32px 0;
}

.logo-wrap {
    text-align: left;
    display: flex;
    align-items: center;
}

.logo-img {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    overflow: hidden;
}

.logo-text {
    margin-left: 32rpx;
    font-size: 54rpx;
    font-weight: 500;
    letter-spacing: 0px;
    color: rgba(31, 35, 41, 1);
}

.logo-desc {
    text-align: left;
    font-size: 36rpx;
    font-weight: 500;
    letter-spacing: 1px;
    line-height: 50.4px;
    color: rgba(100, 106, 115, 1);
}

.mobile {
    height: 44px;
    opacity: 1;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0px;
    line-height: 44px;
    color: rgba(0, 0, 0, 1);
}

.mobile-desc {
    margin-top: 12px;
    height: 18px;
    opacity: 1;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0px;
    line-height: 18px;
    color: rgba(150, 151, 153, 1);
}

.button-desc {
    margin-top: 150px;
    height: 18px;
    opacity: 1;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0px;
    line-height: 18px;
    color: rgba(150, 151, 153, 1);
}

.button {
    margin-top: 500rpx;
}

.others {
    margin-top: 50rpx;
    color: rgba(150, 151, 153, 1);
    font-size: 12px;
    line-height: 24px;
    font-weight: 400;
}

.line {
    width: 52px;
    height: 0.5px;
    mix-blend-mode: normal;
    display: flex;
    background: rgba(235, 237, 240, 1);
}

.others-text {
    margin: 0 16px;
    font-size: 13px;
}

.img {
    width: 40px;
    height: 40px;
}

.img:not(:first-child) {
    margin-left: 12px;
}

.others-img {
    margin-top: 16px;
}

.agree-wrap {
    width: calc(100% - 64px);
    position: absolute;
    bottom: 32px;
}

.agree {
    margin-left: 8px;
    color: rgba(50, 50, 51, 1);
    font-size: 12px;
    /* line-height: 20px; */
    font-weight: 400;
}

.agree-blue {
    color: rgba(22, 93, 255, 1);
}

.t-checkbox__icon--left {
    margin-right: 0 !important;
}