<view class="container" style="margin-top:{{top}}px;">
  <user-info userInfo="{{userInfo}}" validCount="{{markerStats.validCount}}" pendingAuditCount="{{markerStats.pendingAuditCount}}" favoriteCount="{{markerStats.favoriteCount}}"></user-info>

  <view class="content">
    <t-cell-group style="margin-top: 24rpx;border-radius: 24rpx; overflow: hidden;">
      <t-cell title="使用帮助" hover arrow url="/pages/help/help/help">
        <image src="/images/my/help.png" class="left-icon" mode="" slot="left-icon" />
      </t-cell>
      <t-cell title="常见问题" hover arrow url="/pages/help/question/question">
        <image src="/images/my/question.png" class="left-icon" mode="" slot="left-icon" />
      </t-cell>
    </t-cell-group>
    <t-cell-group style="margin-top: 24rpx;border-radius: 24rpx; overflow: hidden;">
      <t-cell hover arrow url="/pages/my/app/ios/ios">
        <text slot="title" class="download-title-ios">苹果App下载</text>
        <t-icon name="logo-apple" size="40rpx" color="#007AFF" class="left-icon" slot="left-icon" />
      </t-cell>
      <t-cell hover arrow url="/pages/my/app/android/android">
        <text slot="title" class="download-title-android">安卓App下载</text>
        <t-icon name="logo-android" size="40rpx" color="#E85827" class="left-icon" slot="left-icon" />
      </t-cell>
      <t-cell hover arrow url="/pages/my/app/harmony/harmony">
        <text slot="title" class="download-title-harmony">鸿蒙App下载</text>
        <t-icon name="download" size="40rpx" color="#CF0A2C" class="left-icon" slot="left-icon" />
      </t-cell>
    </t-cell-group>
  </view>
</view>
