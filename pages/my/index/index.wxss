.container {
    margin: 24rpx;
}


.vip-wrap {
    padding: 0 32rpx;
    margin-top: 24rpx;
    background-image: url(https://c-ssl.duitang.com/uploads/blog/202408/30/q4Sz90N4HxGg8w4.png);
    background-size: cover;
    height: 124rpx;
    border-radius: 24rpx;
}

.vip-text {
    font-size: 34rpx;
    font-weight: 600;
    letter-spacing: 0rpx;
    height: 48rpx;
    line-height: 48rpx;
    color: rgba(255, 255, 255, 1);
}

.vip-desc {
    font-size: 24rpx;
    font-weight: 400;
    letter-spacing: 0rpx;
    height: 34rpx;
    line-height: 34rpx;
    color: rgba(255, 255, 255, 1);
}

.vip-upgrade {
    width: 125rpx;
    height: 51rpx;
    opacity: 1;
    border-radius: 27rpx;
    background: rgba(255, 255, 255, 1);
    font-size: 24rpx;
    font-weight: 600;
    letter-spacing: 0rpx;
    line-height: 34.75rpx;
    color: #7BB5FA;
    text-align: center;
    vertical-align: middle;
}

.content {
    border-radius: 32rpx;
    overflow: hidden;
}

.left-icon {
    margin-top: 2rpx;
    width: 40rpx;
    height: 40rpx;
}

.ad-wrap {
    margin-top: 32rpx;
    background-color: #fff;
    border-radius: 8px;
    overflow: hidden;
}

.feedback-btn {
    position: absolute;
    top: 0;
    opacity: 0;
    width: 100%;
    height: 50px;
}

.footer {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  color: rgba(22, 93, 255, 1);
}

.text-underline {
  /* 添加下划线 */
  text-decoration: underline; 
}

.margin8{
  margin-left: 8px;
}