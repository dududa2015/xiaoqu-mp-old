.container {
  margin: 24rpx;
}

.content {
  border-radius: 48rpx;
  overflow: hidden;
}

.left-icon {
  margin-top: 2rpx;
  width: 40rpx;
  height: 40rpx;
}

.download-title-ios {
  font-weight: 600;
  color: #007AFF;
}

.download-title-android {
  font-weight: 600;
  color: #E85827;
}

.download-title-harmony {
  font-weight: 600;
  color: #CF0A2C;
}

.ad-wrap {
  margin-top: 32rpx;
  background-color: #fff;
  border-radius: 8px;
  overflow: hidden;
}

.feedback-btn {
  position: absolute;
  top: 0;
  opacity: 0;
  width: 100%;
  height: 50px;
}

.footer {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  color: rgba(22, 93, 255, 1);
}

.text-underline {
  /* 添加下划线 */
  text-decoration: underline;
}

.margin8 {
  margin-left: 8px;
}