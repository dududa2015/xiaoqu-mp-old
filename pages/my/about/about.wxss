/* pages/my/about/about.wxss */

page {
  background-color: #f5f5f5;
  min-height: 100vh;
}
.left-icon {
  margin-top: 2rpx;
  width: 40rpx;
  height: 40rpx;
}
.about-container {
  padding: 32rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.app-logo {
  width: 100rpx;
  height: 100rpx;
}

.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.app-version {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 4rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
}

.intro-section {
  margin-bottom: 32rpx;
}

.intro-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

.features-section {
  margin-bottom: 32rpx;
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon-loc {
  background-color: #e6f7ff;
}

.feature-icon-facility {
  background-color: #fff7e6;
}

.feature-icon-nav {
  background-color: #f6ffed;
}

.feature-icon-share {
  background-color: #fff0f6;
}

.icon-text {
  font-size: 36rpx;
  line-height: 1;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.feature-desc {
  font-size: 24rpx;
  color: #888888;
}

.contact-section {
  margin-bottom: 32rpx;
}

.contact-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.contact-item:first-child {
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-label {
  font-size: 28rpx;
  color: #555555;
  flex-shrink: 0;
}

.contact-value {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.copy-btn {
  margin-left: auto;
  padding: 8rpx 24rpx;
  background-color: #1890ff;
  border-radius: 24rpx;
}

.copy-btn text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.footer-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.footer-links {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.footer-link {
  font-size: 26rpx;
  color: #1890ff;
}

.link-divider {
  font-size: 26rpx;
  color: #cccccc;
}

.copyright {
  font-size: 24rpx;
  color: #999999;
}
