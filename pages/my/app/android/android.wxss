.download-wrap {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f6f9ff 0%, #ffffff 40%, #f7f7f7 100%);
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.06);
}

.badge-row {
  display: flex;
  justify-content: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.badge-platform {
  background-color: rgba(24, 144, 255, 0.1);
  color: #1890ff;
}

.badge-safe {
  background-color: rgba(82, 196, 26, 0.08);
  color: #52c41a;
}

.badge-offline {
  background-color: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.app-row {
  margin-top: 12px;
  display: flex;
  align-items: center;
}

.logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
}

.app-info {
  flex: 1;
}

.app-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.app-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.app-meta-highlight {
  color: #E85827;
}

.section-title {
  margin-top: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.url-box {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background-color: #f7f7f7;
  border-radius: 12rpx;
}

.url-text {
  font-size: 22rpx;
  color: #555555;
  word-break: break-all;
}

.primary-btn {
  margin-top: 32rpx;
  width: 100%;
  background-color: #1890ff;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.primary-btn::after {
  border: none;
}

.primary-btn.disabled-btn {
  background-color: #d9d9d9;
  color: #999999;
  opacity: 0.6;
}

.offline-notice {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: #fff7e6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
}

.offline-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.offline-content {
  flex: 1;
}

.offline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #d46b08;
  margin-bottom: 8rpx;
}

.offline-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.offline-time {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 500;
  margin-top: 8rpx;
}

.offline-tip {
  color: #ff4d4f;
  font-weight: 500;
}

.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}

.bullet-list {
  margin-top: 16rpx;
}

.bullet-item {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.6;
}

.steps {
  margin-top: 12rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
}

.step-index {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 50%;
  background-color: #1890ff;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  margin-right: 12rpx;
}

.step-text {
  flex: 1;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
  text-align: left;
}

