.download-wrap {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f6f9ff 0%, #ffffff 40%, #f5f5f5 100%);
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.06);
}

.app-row {
  display: flex;
  align-items: center;
}

.logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
}

.app-info {
  flex: 1;
}

.app-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.app-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.app-meta-highlight {
  color: var(--td-brand-color, var(--td-primary-color-7, #0074FE));
}

.section-title {
  margin-top: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.section-title-secondary {
  margin-top: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.search-row {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-row {
  align-items: flex-start;
}

.search-chip {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.search-text {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #555555;
}

.link-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #555555;
  word-break: break-all;
  line-height: 1.5;
}

.copy-row {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background-color: rgba(0, 116, 254, 0.08);
  flex-shrink: 0;
}

.copy-text {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: #0074FE;
}

.tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}

.steps {
  margin-top: 12rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.step-item:first-child {
  margin-top: 0;
}

.step-index {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 50%;
  background-color: var(--td-brand-color, var(--td-primary-color-7, #0074FE));
  color: var(--td-text-color-anti, #ffffff);
  font-size: 20rpx;
  text-align: center;
  margin-right: 12rpx;
}

.step-text {
  flex: 1;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
  text-align: left;
}
