<view class="download-wrap">
  <view class="card">
    <!-- 顶部标签 -->
    <view class="badge-row">
      <view class="badge badge-platform">Android 官方版</view>
      <view class="badge badge-offline">已下线</view>
    </view>

    <!-- 下线提示 -->
    <view class="offline-notice">
      <view class="offline-icon">⚠️</view>
      <view class="offline-content">
        <view class="offline-title">应用已下线</view>
        <view class="offline-desc">由于应用宝平台政策，个人开发者上传的定位功能APP暂不收录，因此安卓App已从应用宝下线。给您带来的不便，我们深表歉意，感谢您的理解与支持。</view>
        <view class="offline-time">预计2026年4月份左右恢复下载，请耐心等待。</view>
      </view>
    </view>

    <!-- App 信息 -->
    <view class="app-row">
      <image src="/images/icon-83.5@2x.png" class="logo" mode="aspectFit" />
      <view class="app-info">
        <view class="app-name">小区楼号</view>
        <view class="app-meta">约 94 MB · 版本 2.0.0</view>
        <view class="app-meta app-meta-highlight">推荐使用微信登录</view>
      </view>
    </view>

    <!-- 下载方式 -->
    <view class="section-title">下载方式</view>
    <view class="url-box">
      <text class="url-text">{{downloadUrl}}</text>
    </view>
    <button class="primary-btn disabled-btn" disabled>应用已下线，暂不可下载</button>
    <view class="tip offline-tip">安卓App已在应用宝下线，预计明年4月份左右恢复下载。如有疑问，请联系客服。</view>


  </view>
</view>


