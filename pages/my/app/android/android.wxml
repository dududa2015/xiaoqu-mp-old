<view class="download-wrap">
  <view class="card">
    <!-- 顶部标签 -->
    <view class="badge-row">
      <view class="badge badge-platform">Android 官方版</view>
      <view class="badge badge-safe">应用宝可下载</view>
    </view>

    <!-- 上线提示 -->
    <view class="online-notice">
      <view class="online-icon">✓</view>
      <view class="online-content">
        <view class="online-title">应用已重新上线</view>
        <view class="online-desc">安卓 App 已恢复在腾讯应用宝上架。点击下方按钮复制官方下载链接，在手机浏览器中打开即可前往应用宝安装。</view>
      </view>
    </view>

    <!-- App 信息 -->
    <view class="app-row">
      <image src="/images/icon-83.5@2x.png" class="logo" mode="aspectFit" />
      <view class="app-info">
        <view class="app-name">小区楼号</view>
        <view class="app-meta">约 94 MB · 版本 2.0.0</view>
        <view class="app-meta app-meta-highlight">推荐使用微信登录</view>
      </view>
    </view>

    <!-- 下载方式 -->
    <view class="section-title">下载方式</view>
    <view class="url-box">
      <text class="url-text">{{downloadUrl}}</text>
    </view>
    <button class="primary-btn" bind:tap="onCopyLink">复制下载链接</button>
    <view class="tip">复制后请在浏览器中粘贴打开；也可在应用宝内搜索「小区楼号」。如有疑问，请联系客服。</view>


  </view>
</view>

