<view class="download-wrap">
  <view class="card">
    <!-- 顶部标签 -->
    <view class="badge-row">
      <view class="badge badge-platform">Android 官方版</view>
      <view class="badge badge-safe">应用宝安全下载</view>
    </view>

    <!-- App 信息 -->
    <view class="app-row">
      <image src="/images/icon-83.5@2x.png" class="logo" mode="aspectFit" />
      <view class="app-info">
        <view class="app-name">小区楼号</view>
        <view class="app-meta">约 94 MB · 版本 1.0.1</view>
        <view class="app-meta app-meta-highlight">推荐使用微信登录</view>
      </view>
    </view>

    <!-- 下载方式 -->
    <view class="section-title">下载方式（仅支持腾讯应用宝）</view>
    <view class="url-box">
      <text class="url-text">{{downloadUrl}}</text>
    </view>
    <button class="primary-btn" bindtap="onCopyLink">复制应用宝下载链接</button>
    <view class="tip">当前安卓 App 仅在腾讯应用宝上架，请勿从其他第三方市场或网页下载。</view>

    <!-- 下载步骤 -->
    <view class="section-title">下载步骤</view>
    <view class="steps">
      <view class="step-item">
        <text class="step-index">1</text>
        <text class="step-text">点击上方「复制应用宝下载链接」按钮</text>
      </view>
      <view class="step-item">
        <text class="step-index">2</text>
        <text class="step-text">在手机上打开腾讯应用宝或浏览器，在地址栏长按粘贴该链接并访问（如未安装应用宝，按页面提示先完成安装）</text>
      </view>
      <view class="step-item">
        <text class="step-index">3</text>
        <text class="step-text">跳转到「小区楼号」下载页后，按提示完成安装</text>
      </view>
    </view>

  </view>
</view>


