.download-wrap {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 48rpx;
  padding: 32rpx 28rpx 40rpx;
  /* box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.06); */
  overflow: hidden;
}

.app-row {
  display: flex;
  align-items: center;
}

.logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 48rpx;
  margin-right: 24rpx;
}

.app-info {
  flex: 1;
}

.app-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.app-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.app-meta-highlight {
  color: #e85827;
}

.section-title {
  margin-top: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.search-row {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background-color: #f5f5f5;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.search-chip {
  display: flex;
  align-items: center;
  flex: 1;
}

.search-text {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #555555;
}

.copy-row {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 48rpx;
  background-color: rgba(0, 122, 255, 0.08);
}

.copy-text {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: #007aff;
}

.tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

.steps {
  margin-top: 12rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
}

.step-index {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 50%;
  background-color: #007aff;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  margin-right: 12rpx;
}

.step-text {
  flex: 1;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
  text-align: left;
}

