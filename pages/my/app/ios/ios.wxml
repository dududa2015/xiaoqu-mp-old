<view class="download-wrap">
  <view class="card">
    <!-- App 信息 -->
    <view class="app-row">
      <image src="/images/icon-83.5@2x.png" class="logo" mode="aspectFit" />
      <view class="app-info">
        <view class="app-name">小区楼号地图</view>
        <view class="app-meta">约 72 MB · 需要 iOS 15.0 或更高版本</view>
        <view class="app-meta app-meta-highlight">推荐使用微信登录</view>
      </view>
    </view>

    <!-- 搜索方式 -->
    <view class="section-title">在 App Store 中搜索</view>
    <view class="search-row">
      <view class="search-chip">
        <t-icon name="search" size="32rpx" color="#007AFF" />
        <text class="search-text">小区楼号地图-快递外卖极速导航</text>
      </view>
      <view class="copy-row" bind:tap="onCopy">
        <t-icon name="copy" size="32rpx" color="#007AFF" />
        <text class="copy-text">复制名称</text>
      </view>
    </view>
    <view class="tip">点击复制后，在 App Store 搜索框长按粘贴上述名称即可。</view>

    <!-- 下载步骤 -->
    <view class="section-title">下载步骤</view>
    <view class="steps">
      <view class="step-item">
        <text class="step-index">1</text>
        <text class="step-text">在 iPhone 上打开「App Store」应用</text>
      </view>
      <view class="step-item">
        <text class="step-index">2</text>
        <text class="step-text">点击底部「搜索」标签，在搜索框长按粘贴已复制的应用名称</text>
      </view>
      <view class="step-item">
        <text class="step-index">3</text>
        <text class="step-text">在搜索结果中找到「小区楼号地图」，点击「获取」并按提示完成安装</text>
      </view>
    </view>
  </view>
</view>