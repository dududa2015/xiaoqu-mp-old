.page {
  min-height: 100vh;
  background: #f2f2f7;
}

.tab-bar {
  display: flex;
  margin: 24rpx 24rpx 0;
  padding: 8rpx;
  box-sizing: border-box;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 18rpx;
}

.tab-item {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  padding: 14rpx 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  border-radius: 14rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.tab-item-active {
  background: #ffffff;
  color: #111827;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.content {
  padding: 24rpx;
}

.marker-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.marker-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  background: #ffffff;
}

.marker-row + .marker-row {
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.marker-row-hover {
  background: #f9fafb;
}

.index-badge {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-top: 4rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  background: rgba(120, 120, 128, 0.12);
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 52rpx;
  text-align: center;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.row-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.45;
  word-break: break-all;
}

.row-title-deleted {
  color: #9ca3af;
  text-decoration: line-through;
}

.type-tag {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.row-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #808080;
  line-height: 1.5;
  word-break: break-all;
}

.empty {
  padding: 120rpx 48rpx 0;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: #374151;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.loading-wrap {
  padding: 120rpx 0 0;
  text-align: center;
}

.loading-text,
.footer-text {
  display: flex;
  justify-content: center;
  font-size: 24rpx;
  color: #969799;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}
