.vip-container {
    position: relative;
    width: 100%;
    height: 100vh;
    background-color: #fff;
}

.title-wrap {
    padding: 32rpx 0 0 0;
}

.line {
    width: 6rpx;
    height: 30rpx;
    opacity: 1;
    background: #0074FE;
}

.title {
    margin-left: 32rpx;
    font-size: 30rpx;
    font-weight: 600;
    letter-spacing: 0px;
    line-height: 40rpx;
    color: rgba(51, 51, 51, 1);
}

.rights-wrap {
    margin-top: 48rpx;
}

.rights {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
}

.rights-icon {
    width: 72rpx;
    height: 72rpx;
    line-height: 72rpx;
}
.rights-text{
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #333;
    height: 40rpx;
    line-height: 40rpx;
}