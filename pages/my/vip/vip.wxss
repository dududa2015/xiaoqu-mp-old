page {
  background-color: #F2F2F7;
  height: 100%;
}

.vip-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #F2F2F7;
}

.page-scroll {
  flex: 1;
  height: 0;
}

.page-content {
  padding: 32rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.card {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.products-card {
  padding-bottom: 16rpx;
}

.product-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.product-row-divider {
  border-bottom: 1rpx solid #E5E5EA;
}

.product-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.product-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
  line-height: 40rpx;
}

.product-badge {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(0, 116, 254, 0.14);
  color: #0074FE;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  flex-shrink: 0;
}

.product-note-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.product-original {
  font-size: 24rpx;
  line-height: 32rpx;
  color: #9CA3AF;
  text-decoration: line-through;
}

.product-note {
  font-size: 24rpx;
  line-height: 32rpx;
  color: #9CA3AF;
}

.product-price {
  flex-shrink: 0;
  padding-top: 2rpx;
  margin-right: 20rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #1D2129;
  font-variant-numeric: tabular-nums;
}

.plan-check {
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-check-empty {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #E5E5EA;
  box-sizing: border-box;
}

.benefits-card {
  padding: 28rpx 32rpx 24rpx;
}

.benefits-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.benefits-title {
  margin-bottom: 0;
}

.benefits-subtitle {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 36rpx;
}

.benefits-row {
  display: flex;
  gap: 20rpx;
}

.benefit-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  min-width: 0;
}

.benefit-name {
  font-size: 28rpx;
  color: #1D2129;
  line-height: 36rpx;
}

.legal-section {
  padding: 8rpx 8rpx 16rpx;
}

.legal-text {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.footer {
  background: #fff;
  padding: 28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.agree-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.agree-check {
  margin-top: 0;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #6B7280;
}

.agree-link {
  color: #0074FE;
}
