<view class="container">
  <view class="content">
    <t-input value="{{nickName}}" type="text" borderless maxlength="10" placeholder="请输入小程序的用户编号"  bind:change="onNickNameChange">
      <text slot="label">用户编号<text style="color: #e34d59"> *</text> </text>
    </t-input>
  </view>
  <view class="btn-wrap">
    <t-button theme="primary" size="large" block bind:tap="onSave">保存</t-button>
  </view>
</view>