<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="onBack">
      <t-icon name="chevron-left" size="48rpx" color="#111" />
    </view>
    <text class="nav-title">注销账号</text>
  </view>
  <scroll-view class="body" scroll-y="{{true}}" show-scrollbar="{{false}}">
    <view class="content">
      <view class="card">
        <text class="title">注销后将无法恢复</text>
        <text class="desc">确认注销后，我们将立即清除您的个人信息与登录绑定，包括但不限于：</text>
        <view class="list">
          <text class="list-item">• 昵称、手机号、微信/Apple 登录绑定</text>
          <text class="list-item">• 会员权益（如有）</text>
        </view>
        <text class="desc tip">您创建的地图标记、收藏、订单记录等业务数据将保留在系统中，但不再与您的身份关联。您仍可使用微信重新登录，但将注册为新账号。</text>
      </view>
      <view class="group">
        <view class="agree-row" bindtap="onToggle">
          <view class="checkbox {{agreed ? 'is-checked' : ''}}">
            <t-icon wx:if="{{agreed}}" name="check" size="24rpx" color="#ffffff" />
          </view>
          <text class="agree-text">我已阅读并知晓注销后果</text>
        </view>
      </view>
      <view class="actions">
        <view class="action">
          <t-button theme="default" size="large" shape="round" block bind:tap="onBack">再想想</t-button>
        </view>
        <view class="action">
          <t-button theme="danger" size="large" shape="round" block disabled="{{!agreed || submitting}}" bind:tap="onConfirm">确认注销</t-button>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
