.page {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card,
.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.card {
  padding: 32rpx;
}

.group {
  margin-top: 24rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1a1a1a;
}

.desc {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #666666;
}

.list {
  margin-top: 16rpx;
}

.list-item {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #666666;
}

.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999999;
}

.agree-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border: 2rpx solid #cccccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkbox.is-checked {
  background: #e34d59;
  border-color: #e34d59;
}

.agree-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #666666;
}

.actions {
  margin-top: 32rpx;
}

.action {
  display: block;
  width: 100%;
  margin-top: 24rpx;
}

.action:first-child {
  margin-top: 0;
}
