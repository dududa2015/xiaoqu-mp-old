.page {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.label {
  font-size: 28rpx;
  color: #222222;
}

.tail {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
  margin-left: 24rpx;
}

.value {
  font-size: 28rpx;
  color: #888888;
  margin-right: 8rpx;
}

.name-edit,
.edit-mode {
  padding: 32rpx;
}

.edit-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.edit-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.edit-required {
  margin-left: 6rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #ff4d4f;
}

.edit-input {
  width: 100%;
  height: 80rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f5f5f5;
  font-size: 30rpx;
  color: #1a1a1a;
}

.edit-placeholder {
  color: #bfbfbf;
}

.edit-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.edit-btn {
  margin-left: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666666;
}

.save-btn {
  background: #0074fe;
  color: #ffffff;
}
