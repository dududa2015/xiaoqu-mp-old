<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="onBack">
      <t-icon name="chevron-left" size="48rpx" color="#111" />
    </view>
    <text class="nav-title">编辑资料</text>
  </view>
  <scroll-view class="body" scroll-y="{{true}}" show-scrollbar="{{false}}">
    <view class="content">
      <view class="group" wx:if="{{!editing}}">
        <view class="row row-last" bindtap="onEdit">
          <text class="label">昵称</text>
          <view class="tail">
            <text class="value">{{nickName || '请输入昵称'}}</text>
            <t-icon name="chevron-right" size="36rpx" color="#c7c7cc" />
          </view>
        </view>
      </view>
      <view class="group" wx:else>
        <view class="edit-mode">
          <view class="edit-header">
            <text class="edit-label">昵称</text>
            <text class="edit-required">*</text>
          </view>
          <input
            class="edit-input"
            value="{{editingName}}"
            maxlength="10"
            placeholder="请输入昵称"
            placeholder-class="edit-placeholder"
            focus="{{focusInput}}"
            bindinput="onInput"
            bindconfirm="onSave"
          />
          <view class="edit-actions">
            <view class="edit-btn cancel-btn" catchtap="onCancel">取消</view>
            <view class="edit-btn save-btn" catchtap="onSave">保存</view>
          </view>
        </view>
      </view>
      <view class="group">
        <view class="row" bindtap="onCancelAccount">
          <text class="label">注销账号</text>
          <t-icon name="chevron-right" size="36rpx" color="#c7c7cc" />
        </view>
      </view>
    </view>
  </scroll-view>
</view>
