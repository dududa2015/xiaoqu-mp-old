.page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.segment {
  margin: 0 24rpx 8rpx;
  border-radius: 999rpx;
  overflow: hidden;
}

.segment .t-segmented,
.segment .t-segmented__thumb {
  border-radius: 999rpx !important;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row-last {
  border-bottom-width: 0;
}

.badge {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-top: 4rpx;
  border-radius: 16rpx;
  background: rgba(118, 118, 128, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(60, 60, 67, 0.6);
}

.main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.title-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: #111111;
}

.is-deleted {
  color: rgba(60, 60, 67, 0.6);
  text-decoration: line-through;
}

.tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 30rpx;
}

.sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #808080;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #222222;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #888888;
}

.hint {
  display: block;
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #888888;
}

.popup-sheet {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  pointer-events: none;
}
