.container {
  padding: 30rpx;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  line-height: 1.8;
  font-size: 28rpx;
  color: #333;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  color: #1a1a1a;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #1a1a1a;
}

.subsection {
  font-size: 30rpx;
  font-weight: bold;
  margin: 25rpx 0 15rpx 0;
  color: #333;
}

.text {
  font-size: 28rpx;
  color: #666;
  text-align: justify;
  margin-bottom: 20rpx;
  line-height: 1.7;
}

.bold {
  font-weight: bold;
  color: #333;
}

.list {
  margin-left: 20rpx;
  margin-bottom: 20rpx;
}

.list-item {
  margin-bottom: 15rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 链接样式 */
navigator {
  color: #0066cc;
  text-decoration: underline;
}