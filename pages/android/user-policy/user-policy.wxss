/* 模拟h2标题样式 */
.h2-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin: 30rpx 0 20rpx;
  line-height: 1.5;
}

/* 模拟h3标题样式 */
.h3-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin: 24rpx 0 12rpx;
  line-height: 1.4;
}

/* 正文段落样式 */
.paragraph {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

/* 一级缩进（对应原HTML的&nbsp;&nbsp;） */
.indent-1 {
  padding-left: 40rpx;
}

/* 链接样式（适配小程序navigator组件） */
.link {
  color: #2f80ed;
  text-decoration: underline;
}

/* 页面容器样式（可选，控制整体边距） */
.page-container {
  padding: 36rpx;
  background-color: #fff;
  min-height: 100vh;
}