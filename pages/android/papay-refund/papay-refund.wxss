page {
  background-color: #F2F2F7;
  height: 100vh;
}

.page-scroll {
  height: 100vh;
}

.page-content {
  padding: 32rpx;
  box-sizing: border-box;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.card {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.products-title {
  display: block;
  padding: 0;
  margin-bottom: 8rpx;
}

.order-info-card,
.reasons-card {
  padding-top: 32rpx;
  padding-bottom: 24rpx;
}

.plan-item-static {
  padding-bottom: 8rpx;
}

.plan-note-warn {
  color: #e37318;
}

.reason-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.reason-chip {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7280;
  background-color: #F2F2F7;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.reason-chip-active {
  color: #0074FE;
  background-color: #E8F3FF;
  border-color: #0074FE;
  font-weight: 500;
}

.summary-card {
  padding: 0;
  overflow: hidden;
}

.summary-header {
  padding: 32rpx 36rpx 0;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.summary-content {
  padding: 24rpx 36rpx 32rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.summary-label {
  font-size: 28rpx;
  color: #6B7280;
}

.summary-label-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.summary-label-sub {
  font-size: 24rpx;
  color: #9CA3AF;
}

.summary-label-sub.green {
  color: #16a34a;
}

.summary-value-strong {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.deduction-box {
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 8rpx 0 16rpx;
}

.summary-deduction {
  font-size: 28rpx;
  color: #e37318;
  font-weight: 500;
}

.deduction-note-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  position: relative;
}

.deduction-note {
  font-size: 24rpx;
  color: #9CA3AF;
}

.deduction-help {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #E5E5EA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.deduction-help-icon {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1;
}

.deduction-tooltip {
  position: absolute;
  left: 0;
  top: 40rpx;
  z-index: 2;
  background: rgba(29, 33, 41, 0.92);
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  max-width: 420rpx;
}

.summary-divider {
  height: 1rpx;
  background: #E5E5EA;
  margin: 8rpx 0 16rpx;
}

.total-label {
  color: #1D2129;
  font-weight: 500;
}

.summary-refund {
  font-size: 40rpx;
  font-weight: 600;
  color: #0074FE;
}

.empty-card {
  text-align: center;
  padding: 48rpx 36rpx;
}

.empty-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
}

.plan-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
}

.plan-item-divider {
  border-bottom: 1rpx solid #E5E5EA;
}

.plan-item-disabled {
  opacity: 0.55;
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.plan-badge {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background-color: #EFEFF4;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.plan-note {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.plan-price {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
  flex-shrink: 0;
}

.plan-check {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-empty {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #E5E5EA;
  box-sizing: border-box;
}

.radio-disabled {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #F2F2F7;
  background-color: #F2F2F7;
  box-sizing: border-box;
}

.textarea-card {
  padding-top: 24rpx;
  padding-bottom: 20rpx;
}

.papay-refund-textarea {
  padding: 0 !important;
  background: transparent !important;
}

.papay-refund-textarea-inner {
  width: 100% !important;
  min-height: 120rpx !important;
  height: 120rpx !important;
  padding: 16rpx 20rpx !important;
  font-size: 28rpx !important;
  line-height: 40rpx !important;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.legal-section {
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.legal-text {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.agree-checkbox {
  background: transparent !important;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #6B7280;
}

.agree-link {
  color: #0074FE;
}

.custom-reason-meta {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 8rpx;
}

.custom-reason-count {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 24rpx;
  color: #9CA3AF;
}

.error-text {
  flex: 1;
  font-size: 24rpx;
  color: #e34d59;
  line-height: 1.5;
}

.agree-error {
  margin: -16rpx 8rpx 24rpx;
}

.t-checkbox__icon--left {
  margin-right: 0 !important;
}
