<view class="vip-container">
    <view class="header">
        <view class="title-wrap flex  f-y-center">
            <view class="line"></view>
            <view class="title">会员权益<text class="title-2">(相比小程序)</text></view>
        </view>
        <view class="rights-wrap flex f-x-fs f-y-center">
            <view class="rights" wx:for="{{rightsList}}" wx:key="index">
                <view class="rights-img-wrap flex f-x-center f-y-center">
                    <text class="rights-icon">{{item.icon}}</text>
                </view>
                <view class="rights-text">{{item.name}}</view>
            </view>
        </view>
    </view>
    <view class="content ">
        <view class="title-wrap flex  f-y-center">
            <view class="line"></view>
            <view class="title">会员选择</view>
        </view>
        
        <!-- 加载状态 -->
        <view wx:if="{{loading && productList.length === 0}}" class="loading-wrapper">
            <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="index">
                <t-skeleton theme="paragraph" row="4" />
            </view>
        </view>
        
        <!-- 空状态 -->
        <view wx:elif="{{!loading && productList.length === 0}}" class="empty-state">
            <view class="empty-icon">📦</view>
            <text class="empty-text">暂无产品信息</text>
            <text class="empty-desc">请稍后再试</text>
        </view>
        
        <!-- 产品列表 -->
        <view wx:else class="vip-wrap flex">
            <view class="{{ item.checked ? 'box box-selected':'box'}}" wx:for="{{productList}}" wx:key="productId" bind:tap="onVipChange" data-index="{{index}}">
                <view class="name">{{item.localizedTitle || item.name}}</view>
                <view class="price"><text class="price-sign">￥</text>{{item.priceText || item.price}}</view>
                <view class="original-price" wx:if="{{item.originalPrice && item.originalPrice > item.price}}">￥{{item.originalPriceText || item.originalPrice}}</view>
                <view class="note">{{item.note}}</view>
                <view class="recommend" wx:if="{{item.recommend}}"><text class="recommend-text">{{item.recommend}}</text></view>
            </view>
        </view>
    </view>
    <!-- 顶部温馨提示，仅针对终身会员调价信息 -->
    <!-- <view class="tips" wx:if="{{currentProduct && currentProduct.productIdentifier === 'com.louhao.xiaoqu.vip'}}">
        温馨提醒：2026年3月起将调整为108元
    </view> -->
    
    <!-- 退款说明 -->
    <view class="refund-notice">
        <view class="refund-notice-row">
            <view class="refund-notice-text-wrap">
                <!-- 第一行 + 帮助图标 在一行内展示 -->
                <view class="refund-main-row">
                    <text class="refund-text">
                        · 会员订单支持7天无理由退款，按已使用天数扣除费用（每天0.3元），每个月最多退款一次
                    </text>
                    <view class="refund-help-icon-wrapper">
                        <view class="refund-help-icon" bind:tap="onShowRefundHelp">
                            <text class="refund-help-icon-text">?</text>
                        </view>
                        <view class="refund-tooltip" wx:if="{{showRefundHelp}}">
                            <text class="refund-tooltip-text">按月度会员原价9元/30天计算，折合每天0.3元</text>
                            <view class="refund-tooltip-arrow"></view>
                        </view>
                    </view>
                </view>
                <!-- 第二行根据产品类型切换提示文案（先展示通用说明，再展示终身会员调价） -->
                <text 
                    class="refund-text"
                    wx:if="{{!(currentProduct && currentProduct.productIdentifier === 'com.louhao.xiaoqu.vip')}}"
                >
                    · 非订阅模式，到期后不会自动扣费，需您手动操作续费
                </text>
                <text 
                    class="refund-text"
                    wx:else
                >
                    · 2026年4月起将调整为108元
                </text>
            </view>
        </view>
    </view>
    
    <!-- 遮罩层，点击关闭tooltip -->
    <view class="tooltip-overlay" wx:if="{{showRefundHelp}}" bind:tap="onShowRefundHelp"></view>
    
    <view class="footer">
        <button 
            type="primary" 
            style="background-color: rgba(219, 179, 122, 1);" 
            bind:tap="onPurchase"
            disabled="{{paying || !currentProduct || productList.length === 0}}"
            loading="{{paying}}"
        >
            {{paying ? '支付中...' : '开通会员'}}
        </button>
        <view class="agree-wrap flex f-x-center f-y-center">
            <span class="agree" bind:tap="toUseAgreement">会员服务协议</span>
                <!-- <span style="margin-left: 4px;">·</span> -->
        </view>
    </view>
</view>