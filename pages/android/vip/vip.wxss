page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.navbar-right {
  font-size: 14px;
  font-weight: 400;
  color: #333;
}

.scroll-area {
  flex: 1;
  overflow-y: hidden;
}

.intro {
  padding: 30px;
  text-align: center;
}

.vip-container {
  position: relative;
  height: calc(100vh - 64rpx);
  background-color: #fff;
  padding: 32rpx;
}

.header-wrap {}

.line {
  width: 3px;
  height: 15px;
  opacity: 1;
  background: rgba(219, 179, 122, 1);
}

.title {
  margin-left: 12px;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0px;
  line-height: 21.72px;
  color: rgba(51, 51, 51, 1);
}

.title-2 {
  font-size: 12px;
}

.rights-wrap {
  width: 100%;
  margin-top: 24px;
  flex-wrap: wrap;
  gap: 2px;
}

.rights {
  width: calc((100% - 4 * 2px) / 5);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rights-img-wrap {
  background-color: #FCF7EF;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rights-icon {
  font-size: 32px;
  line-height: 1;
}

.rights-text {
  margin-top: 6px;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0px;
  line-height: 20.27px;
  color: rgba(51, 51, 51, 1);
}

.content {
  margin-top: 64rpx;
}

.vip-wrap {
  overflow-x: auto;
  gap: 8px;
}

.vip-wrap::-webkit-scrollbar {
  display: none;
}

.box {
  margin-top: 48rpx;
  min-width: calc(32% - 8px);
  /* 确保最小宽度 */
  position: relative;
  flex: 1;
  opacity: 1;
  border-radius: 10px;
  background: rgba(255, 255, 255, 1);
  border: 1px solid rgba(212, 176, 119, .2);
  box-shadow: 0px 0px 6px rgba(153, 153, 153, 0.16);
  text-align: center;
}

.box-selected {
  border: 1px solid rgba(212, 176, 119, 1);
  background: rgb(245, 236, 221);
}

.recommend {
  position: absolute;
  top: -10px;
  right: -1px;
  width: 68px;
  height: 20px;
  opacity: 1;
  border-radius: 0px 10px 0px 10px;
  background: rgb(231, 187, 115);
}

.recommend-text {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0px;
  line-height: 18.82px;
  color: rgba(135, 94, 43, 1);
  text-align: left;
  vertical-align: top;
}

.name {
  margin-top: 36px;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0px;
  line-height: 23.17px;
  color: rgba(51, 51, 51, 1);
}

.price {
  margin-top: 18px;
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 0px;
  color: rgba(135, 94, 43, 1);
  line-height: 1.2;
}

.price-sign {
  font-size: 12px;
}

.original-price {
  margin-top: 8px;
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0px;
  line-height: 14.48px;
  text-decoration-line: line-through;
  color: rgba(135, 94, 43, 1);
}

.note {
  width: 80%;
  margin: 10px 0 10px 10%;
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0px;
  line-height: 14.48px;
  color: rgba(153, 153, 153, 1);
}

.tips {
  margin-top: 32rpx;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0px;
  line-height: 18.82px;
  color: rgba(153, 153, 153, 1);
}

.mp-name {
  color: #0074FE;
}

.footer {
  position: fixed;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  padding-bottom: env(safe-area-inset-bottom);
  text-align: center;
}

.agree-wrap {
  margin-top: 8px;
}

.restore {
  font-size: 14px;
  font-weight: 400;
  color: #333;
  text-decoration: underline;
}

.agree {
  color: rgba(50, 50, 51, 1);
  font-size: 14px;
  font-weight: 400;
  color: #333;
  text-decoration: underline;
}

.agree-blue {
  color: rgba(22, 93, 255, 1);
}

.t-checkbox__icon--left {
  margin-right: 0 !important;
}

/* 加载状态 */
.loading-wrapper {
  margin-top: 48rpx;
  display: flex;
  gap: 8px;
}

.skeleton-card {
  flex: 1;
  min-width: calc(32% - 8px);
  padding: 24rpx;
  background: rgba(255, 255, 255, 1);
  border-radius: 10px;
  border: 1px solid rgba(212, 176, 119, .2);
}

/* 空状态 */
.empty-state {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
}

/* 退款说明 */
.refund-notice {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border-left: 4rpx solid #1890ff;
}

.refund-notice-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.refund-notice-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  flex: 1;
}

.refund-help-icon-wrapper {
  position: relative;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.refund-help-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #e6f7ff;
  border: 2rpx solid #91d5ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refund-help-icon-text {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 600;
  line-height: 1;
}

/* 退款说明提示（类似tooltip） */
.refund-tooltip {
  position: absolute;
  bottom: calc(100% + 12rpx);
  right: 0;
  background-color: rgba(0, 0, 0, 0.85);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  max-width: 500rpx;
  min-width: 200rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  animation: tooltip-fade-in 0.2s ease-out;
  z-index: 1000;
  white-space: nowrap;
}

.refund-tooltip-text {
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.5;
  display: block;
}

.refund-tooltip-arrow {
  position: absolute;
  right: 20rpx;
  bottom: -8rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid rgba(0, 0, 0, 0.85);
}

@keyframes tooltip-fade-in {
  from {
    opacity: 0;
    transform: translateY(4rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* tooltip遮罩层 */
.tooltip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background-color: transparent;
}