<!--pages/android/order/detail/detail.wxml-->
<view class="detail-container">
  <!-- 骨架屏加载 -->
  <view wx:if="{{loading}}" class="skeleton-wrapper">
    <view class="skeleton-header">
      <t-skeleton theme="paragraph" row="2" />
    </view>
    <view class="skeleton-content">
      <t-skeleton theme="paragraph" row="5" />
    </view>
  </view>

  <view wx:else class="detail-content">
    <!-- 订单头部卡片 -->
    <view class="order-header-card order-status-{{orderInfo.tradeState}}">
      <view class="header-content">
        <view class="order-header">
          <view class="order-title-section">
            <text class="order-product-name">{{orderInfo.description}}</text>
            <view class="order-status-tags">
              <t-tag 
                theme="{{orderInfo.tradeState === 'SUCCESS' ? 'primary' : orderInfo.tradeState === 'REFUND' ? 'success' : orderInfo.tradeState === 'REFUNDING' ? 'warning' : orderInfo.tradeState === 'CLOSED' ? 'default' : orderInfo.tradeState === 'REVOKED' ? 'danger' : 'default'}}"
                size="small"
                variant="light"
                class="status-tag"
              >
                {{orderInfo.statusText}}
              </t-tag>
              <t-tag 
                wx:if="{{orderInfo.refundable}}"
                theme="warning"
                size="small"
                variant="light"
                class="refundable-tag"
              >
                可退款
              </t-tag>
            </view>
          </view>
          <text class="order-amount">¥{{orderInfo.amountText}}</text>
        </view>
      </view>
    </view>

    <!-- 订单详情信息 -->
    <view class="detail-section">
      <view class="section-title">订单信息</view>
      <view class="info-card">
        <view class="info-item">
          <text class="info-label">订单号</text>
          <view class="info-value-wrapper">
            <text class="info-value">{{orderInfo.outTradeNo}}</text>
            <view class="copy-btn" bindtap="onCopyOrderNo">
              <text class="copy-text">复制</text>
            </view>
          </view>
        </view>
        <view class="info-item" wx:if="{{orderInfo.createdDate}}">
          <text class="info-label">下单时间</text>
          <text class="info-value">{{orderInfo.createTimeText}}</text>
        </view>
        <view class="info-item" wx:if="{{orderInfo.successTime}}">
          <text class="info-label">支付时间</text>
          <text class="info-value">{{orderInfo.payTimeText}}</text>
        </view>
      </view>
    </view>

    <!-- 产品信息 -->
    <view class="detail-section" wx:if="{{orderInfo.memberDuration || orderInfo.expireTimeText}}">
      <view class="section-title">产品信息</view>
      <view class="info-card">
        <view class="info-item" wx:if="{{orderInfo.memberDuration}}">
          <text class="info-label">会员期限</text>
          <text class="info-value">{{orderInfo.memberDuration}}天</text>
        </view>
        <view class="info-item" wx:if="{{orderInfo.expireTimeText}}">
          <text class="info-label">到期时间</text>
          <text class="info-value expire-time">{{orderInfo.expireTimeText}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <!-- 待支付订单 - 立即支付按钮 -->
      <t-button 
        wx:if="{{orderInfo.tradeState === 'NOTPAY'}}"
        theme="primary"
        size="large"
        block
        bind:tap="onPay"
        class="action-btn pay-btn"
        disabled="{{paying}}"
        loading="{{paying}}"
      >
        {{paying ? '支付中...' : '立即支付'}}
      </t-button>
      <!-- 已支付订单 - 申请退款按钮 -->
      <t-button 
        wx:elif="{{orderInfo.refundable && orderInfo.tradeState === 'SUCCESS'}}"
        theme="primary"
        size="large"
        block
        bind:tap="onRefund"
        class="action-btn refund-btn"
      >
        申请退款
      </t-button>
      <!-- 其他状态 - 提示信息 -->
      <view wx:else class="no-refund-card" wx:class="no-refund-{{orderInfo.tradeState}}">
        <view class="no-refund-header">
          <view class="no-refund-icon-wrapper">
            <text class="no-refund-icon">
              <block wx:if="{{orderInfo.tradeState === 'REFUND'}}">✓</block>
              <block wx:elif="{{orderInfo.tradeState === 'REFUNDING'}}">⏳</block>
              <block wx:elif="{{orderInfo.tradeState === 'CLOSED'}}">🔒</block>
              <block wx:elif="{{orderInfo.tradeState === 'REVOKED'}}">✗</block>
              <block wx:elif="{{orderInfo.tradeState === 'NOTPAY'}}">💳</block>
              <block wx:else>ℹ</block>
            </text>
          </view>
          <view class="no-refund-content">
            <text class="no-refund-title">
              <block wx:if="{{orderInfo.tradeState === 'REFUND'}}">订单已退款</block>
              <block wx:elif="{{orderInfo.tradeState === 'REFUNDING'}}">退款处理中</block>
              <block wx:elif="{{orderInfo.tradeState === 'CLOSED'}}">订单已关闭</block>
              <block wx:elif="{{orderInfo.tradeState === 'REVOKED'}}">订单已撤销</block>
              <block wx:elif="{{orderInfo.tradeState === 'NOTPAY'}}">订单未支付</block>
              <block wx:else>暂不支持退款</block>
            </text>
            <text class="no-refund-desc">
              <block wx:if="{{orderInfo.tradeState === 'REFUND'}}">该订单已完成退款，退款金额已原路退回</block>
              <block wx:elif="{{orderInfo.tradeState === 'REFUNDING'}}">您的退款申请正在处理中，请耐心等待</block>
              <block wx:elif="{{orderInfo.tradeState === 'CLOSED'}}">该订单未支付且已关闭，无法进行退款操作</block>
              <block wx:elif="{{orderInfo.tradeState === 'REVOKED'}}">该订单已撤销，无法进行退款操作</block>
              <block wx:elif="{{orderInfo.tradeState === 'NOTPAY'}}">请先完成支付后才能申请退款</block>
              <block wx:else>该订单当前状态暂不支持退款，如有疑问请联系客服</block>
            </text>
          </view>
        </view>
        <view class="no-refund-divider"></view>
        <view class="no-refund-footer">
          <text class="no-refund-hint">💡 提示：如需帮助，请联系客服</text>
        </view>
      </view>
    </view>
  </view>
</view>

