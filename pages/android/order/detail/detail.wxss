/* pages/android/order/detail/detail.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.detail-container {
  padding: 0;
  padding-bottom: 40rpx;
}

.detail-content {
  padding: 0;
}

/* 订单头部卡片 */
.order-header-card {
  background-color: #ffffff;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  border-left: 4rpx solid transparent;
  position: relative;
}

.order-header-card.order-status-SUCCESS {
  border-left-color: #1890ff; /* 已支付 */
}

.order-header-card.order-status-REFUND {
  border-left-color: #52c41a; /* 已退款 */
}

.order-header-card.order-status-CLOSED {
  border-left-color: #faad14; /* 已关闭 */
}

.order-header-card.order-status-REVOKED {
  border-left-color: #ff4d4f; /* 已撤销 */
}

.header-content {
  padding: 24rpx;
  background-color: #ffffff;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.order-title-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.order-status-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-tag {
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.refundable-tag {
  font-weight: 500;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.8;
  }
}

.order-amount {
  color: #333333;
  font-weight: 700;
  font-size: 36rpx;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1.2;
}

/* 详情信息区域 */
.detail-section {
  margin: 0 24rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.info-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 400;
  flex-shrink: 0;
}

.info-value-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  justify-content: flex-end;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.copy-btn {
  padding: 8rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.copy-text {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 500;
}

.expire-time {
  color: #52c41a;
  font-weight: 600;
  font-size: 30rpx;
}

/* 操作按钮 */
.action-section {
  padding: 0 24rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.25);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.action-btn:active::before {
  left: 100%;
}

.refund-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
}

.no-action-tip {
  padding: 32rpx 24rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid #f0f0f0;
}

.tip-icon {
  font-size: 48rpx;
  color: #999999;
  opacity: 0.6;
}

.tip-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

/* 骨架屏 */
.skeleton-wrapper {
  padding: 24rpx;
}

.skeleton-header {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.skeleton-content {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

