/* pages/android/order/list/list.wxss */
page {
  background-color: #f5f5f5;
  height: 100vh;
}

.order-list-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.tabs-wrapper {
  background-color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  padding: 0 24rpx 16rpx;
}

.tabs-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.order-count {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.count-text {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.order-scroll {
  flex: 1;
  height: 0;
}

.order-list-content {
  padding: 24rpx;
}

/* 订单卡片 */
.order-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  border-left: 4rpx solid transparent;
}

/* 根据状态显示不同颜色的左侧边框 - 通过类名实现 */
.order-card.order-status-1 {
  border-left-color: #1890ff; /* 已支付 */
}

.order-card.order-status-3 {
  border-left-color: #52c41a; /* 已退款 */
}

.order-card.order-status-4 {
  border-left-color: #faad14; /* 退款中 */
}

.order-card.order-refunded {
  border-left-color: #ff4d4f;
}

.order-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.order-card-content {
  padding: 24rpx;
  background-color: #ffffff;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.order-title-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.order-status-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.order-amount {
  color: #ff4d4f;
  font-weight: 700;
  font-size: 36rpx;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1.2;
}

.order-footer {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.loading-wrapper {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 16rpx;
}

.no-more {
  padding: 40rpx 0;
  text-align: center;
}

.no-more-text {
  font-size: 24rpx;
  color: #cccccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 骨架屏 */
.skeleton-wrapper {
  padding: 0;
}

.skeleton-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

