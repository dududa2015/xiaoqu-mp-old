page {
  background-color: #F2F2F7;
  height: 100vh;
}

.page-scroll {
  height: 100vh;
}

.page-content {
  padding: 32rpx;
  box-sizing: border-box;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.card {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.empty-card {
  text-align: center;
  padding: 64rpx 36rpx;
}

.empty-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.5;
}

.list-card {
  padding-top: 32rpx;
  padding-bottom: 8rpx;
}

.list-title {
  display: block;
  margin-bottom: 8rpx;
}

.record-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 0;
}

.record-item-divider {
  border-bottom: 1rpx solid #E5E5EA;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.record-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.record-badge {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background-color: #E8F3FF;
  color: #0074FE;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.record-badge-refunded {
  background-color: #EFEFF4;
  color: #6B7280;
}

.record-note {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
  word-break: break-all;
}

.record-note-muted {
  font-size: 24rpx;
  color: #9CA3AF;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
  flex-shrink: 0;
}

.legal-section {
  padding: 8rpx;
}

.legal-text {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
