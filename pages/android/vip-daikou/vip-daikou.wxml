<view class="page">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-content">
      <view class="card benefits-card">
        <view class="card-title-row">
          <text class="card-title">会员权益</text>
          <text class="card-subtitle">（相比小程序）</text>
        </view>
        <view class="benefits-grid">
          <view class="benefit-item" wx:for="{{rightsList}}" wx:key="name">
            <t-icon name="{{item.icon}}" size="30rpx" color="#0074FE" class="benefit-icon"></t-icon>
            <text class="benefit-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="card products-card">
        <text class="card-title products-title">会员选择</text>
        <view
          class="plan-item {{index < productList.length - 1 ? 'plan-item-divider' : ''}}"
          wx:for="{{productList}}"
          wx:key="productId"
          bind:tap="onVipChange"
          data-index="{{index}}"
        >
          <view class="plan-main">
            <view class="plan-name-row">
              <text class="plan-name">{{item.localizedTitle || item.name}}</text>
              <view class="plan-badge plan-badge-current" wx:if="{{item.isCurrent}}">已订阅</view>
              <view class="plan-badge" wx:elif="{{item.recommend}}">{{item.recommend}}</view>
            </view>
            <text class="plan-note">{{item.note}}</text>
          </view>
          <text class="plan-price">{{item.priceLabel}}</text>
          <view class="plan-check">
            <t-icon wx:if="{{item.checked}}" name="check-circle-filled" size="40rpx" color="#0074FE"></t-icon>
            <view wx:else class="radio-empty"></view>
          </view>
        </view>
      </view>

      <view class="legal-section">
        <text class="legal-text">· 开通即开启自动续费，到期前将自动扣款续费</text>
        <text class="legal-text">· 可随时在「我的 - 会员管理」中关闭自动续费</text>
        <text class="legal-text">· 首次开通成功后会员即时生效，网络波动时可能延迟 1~2 分钟</text>
      </view>

      <view class="subscribed-hint" wx:if="{{subscriptionHint}}">
        <text class="subscribed-hint-text">{{subscriptionHint}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="page-footer">
    <view class="agree-row">
      <t-checkbox t-class="agree-checkbox" block="{{false}}" borderless="{{true}}" checked="{{agreedRenew}}" bind:change="onAgreedRenewChange"></t-checkbox>
      <view class="agree-text">
        已阅读并同意
        <text class="agree-link" catch:tap="toUseAgreement">《会员服务协议》</text>
        和
        <text class="agree-link" catch:tap="toDaikouAgreement">《自动续费协议》</text>
      </view>
    </view>

    <t-button
      wx:if="{{selectedIsCurrentPlan && alreadySubscribed}}"
      theme="primary"
      size="large"
      block
      bind:tap="onCurrentPlanTap"
      disabled="{{paying || !agreedRenew}}"
      loading="{{paying}}"
    >
      当前方案
    </t-button>
    <t-button
      wx:else
      theme="primary"
      size="large"
      block
      bind:tap="onPurchase"
      disabled="{{paying || !currentProduct || !agreedRenew}}"
      loading="{{paying}}"
    >
      {{subscribeButtonText}}
    </t-button>
  </view>
</view>
