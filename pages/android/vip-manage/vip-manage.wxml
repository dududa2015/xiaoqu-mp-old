<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-content">
    <view wx:if="{{loading}}" class="loading-wrap">
      <t-loading theme="circular" size="40rpx" text="加载中..." />
    </view>

    <block wx:elif="{{showManageView}}">
      <view class="card status-card">
        <view class="status-top">
          <view class="status-main">
            <text class="card-title">{{memberInfo.planName || 'VIP 会员'}}</text>
            <text class="status-expire" wx:if="{{memberInfo.isVip}}">{{memberInfo.expireDate}} 到期 · 剩余 {{memberInfo.daysLeft}} 天</text>
            <text class="status-expire" wx:else>{{memberInfo.expireDate ? memberInfo.expireDate + ' 已到期' : '会员已过期'}}</text>
          </view>
          <view class="status-badge" wx:if="{{memberInfo.isVip}}">生效中</view>
          <view class="status-badge status-badge-expired" wx:else>已过期</view>
        </view>
        <view class="expire-hint" wx:if="{{expireSoon}}">
          <t-icon name="info-circle" size="28rpx" color="#0074FE" />
          <text class="expire-hint-text">会员即将到期，开启自动续费可到期无缝延长</text>
        </view>
        <view class="expire-hint expire-hint-warn" wx:elif="{{renewOnlyWithoutVip}}">
          <t-icon name="info-circle" size="28rpx" color="#E37318" />
          <text class="expire-hint-text expire-hint-text-warn">自动续费仍开启，请关闭以免下一周期自动扣款</text>
        </view>
      </view>

      <view class="card renew-card">
        <view class="renew-header-row">
          <text class="card-title">自动续费</text>
          <t-switch
            value="{{memberInfo.autoRenewEnabled}}"
            size="small"
            bind:change="onAutoRenewChange"
          />
        </view>
        <text class="renew-switch-desc">{{memberInfo.autoRenewEnabled ? '已开启，到期前将自动扣款' : '未开启'}}</text>

        <block wx:if="{{memberInfo.autoRenewEnabled}}">
          <view class="info-divider"></view>
          <view class="info-row">
            <text class="info-label">下次扣费</text>
            <text class="info-value">{{memberInfo.nextChargeDate || '—'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">扣费金额</text>
            <text class="info-value">¥{{memberInfo.nextChargeAmount || '0.00'}}</text>
          </view>
          <view class="info-row info-row-muted" wx:if="{{memberInfo.signedDate}}">
            <text class="info-label">签约时间</text>
            <text class="info-value-muted">{{memberInfo.signedDate}}</text>
          </view>
        </block>

        <block wx:else>
          <view class="renew-off-box">
            <text class="renew-off-text">关闭或尚未签约时，到期后需手动续费</text>
            <text class="renew-off-link" bind:tap="toVipDaikou">去开通自动续费</text>
          </view>
        </block>
      </view>

      <view class="card services-card">
        <text class="card-title block-title">相关服务</text>
        <view class="service-item service-item-divider" bind:tap="toPapayRefund">
          <text class="service-name">自动续费退款</text>
          <t-icon name="chevron-right" size="40rpx" color="#C7C7CC" />
        </view>
        <view class="service-item service-item-divider" bind:tap="toChangePlan">
          <text class="service-name">变更订阅方案</text>
          <t-icon name="chevron-right" size="40rpx" color="#C7C7CC" />
        </view>
        <view class="service-item service-item-divider" bind:tap="toDeductList">
          <text class="service-name">扣费记录</text>
          <t-icon name="chevron-right" size="40rpx" color="#C7C7CC" />
        </view>
        <view class="service-item" bind:tap="toDaikouAgreement">
          <text class="service-name">自动续费协议</text>
          <t-icon name="chevron-right" size="40rpx" color="#C7C7CC" />
        </view>
      </view>

      <view class="legal-section">
        <text class="legal-text" wx:if="{{renewOnlyWithoutVip}}">· 会员已过期但自动续费协议仍有效，请在本页关闭或前往微信钱包管理</text>
        <text class="legal-text">· 关闭自动续费后，当前会员权益不受影响，到期后将不再自动扣款</text>
        <text class="legal-text">· 如需取消下一周期扣款，请至少提前 24 小时关闭；也可在微信钱包「自动续费」中管理</text>
      </view>
    </block>

    <block wx:else>
      <view class="card empty-card">
        <view class="empty-icon-wrap">
          <t-icon name="star-filled" size="64rpx" color="#0074FE" />
        </view>
        <text class="empty-title">暂未开通会员</text>
        <text class="empty-desc">开通连续包月，享受免广告、个人地图等专属权益</text>
        <t-button theme="primary" size="large" block bind:tap="toVipDaikou">立即开通</t-button>
      </view>
      <view class="legal-section">
        <text class="legal-text">· 开通即开启自动续费，可随时在本页关闭</text>
        <text class="legal-text">· 首次开通成功后会员即时生效，网络波动时可能延迟 1~2 分钟</text>
      </view>
    </block>
  </view>
</scroll-view>
