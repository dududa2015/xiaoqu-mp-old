page {
  background-color: #F2F2F7;
  height: 100vh;
}

.page-scroll {
  height: 100vh;
}

.page-content {
  padding: 32rpx;
  box-sizing: border-box;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.card {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.block-title {
  display: block;
  margin-bottom: 8rpx;
}

.status-card {
  padding-top: 36rpx;
  padding-bottom: 32rpx;
}

.status-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.status-main {
  flex: 1;
  min-width: 0;
}

.status-expire {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background-color: #E8F3FF;
  color: #0074FE;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-badge-expired {
  background-color: #F2F2F7;
  color: #6B7280;
}

.expire-hint-warn {
  background: #FFF7E8;
}

.expire-hint-text-warn {
  color: #E37318;
}

.expire-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
}

.expire-hint-text {
  flex: 1;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

.renew-card {
  padding-bottom: 28rpx;
}

.renew-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.renew-switch-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.5;
}

.info-divider {
  height: 1rpx;
  background: #E5E5EA;
  margin: 8rpx 0 4rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.info-row-muted {
  padding-bottom: 4rpx;
}

.info-label {
  font-size: 28rpx;
  color: #6B7280;
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
}

.info-value-muted {
  font-size: 24rpx;
  color: #9CA3AF;
}

.renew-off-box {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
}

.renew-off-text {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

.renew-off-link {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #0074FE;
  font-weight: 500;
}

.services-card {
  padding-top: 32rpx;
  padding-bottom: 8rpx;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.service-item-divider {
  border-bottom: 1rpx solid #E5E5EA;
}

.service-name {
  font-size: 30rpx;
  color: #1D2129;
}

.legal-section {
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.legal-text {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.empty-card {
  text-align: center;
  padding: 64rpx 36rpx 48rpx;
}

.empty-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
