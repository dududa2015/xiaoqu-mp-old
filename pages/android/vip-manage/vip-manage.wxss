page {
  background-color: #f5f5f5;
}

.manage-container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.status-card {
  background: linear-gradient(135deg, #dbb37a 0%, #c99a5a 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 700;
}

.status-plan {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.status-body {
  display: flex;
  gap: 48rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.status-value {
  font-size: 28rpx;
  font-weight: 600;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 8rpx 16rpx;
}

.cell-group {
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cell-note {
  font-size: 28rpx;
  color: #333;
}

.cell-note-muted {
  font-size: 24rpx;
  color: #999;
}

.tips-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.tips-link {
  color: #165dff;
}

.action-section {
  margin-top: 16rpx;
}

.empty-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 80rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}
