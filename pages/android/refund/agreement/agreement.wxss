/* pages/android/refund/agreement/agreement.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.agreement-container {
  padding: 24rpx;
}

.agreement-header {
  background-color: #ffffff;
  padding: 32rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.agreement-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  display: block;
}

.agreement-content {
  background-color: #ffffff;
  padding: 32rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  min-height: 400rpx;
}

.agreement-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
}