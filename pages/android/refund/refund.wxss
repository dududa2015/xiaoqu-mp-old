/* pages/android/refund/refund.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.refund-container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 订单信息卡片 */
.order-info-card {
  margin-bottom: 24rpx;
}

.order-header-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
  border-left: 4rpx solid #1890ff;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx;
}

.order-title-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.order-amount {
  color: #ff4d4f;
  font-weight: 700;
  font-size: 36rpx;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1.2;
}

/* 退款计算摘要卡片 */
.refund-summary-card {
  background-color: #ffffff;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.summary-header {
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.summary-content {
  padding: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-row.total {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.summary-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 400;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.summary-value.deduction {
  color: #ff4d4f;
  font-weight: 600;
}

.summary-value.refund {
  color: #1890ff;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.summary-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 16rpx 0;
}

/* 退款提示卡片 */
.refund-tip-card {
  margin-bottom: 24rpx;
}

.tip-content {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.tip-content.tip-success {
  background-color: #ffffff;
  border-left: 4rpx solid #52c41a;
}

.tip-content.tip-error {
  background-color: #ffffff;
  border-left: 4rpx solid #ff4d4f;
}

.tip-icon {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tip-content.tip-success .tip-icon {
  color: #52c41a;
}

.tip-content.tip-error .tip-icon {
  color: #ff4d4f;
}

.tip-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  flex: 1;
}

/* 订单号输入卡片 */
.order-input-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.input-header {
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.input-content {
  padding: 24rpx;
}

.order-input {
  margin-bottom: 24rpx;
}

.query-btn {
  border-radius: 12rpx;
}

/* 退款原因区域 */
.reason-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.reason-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.reason-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.reason-item {
  padding: 16rpx 28rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.reason-item-active {
  background-color: #e8f4ff;
  border-color: #1890ff;
}

.reason-text {
  font-size: 26rpx;
  color: #666666;
}

.reason-item-active .reason-text {
  color: #1890ff;
  font-weight: 500;
}

.custom-reason-wrapper {
  margin-top: 20rpx;
}

.custom-reason-input {
  border-radius: 12rpx;
}

/* 退款规则说明 */
.refund-rule-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  border-left: 4rpx solid #faad14;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.rule-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rule-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-section {
  padding: 0;
  margin-top: 60rpx;
}

.submit-btn {
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.disabled-tip {
  padding: 40rpx 0;
  text-align: center;
  background-color: #ffffff;
  border-radius: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #999999;
}

