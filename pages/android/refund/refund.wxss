/* pages/android/refund/refund.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.refund-container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 订单信息卡片 */
.order-info-card {
  margin-bottom: 24rpx;
}

.order-header-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
  border-left: 4rpx solid #1890ff;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx;
}

.order-title-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.order-amount {
  color: #333333;
  font-weight: 700;
  font-size: 36rpx;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1.2;
}

/* 退款计算摘要卡片 */
.refund-summary-card {
  background-color: #ffffff;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.summary-header {
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.summary-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.summary-icon {
  font-size: 32rpx;
  line-height: 1;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.summary-content {
  padding: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-label-wrapper {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.summary-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 400;
}

.summary-label-desc {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.summary-label-hint {
  font-size: 24rpx;
  color: #52c41a;
  font-weight: 400;
  margin-top: 4rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.order-amount-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 扣除明细区域 */
.deduction-section {
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin: 16rpx 0;
}

.deduction-row {
  margin-bottom: 8rpx;
}

.deduction-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.deduction-note {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.deduction-note-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.deduction-note-text {
  font-size: 24rpx;
  color: #999999;
  flex: 1;
}

.deduction-help-icon-wrapper {
  position: relative;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.deduction-help-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #e6f7ff;
  border: 2rpx solid #91d5ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.help-icon-text {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 600;
  line-height: 1;
}

.summary-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

/* 可退金额区域（突出显示） */
.total-row {
  background: linear-gradient(135deg, #e6f7ff 0%, #f0f9ff 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  border: 2rpx solid #91d5ff;
}

.total-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.refund-amount-wrapper {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.refund-amount {
  color: #1890ff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

/* 退款提示卡片 */
.refund-tip-card {
  margin-bottom: 24rpx;
}

.tip-content {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.tip-content.tip-success {
  background-color: #ffffff;
  border-left: 4rpx solid #52c41a;
}

.tip-content.tip-error {
  background-color: #ffffff;
  border-left: 4rpx solid #ff4d4f;
}

.tip-icon {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tip-content.tip-success .tip-icon {
  color: #52c41a;
}

.tip-content.tip-error .tip-icon {
  color: #ff4d4f;
}

.tip-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  flex: 1;
}

/* 订单号输入卡片 */
.order-input-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.input-header {
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.input-content {
  padding: 24rpx;
}

.order-input {
  margin-bottom: 24rpx;
}

.query-btn {
  border-radius: 12rpx;
}

/* 退款原因区域 */
.reason-section {
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.section-title-required {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
}

.reason-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.reason-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.reason-item {
  padding: 16rpx 28rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.reason-item-active {
  background-color: #e8f4ff;
  border-color: #1890ff;
}

.reason-text {
  font-size: 26rpx;
  color: #666666;
}

.reason-item-active .reason-text {
  color: #1890ff;
  font-weight: 500;
}

.reason-item-error {
  border-color: #ff4d4f;
  background-color: #fff1f0;
}

.reason-item-error .reason-text {
  color: #ff4d4f;
}

.reason-error-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background-color: #fff1f0;
  border-radius: 8rpx;
  border-left: 4rpx solid #ff4d4f;
}

.reason-error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  line-height: 1.5;
}

.custom-reason-wrapper {
  margin-top: 20rpx;
}

.custom-reason-input-error {
  border-color: #ff4d4f !important;
}

.custom-reason-error-tip {
  margin-top: 8rpx;
  padding: 8rpx 12rpx;
  background-color: #fff1f0;
  border-radius: 6rpx;
}

.custom-reason-error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  line-height: 1.5;
}

.custom-reason-count {
  margin-top: 8rpx;
  text-align: right;
}

.custom-reason-count-text {
  font-size: 24rpx;
  color: #999999;
}

.custom-reason-input {
  border-radius: 12rpx;
}

/* 退款规则说明 */
.refund-rule-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
  border-left: 4rpx solid #faad14;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.rule-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rule-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-section {
  padding: 0;
  margin-top: 60rpx;
}

.submit-btn {
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.disabled-tip {
  padding: 40rpx 0;
  text-align: center;
  background-color: #ffffff;
  border-radius: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #999999;
}

/* 退款协议 */
.agreement-section {
  margin-bottom: 24rpx;
}

.agreement-checkbox-wrapper {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(0, 0, 0, 0.1);
}

.agreement-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.3s;
  background-color: #ffffff;
}

.agreement-checkbox-checked {
  border-color: #1890ff;
  background-color: #1890ff;
}

.agreement-checkbox-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1;
}

.agreement-text-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.agreement-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.agreement-link {
  font-size: 26rpx;
  color: #1890ff;
  text-decoration: underline;
  line-height: 1.6;
}

.agreement-error-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background-color: #fff1f0;
  border-radius: 8rpx;
  border-left: 4rpx solid #ff4d4f;
}

.agreement-error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  line-height: 1.5;
}

/* 退款成功弹窗样式 - 内容左对齐 */
.refund-success-content {
  text-align: left;
  width: 100%;
}

.refund-success-text {
  display: block;
  text-align: left;
  white-space: pre-line;
  line-height: 1.8;
  font-size: 28rpx;
  color: #333333;
  word-break: break-all;
}

/* 扣除费用说明提示（类似tooltip） */
.deduction-tooltip {
  position: absolute;
  bottom: calc(100% + 12rpx);
  right: 0;
  background-color: rgba(0, 0, 0, 0.85);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  max-width: 500rpx;
  min-width: 200rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  animation: tooltip-fade-in 0.2s ease-out;
  z-index: 1000;
  white-space: nowrap;
}

.deduction-tooltip-text {
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.5;
  display: block;
}

.deduction-tooltip-arrow {
  position: absolute;
  right: 20rpx;
  bottom: -8rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid rgba(0, 0, 0, 0.85);
}

@keyframes tooltip-fade-in {
  from {
    opacity: 0;
    transform: translateY(4rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* tooltip遮罩层 */
.tooltip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background-color: transparent;
}

