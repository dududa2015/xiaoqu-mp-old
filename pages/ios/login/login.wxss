page {
    background-color: #f7f7f7;
}

.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 64rpx 0;
    min-height: 100vh;
}

.logo-wrap {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 120rpx;
}

.logo-img {
    width: 160rpx;
    height: 160rpx;
    border-radius: 32rpx;
    margin-bottom: 32rpx;
}

.logo-text {
    font-size: 56rpx;
    font-weight: 600;
    color: rgba(31, 35, 41, 1);
    margin-bottom: 16rpx;
}

.logo-desc {
    font-size: 28rpx;
    font-weight: 400;
    color: rgba(100, 106, 115, 1);
}

.login-buttons {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24rpx;
    margin-bottom: 48rpx;
}

.login-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 96rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
    font-weight: 500;
    transition: all 0.3s ease;
}

.login-btn:active {
    opacity: 0.8;
}

.apple-btn {
    background: #000000;
    color: #ffffff;
}

.wx-btn {
    background: #07c160;
    color: #ffffff;
}

.btn-icon {
    width: 44rpx;
    height: 44rpx;
    margin-right: 16rpx;
}

.btn-text {
    font-size: 32rpx;
    font-weight: 500;
}

.agree-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 32rpx;
}

.agree {
    margin-left: 8px;
    color: rgba(50, 50, 51, 1);
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 400;
    text-align: center;
}

.agree-blue {
    color: rgba(22, 93, 255, 1);
}

.t-checkbox__icon--left {
    margin-right: 0 !important;
}