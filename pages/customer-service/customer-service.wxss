.page {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.nav {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f5f5;
}

.nav-back {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.body {
  flex: 1;
  width: 100%;
  height: 0;
}

.content {
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
}

button.contact {
  display: block;
  width: 100%;
  min-height: 0;
  margin: 0 0 24rpx;
  padding: 0;
  border: none;
  border-radius: 48rpx;
  background: #ffffff;
  overflow: hidden;
  line-height: normal;
  font-size: 28rpx;
  font-weight: 400;
  color: #222222;
  text-align: left;
}

button.contact::after {
  border: none;
}

button.contact .row {
  width: 100%;
  box-sizing: border-box;
}

.group-label {
  display: block;
  margin: 8rpx 16rpx 12rpx;
  font-size: 24rpx;
  color: #888888;
}

.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.article {
  padding: 24rpx 32rpx 32rpx;
}

.row,
.link {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row-last {
  border-bottom-width: 0;
}

.main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.title,
.h3 {
  display: block;
  font-size: 28rpx;
  color: #222222;
}

.h3 {
  font-weight: 600;
}

.sub,
.p,
.note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #888888;
}

.note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}

.arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #c7c7cc;
}

.copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #0074fe;
}
