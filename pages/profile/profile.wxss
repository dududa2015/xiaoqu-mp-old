.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 200rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.user-card,
.group {
  background: #ffffff;
  border-radius: 48rpx;
  overflow: hidden;
}

.user-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 36rpx 28rpx 20rpx;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  overflow: hidden;
  background: #f5f5f5;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
}

.user-details {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 56rpx;
  color: #1f2937;
}

.user-id {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #6b7280;
}

.edit-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats {
  display: flex;
  flex-direction: row;
  padding: 0 16rpx 24rpx;
}

.stat {
  flex: 1;
  margin: 0 8rpx;
  padding: 16rpx 4rpx;
  border-radius: 32rpx;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.stat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 4rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon-marker {
  background: rgba(59, 130, 246, 0.12);
}

.stat-icon-pending {
  background: rgba(245, 158, 11, 0.12);
}

.stat-icon-fav {
  background: rgba(249, 115, 22, 0.12);
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.stat-value-marker {
  color: #3b82f6;
}

.stat-value-pending {
  color: #f59e0b;
}

.stat-value-fav {
  color: #f97316;
}

.stat-title {
  margin-top: 6rpx;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 24rpx;
  color: #6b7280;
}

.group {
  margin-top: 24rpx;
}

.cell {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
}

.cell-line {
  position: absolute;
  left: 88rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(34, 34, 34, 0.08);
}

.cell-last .cell-line {
  display: none;
}

.cell-glyph {
  margin-right: 16rpx;
}

.cell-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #222222;
}

.cell-title-ios {
  font-weight: 600;
  color: #007aff;
}

.cell-title-android {
  font-weight: 600;
  color: #e85827;
}

.cell-title-harmony {
  font-weight: 600;
  color: #cf0a2c;
}

.cell-arrow {
  margin-left: 12rpx;
  font-size: 40rpx;
  line-height: 40rpx;
  color: rgba(0, 0, 0, 0.28);
}
